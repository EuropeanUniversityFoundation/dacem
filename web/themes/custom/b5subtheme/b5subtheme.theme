/**
 * Builds the declared curriculum structure for a programme node.
 */
function b5subtheme_programme_curriculum_structure(?NodeInterface $programme): array
{
  $terms_per_year = 2;
  $total_terms = 8;

  if ($programme instanceof NodeInterface) {
    if ($programme->hasField('field_number_of_terms') && !$programme->get('field_number_of_terms')->isEmpty()) {
      $terms_per_year = (int) $programme->get('field_number_of_terms')->value;
    }

    if ($programme->hasField('field_length_of_programme') && !$programme->get('field_length_of_programme')->isEmpty()) {
      $total_terms = (int) $programme->get('field_length_of_programme')->value;
    }
  }

  $terms_per_year = max(1, $terms_per_year);
  $total_terms = max(1, $total_terms);
  $number_of_years = max(1, (int) ceil($total_terms / $terms_per_year));

  $years = [];
  for ($year = 1; $year <= $number_of_years; $year++) {
    $years[(string) $year] = [
      'id' => (string) $year,
      'label' => t('Year @number', ['@number' => $year]),
    ];
  }

  $terms = [];
  $term_short_labels = [];
  for ($term = 1; $term <= $terms_per_year; $term++) {
    $terms[$term] = [
      'id' => $term,
      'label' => t('Term @number', ['@number' => $term]),
    ];
    $term_short_labels[(string) $term] = (string) $term;
  }

  return [
    'terms_per_year' => $terms_per_year,
    'total_terms' => $total_terms,
    'number_of_years' => $number_of_years,
    'years' => $years,
    'terms' => $terms,
    'term_short_labels' => $term_short_labels,
  ];
}

/**
 * Builds sorted IEC groupings for programme information.
 */
function b5subtheme_build_programme_iec_groups(array $view_results, string $langcode, array $curriculum): array
{
  $years = array_map('strval', array_keys($curriculum['years'] ?? []));
  $terms = array_map('strval', array_keys($curriculum['terms'] ?? []));

  $grouped = [
    'by_year' => array_fill_keys($years, []),
    'by_term' => array_fill_keys($terms, []),
  ];

  foreach ($view_results as $row) {
    $iec = $row->_relationship_entities['reverse__node__field_iec_programme'] ?? NULL;
    if (!$iec instanceof NodeInterface) {
      continue;
    }

    $translated_iec = $iec->hasTranslation($langcode) ? $iec->getTranslation($langcode) : $iec;
    $iec_years = [];
    foreach ($translated_iec->get('field_iec_year') ?? [] as $item) {
      $value = (string) ($item->value ?? '');
      if ($value !== '') {
        $iec_years[] = $value;
      }
    }
    $iec_years = array_values(array_unique($iec_years));

    $iec_terms = [];
    foreach ($translated_iec->get('field_iec_term') ?? [] as $item) {
      $value = (string) ($item->value ?? '');
      if ($value !== '') {
        $iec_terms[] = $value;
      }
    }
    $iec_terms = array_values(array_unique($iec_terms));

    $display_year = '0';
    foreach ($iec_years as $year) {
      if ($year !== '0') {
        $display_year = $year;
        break;
      }
    }

    $display_term = '0';
    foreach ($iec_terms as $term) {
      if ($term !== '0') {
        $display_term = $term;
        break;
      }
    }

    $item = [
      'code' => (string) ($translated_iec->get('field_iec_code')->value ?? ''),
      'title' => (string) $translated_iec->label(),
      'url' => isset($row->custom_url) ? '/' . ltrim((string) $row->custom_url, '/') : '',
      'year' => $display_year,
      'term' => $display_term,
      'credits' => (string) ($translated_iec->get('field_iec_credits')->value ?? '0'),
      'type' => (string) ($translated_iec->get('field_iec_type')->value ?? ''),
      'mobility' => (string) ($translated_iec->get('field_iec_avaliable_for_mobility')->value ?? '0') === '1',
    ];

    $target_years = in_array('0', $iec_years, TRUE) ? $years : array_values(array_intersect($years, $iec_years));
    $target_terms = in_array('0', $iec_terms, TRUE) ? $terms : array_values(array_intersect($terms, $iec_terms));

    foreach ($target_years as $year) {
      $grouped['by_year'][$year][] = $item;
    }
    foreach ($target_terms as $term) {
      $grouped['by_term'][$term][] = $item;
    }
  }

  foreach ($grouped['by_year'] as &$items) {
    usort($items, static function (array $a, array $b): int {
      $termCompare = (int) ($a['term'] ?? 0) <=> (int) ($b['term'] ?? 0);
      return $termCompare !== 0 ? $termCompare : strnatcasecmp($a['title'] ?? '', $b['title'] ?? '');
    });
  }
  unset($items);

  foreach ($grouped['by_term'] as &$items) {
    usort($items, static function (array $a, array $b): int {
      $yearCompare = (int) ($a['year'] ?? 0) <=> (int) ($b['year'] ?? 0);
      return $yearCompare !== 0 ? $yearCompare : strnatcasecmp($a['title'] ?? '', $b['title'] ?? '');
    });
  }
  unset($items);

  return $grouped;
}








/**
 * Implements hook_preprocess_HOOK() for page templates.
 */
function b5subtheme_preprocess_page(&$variables)
{



  // Your custom preprocess code for pages.
  $variables['#attached']['library'][] = 'b5subtheme/course_buttons';
  $branding = \Drupal::service('settings')->get('site_branding', []);
  $variables['site_primary_color'] = $branding['primary_color'] ?? '#ff4949';

  $path = \Drupal::theme()->getActiveTheme()->getPath() . '/translations/translations.yml';


  if (file_exists($path)) {
    $translations = \Drupal\Component\Serialization\Yaml::decode(file_get_contents($path));
    $variables['translations'] = $translations;
  }

}

