/**
 * Implements hook_preprocess_HOOK() for page templates.
 */
function b5subtheme_preprocess_page(&$variables) {
  
    // Verifica que estamos en la ruta correcta (la ruta de tu vista).
    if (\Drupal::routeMatch()->getRouteName() === 'view.general_information.page_1') {
      // Obtén el argumento de la URL (el ID de la universidad).
      $university_id = \Drupal::routeMatch()->getParameter('arg_0');
      if ($university_id) {
        // Carga el nodo de la universidad.
        $university_node = \Drupal\node\Entity\Node::load($university_id);
        if ($university_node) {
          // Pasa el nodo de la universidad a Twig como una variable.
          $variables['university'] = $university_node;
        }
      }
    }
  
  



  // Your custom preprocess code for pages.
   $variables['#attached']['library'][] = 'b5subtheme/course_buttons';
   $path = \Drupal::theme()->getActiveTheme()->getPath() . '/translations/translations.yml';
   

   // Cargar el contenido del archivo YAML.
  if (file_exists($path)) {
    $translations = \Drupal\Component\Serialization\Yaml::decode(file_get_contents($path));
    
    // Verifica si las traducciones se están cargando correctamente.
    \Drupal::logger('b5subtheme')->notice('Translations loaded: <pre>@translations</pre>', ['@translations' => print_r($translations, TRUE)]);
    
    // Pasar las traducciones al contexto de Twig.
    $variables['translations'] = $translations;
  } else {
    \Drupal::logger('b5subtheme')->error('Translations file not found at path: @path', ['@path' => $path]);
  }
    
}

