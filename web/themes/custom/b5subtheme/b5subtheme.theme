/**
 * Implements hook_preprocess_HOOK() for views_view templates.
 */
function b5subtheme_preprocess_views_view(&$variables)
{

  $language_manager = \Drupal::service('language_manager');
  $variables['language_manager'] = $language_manager;

  $path = \Drupal::theme()->getActiveTheme()->getPath() . '/translations/translations.yml';

  if (file_exists($path)) {
    $translations = \Drupal\Component\Serialization\Yaml::decode(file_get_contents($path));
    $variables['translations'] = $translations;
  }










  if ($variables['view']->id() == 'institution_catalogue') {
    $current_language = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();

    $grouped_carreras = [];



    foreach ($variables['view']->result as $row) {


      if (isset($row->_relationship_entities['reverse__node__field_programme_institution'])) {

        $carrera = $row->_relationship_entities['reverse__node__field_programme_institution'];


        if ($carrera->hasTranslation($current_language)) {
          $carrera_translated = $carrera->getTranslation($current_language);
        } else {
          $carrera_translated = $carrera; // Usa la carrera en su idioma original.
        }

        $institution = $row->_entity;
        $programme_alias = \Drupal::service('path_alias.manager')->getAliasByPath('/node/' . $carrera_translated->id(), $current_language);
        $language_prefix = '/' . \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();
        $url = $language_prefix . '/catalogue/' . trim($programme_alias, '/');

        if ($carrera_translated && $carrera_translated->id()) {
          $area = $carrera_translated->get('field_programme_area')->value ?? 'undefined';
          $grouped_carreras[$area][] = [
            'title' => $carrera_translated->getTitle(),
            'url' => $url,


          ];
        }
      }
    }

    foreach ($grouped_carreras as &$carreras) {
      usort($carreras, function ($a, $b) {
        return strcmp($a['title'], $b['title']);
      });
    }

    $variables['grouped_carreras'] = $grouped_carreras;
  }















  if ($variables['view']->id() === 'programme_information') {
    $programme = NULL;
    if (!empty($variables['view']->result[0]->_entity) && $variables['view']->result[0]->_entity instanceof NodeInterface) {
      $programme = $variables['view']->result[0]->_entity;
    }

    $variables['programme_curriculum'] = b5subtheme_programme_curriculum_structure($programme);
  }

  if ($variables['view']->id() === 'alliances') {
    $branding = \Drupal::service('settings')->get('site_branding', []);
    $variables['site_primary_color'] = $branding['primary_color'] ?? '#ff4949';
  }




  if (in_array($variables['view']->id(), ['main_page', 'alliance_institutions'], TRUE)) {
    $current_language = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();
    $translated_institution = null;
    $variables['main_page_is_athena'] = str_contains(strtolower(\Drupal::request()->getHost()), 'athena');

    $country_repo = \Drupal::service('address.country_repository');
    $full_country_list = $country_repo->getList($current_language);

    foreach ($variables['view']->result as $key => $row) {

      $institution = $row->_entity;


      if ($institution->hasTranslation($current_language)) {

        $translated_institution = $institution->getTranslation($current_language);
        $translated_url = $translated_institution->toUrl('canonical', ['language' => \Drupal::languageManager()->getLanguage($current_language)])->toString();
        if (strpos($translated_url, '/' . $current_language) === 0) {
          $translated_url = substr($translated_url, strlen('/' . $current_language));
        }
        $row->custom_url = $current_language . '/general-information' . $translated_url;
        $variables['view']->result[$key]->_entity = $translated_institution;

      } else {
        $fallback_language = 'en';
        $fallback_institution = $institution->hasTranslation($fallback_language)
          ? $institution->getTranslation($fallback_language)
          : $institution;

        $translated_url = $fallback_institution->toUrl('canonical', ['language' => \Drupal::languageManager()->getLanguage($fallback_language)])->toString();
        $language_prefix = $fallback_language;
        if (strpos($translated_url, '/' . $fallback_language) === 0) {
          $translated_url = substr($translated_url, strlen('/' . $fallback_language));
        }
        $row->custom_url = $language_prefix . '/general-information' . $translated_url;

        $variables['view']->result[$key]->_entity = $fallback_institution;
      }
      $entity = $variables['view']->result[$key]->_entity;
      $code = ($entity->hasField('field_institution_country') && !$entity->get('field_institution_country')->isEmpty())
        ? $entity->get('field_institution_country')->value
        : NULL;

      $variables['view']->result[$key]->_country_code = $code;
      $variables['view']->result[$key]->_country_name = ($code && isset($full_country_list[$code])) ? $full_country_list[$code] : $code;
    }

    if ($variables['view']->id() === 'alliance_institutions') {
      $alliance_id = $variables['view']->args[0] ?? NULL;
      $alliance = $alliance_id && is_numeric($alliance_id) ? Node::load((int) $alliance_id) : NULL;
      if ($alliance instanceof NodeInterface) {
        $alliance = b5subtheme_entity_for_language_with_fallback($alliance, $current_language);
        $variables['alliance'] = $alliance;
        $variables['alliance_title'] = $alliance->label();
        $variables['alliance_email'] = !$alliance->get('field_alliance_email')->isEmpty()
          ? $alliance->get('field_alliance_email')->value
          : NULL;
        $variables['alliance_phone'] = !$alliance->get('field_alliance_phone')->isEmpty()
          ? $alliance->get('field_alliance_phone')->value
          : NULL;
        $variables['alliance_webpage_url'] = !$alliance->get('field_alliance_webpage')->isEmpty()
          ? $alliance->get('field_alliance_webpage')->first()->getUrl()->toString()
          : NULL;
        $variables['alliance_webpage_title'] = !$alliance->get('field_alliance_webpage')->isEmpty()
          ? ($alliance->get('field_alliance_webpage')->title ?: $variables['alliance_webpage_url'])
          : NULL;
      }
    }

    $branding = \Drupal::service('settings')->get('site_branding', []);

    $variables['main_banner_image'] = $branding['main_banner_image'] ?? '/themes/custom/b5subtheme/images/dacem-008.jpg';
    $variables['main_page_primary_color'] = $branding['primary_color'] ?? '#ff4949';
    $variables['main_page_search_programme_url'] = Url::fromRoute('view.search_programme.page_1', [], [
      'language' => \Drupal::languageManager()->getLanguage($current_language),
    ])->toString();




  }



  if ($variables['view']->id() == 'institution_new_catalogue') {

  $institution = NULL;
  $institution_id = $variables['view']->args[0] ?? NULL;
  $current_language = \Drupal::languageManager()
    ->getCurrentLanguage(\Drupal\Core\Language\LanguageInterface::TYPE_CONTENT)
    ->getId();

  if ($institution_id && is_numeric($institution_id)) {
    $institution = Node::load((int) $institution_id);
  }
  elseif ($institution_id) {
    $alias_manager = \Drupal::service('path_alias.manager');
    foreach ([$current_language, 'en'] as $alias_language) {
      $internal_path = $alias_manager->getPathByAlias('/' . trim($institution_id, '/'), $alias_language);
      if (preg_match('/^\/node\/(\d+)$/', $internal_path, $matches)) {
        $institution = Node::load((int) $matches[1]);
        break;
      }
    }
  }

  if ($institution) {
    $institution_for_colors = $institution;
    $catalogue_programme_ids = function_exists('custom_views_filters_get_catalogue_programme_ids')
      ? custom_views_filters_get_catalogue_programme_ids((int) $institution_for_colors->id())
      : ['own' => [], 'joint' => [], 'all' => []];
    $joint_programme_ids = array_fill_keys($catalogue_programme_ids['joint'] ?? [], TRUE);
    $joint_linked_programme_ids = \Drupal::service('joint_programmes.manager')
      ->getJointProgrammeLinkedProgrammeIds($catalogue_programme_ids['all'] ?? []);

    if ($institution->hasTranslation($current_language)) {
      $institution = $institution->getTranslation($current_language);
    }

    $variables['catalogue_institution'] = $institution;
    $variables['catalogue_university_primary_color'] =
      ($institution_for_colors->hasField('field_primary_color') && !$institution_for_colors->get('field_primary_color')->isEmpty() && isset($institution_for_colors->get('field_primary_color')->first()->color))
        ? $institution_for_colors->get('field_primary_color')->first()->color
        : '#19d329ff';

    $variables['catalogue_university_text_color'] =
      ($institution_for_colors->hasField('field_text_color') && !$institution_for_colors->get('field_text_color')->isEmpty() && isset($institution_for_colors->get('field_text_color')->first()->color))
        ? $institution_for_colors->get('field_text_color')->first()->color
        : '#000000';

    $variables['catalogue_university_emphasis_text_color'] =
      ($institution_for_colors->hasField('field_emphasis_text_color') && !$institution_for_colors->get('field_emphasis_text_color')->isEmpty() && isset($institution_for_colors->get('field_emphasis_text_color')->first()->color))
        ? $institution_for_colors->get('field_emphasis_text_color')->first()->color
        : '#000000';

    $variables['catalogue_shac_code'] =
      !$institution->get('field_shac_code')->isEmpty()
        ? $institution->get('field_shac_code')->value
        : '';

    $route_language = \Drupal::languageManager()->getLanguage($current_language);
    $variables['catalogue_programmes_search_url'] = Url::fromRoute('view.institution_new_catalogue.page_1', ['arg_0' => $institution_id], [
      'language' => $route_language,
    ])->toString();
    $variables['catalogue_programmes_index_url'] = Url::fromRoute('view.institution_new_catalogue.page_3', ['arg_0' => $institution_id], [
      'language' => $route_language,
    ])->toString();
    $variables['catalogue_courses_url'] = Url::fromRoute('view.institution_new_catalogue.page_2', ['arg_0' => $institution_id], [
      'language' => $route_language,
    ])->toString();

    if ($variables['view']->current_display === 'page_3') {
      $data = \Drupal::service('joint_programmes.manager')
        ->buildInstitutionCatalogueIndexVariables(
          $variables['view']->result,
          $joint_programme_ids,
          $joint_linked_programme_ids,
          $current_language
        );

      $variables['area_meta'] = $data['area_meta'];
      $variables['programmes_by_area'] = $data['programmes_by_area'];
    }
  }
  else {

    $variables['catalogue_institution'] = NULL;
    $variables['catalogue_university_primary_color'] = '#F44743';
    $variables['catalogue_university_text_color'] = '#000000';
    $variables['catalogue_university_emphasis_text_color'] = '#000000';
    $variables['catalogue_shac_code'] = '';
    $variables['catalogue_programmes_search_url'] = NULL;
    $variables['catalogue_programmes_index_url'] = NULL;
    $variables['catalogue_courses_url'] = NULL;
  }


  }



  if ($variables['view']->id() === 'programme_information') {
    $current_language = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();


    foreach ($variables['view']->result as &$row) {


      if (!empty($row->_relationship_entities['reverse__node__field_iec_programme'])) {

        $iec = $row->_relationship_entities['reverse__node__field_iec_programme'];

        if ($iec instanceof Node) {




          if ($iec->hasTranslation($current_language)) {
            $translated_iec = $iec->getTranslation($current_language);
            $translated_url = $translated_iec->toUrl('canonical', ['language' => \Drupal::languageManager()->getLanguage($current_language)])->toString();
            if (strpos($translated_url, '/' . $current_language) === 0) {
              $translated_url = substr($translated_url, strlen('/' . $current_language));
            }
            $row->custom_url = $current_language . '/catalogue' . $translated_url;
          } else {
            $original_language = $iec->language()->getId();
            $translated_url = $iec->toUrl('canonical', ['language' => \Drupal::languageManager()->getLanguage($original_language)])->toString();
            $language_prefix = \Drupal::languageManager()->getCurrentLanguage()->getId();
            if (strpos($translated_url, '/' . $original_language) === 0) {
              $translated_url = substr($translated_url, strlen('/' . $original_language));
            }
            $row->custom_url = $language_prefix . '/catalogue' . $translated_url;


        }
      }
    }

    $variables['programme_iec_groups'] = b5subtheme_build_programme_iec_groups(
      $variables['view']->result ?? [],
      $current_language,
      $variables['programme_curriculum'] ?? []
    );
  }









  }







  if (\Drupal::routeMatch()->getRouteName() === 'view.general_information.page_1') {
    $current_language = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();
    $arg_0 = \Drupal::routeMatch()->getParameter('arg_0');

    if ($arg_0 && is_numeric($arg_0)) {

      $node = \Drupal\node\Entity\Node::load($arg_0);
    } else {

      $node = getEntityFromAlias($arg_0, $current_language);
    }


    if ($node && $node->hasTranslation($current_language)) {

      $translated_node = $node->getTranslation($current_language);
      $variables['university'] = $translated_node;

      if (
        $translated_node->hasField('field_institution_alliance') &&
        !$translated_node->get('field_institution_alliance')->isEmpty()
      ) {
        $alliance = $translated_node->get('field_institution_alliance')->entity;
        if ($alliance instanceof NodeInterface) {
          $variables['general_information_alliance'] =
            b5subtheme_entity_for_language_with_fallback($alliance, $current_language);
        }
      }

      $campuses = \Drupal::entityTypeManager()
        ->getStorage('node')
        ->loadByProperties([
          'type' => 'campus',
          'field_campus_institution' => $translated_node->id(),
        ]);

      $translated_campuses = [];
      foreach ($campuses as $campus) {
        if ($campus->hasTranslation($current_language)) {
          $translated_campuses[] = $campus->getTranslation($current_language);
        } else {
          $translated_campuses[] = $campus;
        }
      }
    }

    if (
      !isset($variables['general_information_alliance']) &&
      $node instanceof NodeInterface &&
      $node->hasField('field_institution_alliance') &&
      !$node->get('field_institution_alliance')->isEmpty()
    ) {
      $alliance = $node->get('field_institution_alliance')->entity;
      if ($alliance instanceof NodeInterface) {
        $variables['general_information_alliance'] =
          b5subtheme_entity_for_language_with_fallback($alliance, $current_language);
      }
    }




    $full_country_list = \Drupal::service('address.country_repository')->getList($current_language);
    $country_code = $node->get('field_institution_country')->value;
    $variables['country_name'] = t($full_country_list[$country_code], [], ['langcode' => $current_language]);







    $variables['campuses'] = !empty($translated_campuses) ? array_values($translated_campuses) : NULL;



















    /**
     * Inline helper that maps keys to ELM vocabulary labels.
     */
    $elm_labels = function (EntityInterface $entity, string $field_name, string $lang): array {
      if (!$entity->hasField($field_name) || $entity->get($field_name)->isEmpty()) {
        return [];
      }

      $vocabulary_id = $entity->getFieldDefinition($field_name)->getSetting('vocabulary');

      /** @var \Drupal\elm_vocabulary_field\ControlledVocabularyProviderInterface $provider */
      $provider = \Drupal::service('elm_vocabulary_field.provider');
      $vocabulary = $provider->getVocabulary($vocabulary_id);

      $listLang = $vocabulary->getLabeledList($lang);
      $listEn = $vocabulary->getLabeledList('en');

      $labels = [];
      foreach ($entity->get($field_name) as $item) {
        $key = $item->value;
        $labels[] = $listLang[$key] ?? $listEn[$key] ?? $key;
      }
      return $labels;
    };

    if (!empty($translated_node) && $translated_node->hasField('field_example_vocabularies')) {
      $variables['institution_vocab_labels'] =
        $elm_labels($translated_node, 'field_example_vocabularies', $current_language);

      $variables['institution_vocab_labels_str'] =
        implode(', ', $variables['institution_vocab_labels']);
    }

    if (!empty($variables['view']->result)) {
      foreach ($variables['view']->result as $idx => $row) {
        $entity = $row->_entity ?? NULL;
        if ($entity instanceof EntityInterface && $entity->hasField('field_example_vocabularies')) {
          $labels = $elm_labels($entity, 'field_example_vocabularies', $current_language);
          $variables['view']->result[$idx]->_elm_vocab_labels = $labels;
          $variables['view']->result[$idx]->_elm_vocab_labels_str = implode(', ', $labels);
        }
      }
    }



      $sections = [];


      if (!$node->get('field_information')->isEmpty()) {
        $sections[] = [
          'id' => 'description',
          'label' => t('Description'),
        ];
      }


      /*
      if (!empty($variables['has_academic_authorities'])) {
        $sections[] = [
          'id' => 'academic-authorities',
          'label' => t('Authorities'),
        ];
      }
      */

      if (
        !$node->get('field_mobility_incoming_students')->isEmpty()
        || !$node->get('field_mobility_outgoing_students')->isEmpty()
      ) {
        $sections[] = [
          'id' => 'mobility',
          'label' => t('Mobility'),
        ];
      }



      if (!$node->get('field_admission_description')->isEmpty()) {
        $sections[] = [
          'id' => 'admission',
          'label' => t('Admission'),
        ];
      }


     if (
        !$node->get('field_ects_credit_allocation_pol')->isEmpty() ||
        !$node->get('field_arrangements_guidance')->isEmpty() ||
        !$node->get('field_arrangements_recognition')->isEmpty()
      ) {
        $sections[] = [
          'id' => 'ects-policies',
          'label' => t('Policies'),
        ];
      }





      /*
      if (!empty($variables['has_campuses'])) {
        $sections[] = [
          'id' => 'campuses',
          'label' => t('Campuses'),
        ];
      }*/

      /*
      if (!empty($variables['has_organizational_units'])) {
        $sections[] = [
          'id' => 'organizational-units',
          'label' => t('Org. Units'),
        ];
      }*/

      $variables['menu_sections'] = $sections;




      $changed = $node->getChangedTime();

      $variables['last_updated'] = \Drupal::service('date.formatter')
      ->format($changed, 'custom', 'd/m/Y');



















  }







  if ($variables['view']->id() == 'resources_and_services') {
    $current_language = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();
    $variables['current_language'] = $current_language;


    $arg_0 = \Drupal::routeMatch()->getParameter('arg_0');

    if ($arg_0 && is_numeric($arg_0)) {

      $node = \Drupal\node\Entity\Node::load($arg_0);
    } else {

      $node = getEntityFromAlias($arg_0, $current_language);
    }


    if ($node && $node->hasTranslation($current_language)) {
      $translated_node = $node->getTranslation($current_language);
      $path_alias_manager = \Drupal::service('path_alias.manager');


      $internal_path = '/node/' . $translated_node->id();
      $alias = $path_alias_manager->getAliasByPath($internal_path, $current_language);

      $lang_prefix = $current_language;
      $translated_node->custom_url = '/' . $lang_prefix . '/resources-and-services' . $alias;


      $variables['university'] = $translated_node;

      $campuses = \Drupal::entityTypeManager()
        ->getStorage('node')
        ->loadByProperties([
          'type' => 'campus',
          'field_campus_institution' => $translated_node->id(),
        ]);

      $translated_campuses = [];
      foreach ($campuses as $campus) {
        $translated = $campus->hasTranslation($current_language) ? $campus->getTranslation($current_language) : $campus;

        $internal_path = '/node/' . $translated->id();
        if ($translated->hasTranslation($current_language)) {
          $alias = $path_alias_manager->getAliasByPath($internal_path, $current_language);
        } else {
          $alias = $path_alias_manager->getAliasByPath($internal_path, 'en');
        }

        $rs_campus_nodes = \Drupal::entityTypeManager()
          ->getStorage('node')
          ->loadByProperties([
            'type' => 'resources_and_services',
            'field_rs_campus' => $campus->id(),
          ]);

        $rs_campus = reset($rs_campus_nodes);

        $lang_prefix = '';
        if ($rs_campus && $rs_campus->hasTranslation($current_language)) {
          $lang_prefix = $current_language;
        } else {
          $lang_prefix = 'en';
          $alias = $path_alias_manager->getAliasByPath($internal_path, 'en');
        }

        $translated->custom_url = '/' . $lang_prefix . '/resources-and-services' . $alias;

        $translated_campuses[] = $translated;
      }



      if ($variables['view']->current_display == 'page_2') {





        $query = \Drupal::entityQuery('node')
          ->condition('type', 'resources_and_services')
          ->condition('field_rs_institution', $node->id())
          ->notExists('field_rs_campus')
          ->accessCheck(TRUE)
          ->range(0, 1);

        $nids = $query->execute();

        $institution_rs = NULL;
        if (!empty($nids)) {
          $nid = reset($nids);
          $institution_rs = \Drupal\node\Entity\Node::load($nid);

          if ($current_language && $node->hasTranslation($current_language)) {
            $institution_rs = $institution_rs->getTranslation($current_language);
          }
        }

        $variables['institution_rs'] = $institution_rs;




        $fields = [
          'field_rs_students_affairs_office',
          'field_financial_support_for_stud',
          'field_rs_insurance',
          'field_rs_medical_facilities',
          'field_rs_learning_facilities',
          'field_sport_and_leisure_faciliti',
          'field_rs_special_facilities',
          'field_practical_information_for',
          'field_rs_cost_of_living',

          'field_rs_transportation',
          'field_rs_meals',
          'field_rs_housing',
          'field_rs_students_associations',
          'field_work_placement_possibiliti',
          'field_sport_clubs_programs',
          'field_rs_language_courses',
          'field_cultural_event_city_calend',



          'field_housing_email',
          'field_housing_phone',
          'field_housing_website',
          'field_inclusion_infrast_email',
          'field_inclusion_infrast_phone',
          'field_inclusion_infrast_website',
          'field_inclusion_email',
          'field_inclusion_phone',
          'field_inclusion_website',
          'field_rs_institution',
          'field_insurance_email',
          'field_insurance_phone',
          'field_insurance_website',
          'field_rs_special_needs',
          'field_visa',
          'field_visa_email',
          'field_visa_phone',
          'field_visa_website',



        ];

        $current_rs_node = $variables['view']->result[0]->_entity ?? null;

        if ($current_rs_node && $current_rs_node->hasField('field_rs_campus') && !$current_rs_node->get('field_rs_campus')->isEmpty()) {
          $campus = $current_rs_node->get('field_rs_campus')->entity;
          if ($campus && $campus->hasTranslation($current_language)) {
            $campus = $campus->getTranslation($current_language);
          }
          $variables['rs_campus_title'] = $campus->label();

        }



        $rs_fallback_data = [];



        $renderer = \Drupal::service('renderer');

        foreach ($fields as $field) {
          if ($current_rs_node && $current_rs_node->hasField($field) && !$current_rs_node->get($field)->isEmpty()) {
            $field_view = $current_rs_node->get($field)->view(['label' => 'hidden']);
            $rendered_output = $renderer->render($field_view)->__toString();
            $rs_fallback_data[$field] = [
              'rendered' => $rendered_output,
              'source' => 'campus',
            ];
          } elseif ($institution_rs && $institution_rs->hasField($field) && !$institution_rs->get($field)->isEmpty()) {
            $field_view = $institution_rs->get($field)->view(['label' => 'hidden']);
            $rendered_output = $renderer->render($field_view)->__toString();
            $rs_fallback_data[$field] = [
              'rendered' => $rendered_output,
              'source' => 'institution',
            ];
          } else {
            $rs_fallback_data[$field] = [
              'rendered' => NULL,
              'source' => 'none',
            ];
          }
        }




        $variables['rs_fallback_data'] = $rs_fallback_data;
        $variables['rs_mode'] = 'campus';






      } else {
        $variables['rs_mode'] = 'institution';
      }




    }

    $variables['campuses'] = !empty($translated_campuses) ? array_values($translated_campuses) : NULL;

  }


  if ($variables['view']->id() === 'search_programme' || $variables['view']->id() === 'searcher') {
    $branding = \Drupal::service('settings')->get('site_branding', []);
    $variables['search_site_primary_color'] = $branding['primary_color'] ?? '#ff4949';

    $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();

    $variables['country_list'] = \Drupal::service('address.country_repository')->getList($langcode);

    $variables['programme_area_labels'] = b5subtheme_programme_area_labels($langcode);

    $variables['selected_home_programme'] = NULL;
    $variables['clear_home_programme_url'] = NULL;
    \Drupal\Core\Cache\CacheableMetadata::createFromRenderArray($variables)
      ->addCacheContexts(['url.query_args:home_programme'])
      ->applyTo($variables);

    $home_programme_id = \Drupal::request()->query->get('home_programme');
    if ($home_programme_id && is_numeric($home_programme_id)) {
      $home_programme = Node::load((int) $home_programme_id);

      if ($home_programme instanceof NodeInterface && $home_programme->bundle() === 'programme') {
        $home_programme = b5subtheme_entity_for_language_with_fallback($home_programme, $langcode);
        $home_programme_label = $home_programme->label();
        $home_institution_label = '';

        if ($home_programme->hasField('field_programme_institution') && !$home_programme->get('field_programme_institution')->isEmpty()) {
          $home_institution = $home_programme->get('field_programme_institution')->entity;
          $home_institution = b5subtheme_entity_for_language_with_fallback($home_institution, $langcode);
          $home_institution_label = $home_institution ? $home_institution->label() : '';
        }

        $variables['selected_home_programme'] = [
          'label' => $home_programme_label,
          'institution' => $home_institution_label,
        ];

        $query_params = \Drupal::request()->query->all();
        unset($query_params['home_programme'], $query_params['page']);

        $variables['clear_home_programme_url'] = Url::fromRoute('view.search_programme.page_1', [], [
          'query' => $query_params,
          'language' => \Drupal::languageManager()->getLanguage($langcode),
        ])->toString();
      }
    }









































  }



  if ($variables['view']->id() === 'search_iec') {
    $branding = \Drupal::service('settings')->get('site_branding', []);
    $variables['search_site_primary_color'] = $branding['primary_color'] ?? '#ff4949';

    $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();

    $variables['country_list'] = \Drupal::service('address.country_repository')->getList($langcode);




    $current_language = \Drupal::languageManager()
    ->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)
    ->getId();

  foreach ($variables['view']->result as &$row) {
    /** @var \Drupal\node\NodeInterface|null $iec */
    $iec = $row->_entity ?? NULL;

    if (!$iec instanceof NodeInterface || !$iec->id()) {

      continue;
    }

    $lang_for_url = b5subtheme_entity_language_for_url($iec, $current_language);
    $language = \Drupal::languageManager()->getLanguage($lang_for_url);

    $iec_for_url = b5subtheme_entity_for_language_with_fallback($iec, $current_language);
    $row->_entity = $iec_for_url;
    $row->display_instruction_languages = b5subtheme_referenced_entity_labels_for_language($iec_for_url, 'field_iec_language_of_instructio', $lang_for_url);

    if ($iec_for_url->hasField('field_iec_programme') && !$iec_for_url->get('field_iec_programme')->isEmpty()) {
      $programme = $iec_for_url->get('field_iec_programme')->entity;
      $programme = b5subtheme_entity_for_language_with_fallback($programme, $current_language);
      $row->display_programme = $programme;

      if ($programme && $programme->hasField('field_programme_institution') && !$programme->get('field_programme_institution')->isEmpty()) {
        $institution = $programme->get('field_programme_institution')->entity;
        $row->display_institution = b5subtheme_entity_for_language_with_fallback($institution, $current_language);
      }
    }

      $url = $iec_for_url
        ->toUrl('canonical', ['language' => $language])
        ->toString();

      if (strpos($url, '/' . $lang_for_url) === 0) {
        $url = substr($url, strlen('/' . $lang_for_url));
      }

      $row->custom_url = '/' . $lang_for_url . '/catalogue' . $url;
  }




  }











}





/* Implements hook_theme_registry_alter().
 */
function b5subtheme_theme_registry_alter(&$theme_registry)
{
  \Drupal::service('twig.loader.filesystem')->addPath(
    DRUPAL_ROOT . '/modules/custom/dacem_footer/templates',
    'dacem_footer'
  );
}



use Drupal\Core\Form\FormStateInterface;

function b5subtheme_form_views_exposed_form_alter(array &$form, FormStateInterface $form_state, $form_id)
{
  $view = $form_state->getBuildInfo()['callback_object']->view ?? NULL;
  if ($view && $view->id() === 'alliances') {
    if (isset($form['title'])) {
      $form['title']['#attributes']['placeholder'] = t('Type here to search');
      $form['title']['#title_display'] = 'invisible';
    }

    if (isset($form['actions']['submit'])) {
      $form['actions']['submit']['#value'] = t('Search');
    }
  }

  if ($view && $view->id() === 'main_page' && $view->current_display === 'page_2') {
    if (isset($form['title'])) {
      $form['title']['#attributes']['placeholder'] = t('Type here to search');
      $form['title']['#title_display'] = 'invisible';
    }
  }

  if ($view && $view->id() === 'search_programme') {
    $form['#attributes']['data-disable-refocus'] = 'true';

    $request = \Drupal::request();
    $home_programme_id = $request->query->get('home_programme');
    $reset_requested = $request->query->get('op') === 'Reset';

    if (!$reset_requested && $home_programme_id && is_numeric($home_programme_id)) {
      $form['home_programme'] = [
        '#type' => 'hidden',
        '#value' => (int) $home_programme_id,
        '#attributes' => [
          'data-home-programme-filter' => '1',
        ],
      ];
    }

    if (isset($form['actions']['reset'])) {
      if ($home_programme_id && is_numeric($home_programme_id)) {
        $form['actions']['reset']['#access'] = TRUE;
      }

      $form['actions']['reset']['#attributes']['data-clear-home-programme'] = '1';
      $form['actions']['reset']['#attributes']['data-reset-url'] = Url::fromRoute('view.search_programme.page_1', [], [
        'language' => \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT),
      ])->toString();
    }

    array_walk_recursive($form, function (&$value, $key) {
      if ($key === '#attributes') {
        $value['data-disable-refocus'] = 'true';
      }
    });
    if (isset($form['actions']['submit'])) {
      $form['actions']['submit']['#attributes']['data-disable-refocus'] = 'true';
    }
  }
}








use Drupal\views\ViewExecutable;

/**
 * Implements hook_views_pre_render().
 */
function b5subtheme_views_pre_render(ViewExecutable $view) {
  if ($view->id() !== 'institution_new_catalogue') {
    return;
  }

  if ($view->current_display === 'page_2') {
    $current_language = \Drupal::languageManager()
      ->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)
      ->getId();

    foreach ($view->result as &$row) {
      /** @var \Drupal\node\NodeInterface|null $iec */
      $iec = $row->_entity ?? NULL;

      if (!$iec instanceof NodeInterface || !$iec->id()) {
        continue;
      }

      $lang_for_url = b5subtheme_entity_language_for_url($iec, $current_language);
      $language = \Drupal::languageManager()->getLanguage($lang_for_url);

      $iec_for_url = b5subtheme_entity_for_language_with_fallback($iec, $current_language);
      $row->_entity = $iec_for_url;
      $row->display_instruction_languages = b5subtheme_referenced_entity_labels_for_language($iec_for_url, 'field_iec_language_of_instructio', $lang_for_url);

      if ($iec_for_url->hasField('field_iec_programme') && !$iec_for_url->get('field_iec_programme')->isEmpty()) {
        $programme = $iec_for_url->get('field_iec_programme')->entity;
        $programme = b5subtheme_entity_for_language_with_fallback($programme, $current_language);
        $row->display_programme = $programme;
      }

      $url = $iec_for_url
        ->toUrl('canonical', ['language' => $language])
        ->toString();

      if (strpos($url, '/' . $lang_for_url) === 0) {
        $url = substr($url, strlen('/' . $lang_for_url));
      }

      $row->custom_url = '/' . $lang_for_url . '/catalogue' . $url;

    }
  }
}

/**
 * Implements hook_preprocess_views_view_fields().
 */
