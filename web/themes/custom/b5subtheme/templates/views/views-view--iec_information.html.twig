{% set current_language = view.result[0].node_field_data_langcode %}


{# Acceder a la asignatura actual #}
{% set iec = view.result[0]._entity %}
{% if iec.hasTranslation(current_language) %}
	{% set translated_iec = iec.getTranslation(current_language) %}
{% else %}
	{% set translated_iec = iec %}
{% endif %}

{# Acceder a la carrera a la que pertenece la asignatura #}
{% set programme = translated_iec.field_iec_programme.entity %}

{% if programme %}
	{% if programme.hasTranslation(current_language) %}
		{% set translated_programme = programme.getTranslation(current_language) %}
	{% else %}
		{% set translated_programme = programme %}
	{% endif %}
{% endif %}

{# Acceder a la universidad a la que pertenece la carrera #}
{% set institution = programme.field_programme_institution.entity %}

{% if institution %}
	{% if institution.hasTranslation(current_language) %}
		{% set translated_institution = institution.getTranslation(current_language) %}
	{% else %}
		{% set translated_institution = institution %}
	{% endif %}
{% endif %}

{# Obtener colores de la universidad #}
{% set university_primary_color = institution.field_primary_color[0].color %}
{% set university_text_color = institution.field_text_color[0].color %}
{% set university_emphasis_text_color = institution.field_emphasis_text_color[0].color %}

<style>:root
{
	--university_primary_color: {{university_primary_color}}
	;
	--university_text_color: {{university_text_color}}
	;
	--university_emphasis_text_color: {{university_emphasis_text_color}}
	;
}</style>{# Cuatrimestres del curso #}{% set cuatrimestres_curso = {
  '1o': '1º',
  '2o': '2º',
  '3o': '3º',
  '4o': '4º',
} %}<div class="programme-page">

{% if translated_programme and translated_programme.id %}
	{% set original_url = path('entity.node.canonical', {'node': translated_programme.id}) %}
	{% set language_prefix = '/' ~ current_language ~ '/' %}
	{% set modified_url = original_url|replace({(language_prefix): language_prefix ~ 'catalogue/'}) %}
	<a href="{{ modified_url }}" class="programme-header-link">
		<div class="rs-header ">
	<div class="my-custom-container-2">
	<div class="page-band">
		<h1 class="rs-title">{{ translated_programme.title.value|raw }}</h1>
	</div>
	</div>
	</div>	
	</a>
{% else %}
	<div class="programme-header-link">
		<div class="programme-header">
			<div class="container-fluid">
				<h1 class="rs-title">
					{{ 'Degree information unavailable'|t }}
				</h1>
			</div>
		</div>
	</div>
{% endif %}
<div class="rs-header bg-black">
	<div class="my-custom-container-2">
	<div class="page-band">
		<h1 class="rs-title">{{ translated_iec.label|upper }}</h1>
	</div>
	</div>	
	
	</div></div><div class="section-container">
<div class="my-custom-container-2">
	<div class="row">
		<div class="col-sm-12 col-md-12 col-xl-8 order-2 order-xl-1">
			<div
				class="programme-section" id="general-information" style="text-align: justify;">
				<!--<h3 class="subsection-title">{{ translations[current_language]['Presentation'] }}</h3>-->
				<h3 class="subsection-title mt-0">{{ translations[current_language]['Description'] }}</h3>
				{{ translated_iec.field_iec_description.value|raw }}
			</div>
		

		
	

	
		
			<div class="programme-section" id="main-objective" style="text-align: justify;">
				<h3 class="subsection-title">{{ translations[current_language]['Instructors'] }}</h3>
				{{ translated_iec.field_iec_instructors.value|raw }}
			</div>
			<div
				class="programme-section" id="competencies" style="text-align: justify;">
				<!--<h3 class="subsection-title">{{ translations[current_language]['SUBJECT CONTENT'] }}</h3>-->
				<h3 class="subsection-title">{{ translations[current_language]['Iec Contents'] }}</h3>
				{{ translated_iec.field_iec_contents.value|raw }}
			</div>
			<div class="programme-section" id="competencies" style="text-align: justify;">
				<h3 class="subsection-title">{{ translations[current_language]['Learning Outcomes'] }}</h3>
				{{ translated_iec.field_iec_learning_outcomes.value|raw }}
			</div>
			<div class="programme-section" id="competencies" style="text-align: justify;">
				<h3 class="subsection-title">{{ translations[current_language]['Recommended Readings and Tools'] }}</h3>
				{{ translated_iec.field_iec_recommendations.value|raw }}
			</div>
			<div class="programme-section" id="competencies" style="text-align: justify;">
				<h3 class="subsection-title">{{ translations[current_language]['Planned Activities'] }}</h3>
				{{ translated_iec.field_iec_planned_activities.value|raw }}
			</div>
			<div class="programme-section" id="competencies" style="text-align: justify;">
				<h3 class="subsection-title">{{ translations[current_language]['Evaluation Methods and Criteria'] }}</h3>
				{{ translated_iec.field_iec_evaluation.value|raw }}
			</div>
			<div class="programme-section" id="competencies" style="text-align: justify;">
				<h3 class="subsection-title">{{ translations[current_language]['Mobility'] }}</h3>
				{{ translated_iec.field_iec_mobility.value|raw }}
			</div>

			</div>
		
	
<div class="col-sm-12 col-md-12 col-xl-4 degree-sidebar-wrapper order-1 order-xl-2">
  <div class="degree-sidebar bg-light">
    <div class="row g-3 mx-0">

      <!-- Columna 1: General Data -->
      <div class="col-12 col-md-6 col-xl-12">
        <h3 class="subsection-title m-0 mb-3">
          {{ translations[current_language]['General Data']}}
        </h3>

        <div class="degree-info-item mb-2">
          <strong>{{ translations[current_language]['Academic Course'] }}:</strong>
          23/24
        </div>

        <div class="degree-info-item mb-2">
          <strong>{{ translations[current_language]['Type'] }}:</strong>
          {{ translations[current_language][translated_iec.field_iec_type.value]|capitalize }}
        </div>

        <div class="degree-info-item mb-2">
          <strong>{{ translations[current_language]['Course'] }}:</strong>
          {{ translated_iec.field_iec_year.value }}
        </div>

        <div class="degree-info-item mb-2">
          <strong>{{ translations[current_language]['Period'] }}:</strong>
          {{ translated_iec.field_iec_term.value }}
        </div>

        <div class="degree-info-item mb-2">
          <strong>{{ translations[current_language]['ECTS Credits'] }}:</strong>
          {{ translated_iec.field_iec_credits.value }}
        </div>

        <div class="degree-info-item mb-2">
          <strong>{{ translations[current_language]['Modality'] }}:</strong>
          {{ translations[current_language][translated_iec.field_iec_modality.value] }}
        </div>

        <div class="degree-info-item mb-2">
          <strong>{{ translations[current_language]['Requirements'] }}:</strong>
          {{ translated_iec.field_iec_requirements.value | raw }}
        </div>

        <div class="degree-info-item mb-2">
          <strong>{{ translations[current_language]['Language'] }}:</strong>
          {{ translated_iec.field_iec_language.value }}
        </div>

		<div class="degree-info-item mb-2">
          <strong>{{ translations[current_language]['Avaliable for Mobility Students'] }}:</strong>
          {{ translated_iec.field_iec_avaliable_for_mobility.value | capitalize}}
        </div>



      </div>

      <!-- Columna 2: Coordination -->
      <div class="col-12 col-md-6 col-xl-12">
        <h3 class="mt-4 mt-md-0 mt-xl-4">{{ translations[current_language]['Coordination']}}</h3>

        <div class="degree-info-item mb-1">{{ translated_iec.field_iec_coordinator.value }}</div>

        <div class="degree-info-item mb-1">
          <i class="fa fa-phone"></i> {{ translated_iec.field_iec_phone.value }}
        </div>

        <div class="degree-info-item mb-1">
          <i class="fa fa-envelope"></i> {{ translated_iec.field_iec_email.value }}
        </div>
      </div>

    </div>
  </div>
</div>



</div></div></div>
