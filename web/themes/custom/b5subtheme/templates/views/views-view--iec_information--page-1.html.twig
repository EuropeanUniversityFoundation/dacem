{% set current_language = view.result[0].node_field_data_langcode %}





{% set iec = view.result[0]._entity %}
{% if iec.hasTranslation(current_language) %}
	{% set translated_iec = iec.getTranslation(current_language) %}
{% else %}
	{% set translated_iec = iec %}
{% endif %}

{# Obtain the programme #}
{% set programme = translated_iec.field_iec_programme.entity %}

{% if programme %}
	{% if programme.hasTranslation(current_language) %}
		{% set translated_programme = programme.getTranslation(current_language) %}
	{% else %}
		{% set translated_programme = programme %}
	{% endif %}
{% endif %}

{# Obtain the institution #}
{% set institution = programme.field_programme_institution.entity %}

{% if institution %}
	{% if institution.hasTranslation(current_language) %}
		{% set translated_institution = institution.getTranslation(current_language) %}
	{% else %}
		{% set translated_institution = institution %}
	{% endif %}
{% endif %}

{# Institution colors #}
{% set university_primary_color = institution.field_primary_color[0].color %}
{% set university_text_color = institution.field_text_color[0].color %}
{% set university_emphasis_text_color = institution.field_emphasis_text_color[0].color %}


<style>:root
{
	--university_primary_color: {{university_primary_color}}
	;
	--university_text_color: {{university_text_color}}
	;
	--university_emphasis_text_color: {{university_emphasis_text_color}}
	;
}</style>


<div class="programme-page">

{% if translated_programme and translated_programme.id %}
	{% set original_url = path('entity.node.canonical', {'node': translated_programme.id}) %}
	{% set language_prefix = '/' ~ current_language ~ '/' %}
	{% set modified_url = original_url|replace({(language_prefix): language_prefix ~ 'catalogue/'}) %}
	<a href="{{ modified_url }}" class="programme-header-link">
		<div class="rs-header " >
			<div class="my-custom-container-2">
				<div class="page-band">
					<h1 class="rs-title">{{ translated_programme.title.value|raw }}</h1>
				</div>
			</div>
		</div>
	</a>
{% else %}
	<div class="programme-header-link">
		<div class="programme-header">
			<div class="container-fluid">
				<h1 class="rs-title">
					{{ 'Degree information unavailable'|t }}
				</h1>
			</div>
		</div>
	</div>
{% endif %}
<div class="rs-header bg-black">
	<div class="my-custom-container-2">
		<div class="page-band">
			<h1 class="rs-title">{{ translated_iec.label|upper }}</h1>
		</div>
	</div>

</div></div><div class="section-container">
<div class="my-custom-container-2">

	<div class="row">

{% if attachment_after %}
  <div class="col-sm-12 col-md-12 col-xl-4 degree-sidebar-wrapper order-1 order-xl-2">
    {{ attachment_after }}
  </div>
{% endif %}
  {# MAIN CONTENT #}
  <div class="col-sm-12 col-md-12 col-xl-8 order-2 order-xl-1">

    {% if translated_iec.field_iec_description.value is not empty %}
      <div class="programme-section" id="general-information" style="text-align: justify;">
        <h3 class="subsection-title mt-0">{{ translations[current_language]['Description'] }}</h3>
        {{ translated_iec.field_iec_description.value|raw }}

        {% if translated_iec.field_subject_area is defined and translated_iec.field_subject_area.value is not empty %}
          <div class="mt-4">
            <h4 class="subsection-title">{{ 'Subject area'|t }}</h4>
            {{ translated_iec.field_subject_area.value|raw }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% if translated_iec.field_iec_requirements.value is not empty %}
      <div class="programme-section" style="text-align: justify;">
        <h3 class="subsection-title">{{ translations[current_language]['Requirements'] }}</h3>
        {{ translated_iec.field_iec_requirements.value|raw }}
      </div>
    {% endif %}

    {% if translated_iec.field_iec_instructors.value is not empty %}
      <div class="programme-section" style="text-align: justify;">
        <h3 class="subsection-title">{{ translations[current_language]['Instructors'] }}</h3>
        {{ translated_iec.field_iec_instructors.value|raw }}
      </div>
    {% endif %}

    {% if translated_iec.field_iec_contents.value is not empty %}
      <div class="programme-section" style="text-align: justify;">
        <h3 class="subsection-title">{{ translations[current_language]['Contents'] }}</h3>
        {{ translated_iec.field_iec_contents.value|raw }}
      </div>
    {% endif %}

    {% if translated_iec.field_iec_learning_outcomes.value is not empty %}
      <div class="programme-section" style="text-align: justify;">
        <h3 class="subsection-title">{{ translations[current_language]['Learning Outcomes'] }}</h3>
        {{ translated_iec.field_iec_learning_outcomes.value|raw }}
      </div>
    {% endif %}

    {% if translated_iec.field_iec_recommendations.value is not empty %}
      <div class="programme-section" style="text-align: justify;">
        <h3 class="subsection-title">{{ translations[current_language]['Recommended Readings and Tools'] }}</h3>
        {{ translated_iec.field_iec_recommendations.value|raw }}
      </div>
    {% endif %}

    {% if translated_iec.field_iec_planned_activities.value is not empty %}
      <div class="programme-section" style="text-align: justify;">
        <h3 class="subsection-title">{{ translations[current_language]['Planned Activities'] }}</h3>
        {{ translated_iec.field_iec_planned_activities.value|raw }}
      </div>
    {% endif %}

    {% if translated_iec.field_iec_evaluation.value is not empty %}
      <div class="programme-section" style="text-align: justify;">
        <h3 class="subsection-title">{{ translations[current_language]['Assessment Methods and Criteria'] }}</h3>
        {{ translated_iec.field_iec_evaluation.value|raw }}
      </div>
    {% endif %}

  </div>
</div>

</div></div>{% set has_iec_resource_files = translated_iec.hasField('field_iec_files') and not translated_iec.get('field_iec_files').isEmpty() %}{% set has_iec_resource_links = translated_iec.hasField('field_iec_urls') and not translated_iec.get('field_iec_urls').isEmpty() %}{% if has_iec_resource_files or has_iec_resource_links %}<div class="section-container"><div class="my-custom-container-2"><div class="programme-section"><h2 class="section-title text-center">{{ 'Resources and Files'|t }}</h2><div class="row g-4">{% if has_iec_resource_links %}<div class="col-12 col-lg-6"><h4 class="subsection-title">{{ 'Links'|t }}</h4><ul class="mb-0">{% for item in translated_iec.get('field_iec_urls') %}{% if item.uri %}<li><a href="{{ item.uri }}" target="_blank" rel="noopener noreferrer">{{ item.title ?: item.uri }}</a></li>{% endif %}{% endfor %}</ul></div>{% endif %}{% if has_iec_resource_files %}<div class="col-12 col-lg-6"><h4 class="subsection-title">{{ 'Files'|t }}</h4><ul class="mb-0">{% for item in translated_iec.get('field_iec_files') %}{% set file = item.entity ?? null %}{% if file %}<li><a href="{{ file_url(file.uri.value) }}" target="_blank" rel="noopener noreferrer">{{ item.description ?: file.filename.value }}</a></li>{% endif %}{% endfor %}</ul></div>{% endif %}</div></div></div></div>{% endif %}
