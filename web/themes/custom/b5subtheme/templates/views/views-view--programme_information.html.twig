<div class="section-container">
	<div class="my-custom-container-2">


		<div class="scrollspy-example" data-bs-spy="scroll" data-bs-target="#programme-navbar" data-bs-root-margin="0px 0px -60%" tabindex="0">

			<div class="row">
				<div class="col-sm-12 col-md-12 col-xl-8 order-2 order-xl-1">
					{% if translated_entity.field_programme_description.value is not empty %}
						<div class="programme-section" id="presentation" style="text-align: justify; scroll-margin-top: 150px;">
							<h3 class="subsection-title m-0">{{ translations[current_language]['Presentation'] }}</h3>
							{{ translated_entity.field_programme_description.value|raw }}
						</div>
					{% endif %}

					{% if translated_entity.field_main_objective.value is not empty %}
						<div class="programme-section" id="main-objective" style="text-align: justify; scroll-margin-top: 150px;">
							<h3 class="subsection-title">{{ translations[current_language]['Main Objective'] }}</h3>
							{{ translated_entity.field_main_objective.value|raw }}
						</div>
					{% endif %}
					{% if translated_entity.field_competencies.value is not empty %}
						<div class="programme-section" id="competencies" style="text-align: justify; scroll-margin-top: 150px;">
							<h3 class="subsection-title">{{ translations[current_language]['Competencies'] }}</h3>
							{{ translated_entity.field_competencies.value|raw }}
						</div>
					{% endif %}
					{% if translated_entity.field_programme_learn_outcomes.value is not empty %}
						<div class="programme-section" id="learning-outcomes" style="text-align: justify; scroll-margin-top: 150px;">
							<h3 class="subsection-title">{{ 'Learning Outcomes'|t }}</h3>
							{{ translated_entity.field_programme_learn_outcomes.value|raw }}
						</div>
					{% endif %}

					{% if translated_entity.field_programme_qualification.value is not empty %}
						<div class="programme-section" id="qualification" style="text-align: justify; scroll-margin-top: 150px;">
							<h3 class="subsection-title">{{ translations[current_language]['Qualification'] }}</h3>
							{{ translated_entity.field_programme_qualification.value|raw }}
						</div>
					{% endif %}

					
					{% if translated_entity.field_distribution_of_credits.value is not empty %}
						<div class="programme-section" id="structure" style="text-align: justify; scroll-margin-top: 150px;">
							<h3 class="subsection-title">
								{{ 'Structure and Distribution of Credits'|t }}
							</h3>


							{{ translated_entity.field_distribution_of_credits.value|raw }}

						</div>
					{% endif %}


					<div class="programme-section" id="iecs" style="text-align: justify; scroll-margin-top: 150px;">
						<h3 class="subsection-title">{{ translations[current_language]['Subjects'] }}</h3>
						
						{# === TABS NAV: By course / By semester === #}
						<ul class="nav nav-tabs justify-content-center mb-3" id="iecsTabs" role="tablist">

							<li class="nav-item" role="presentation">
								<button class="nav-link active" id="tab-by-semester" data-bs-toggle="tab" data-bs-target="#pane-by-semester" type="button" role="tab" aria-controls="pane-by-semester" aria-selected="false">
									{{ 'By term'|t }}
								</button>
							</li>

							<li class="nav-item" role="presentation">
								<button class="nav-link" id="tab-by-course" data-bs-toggle="tab" data-bs-target="#pane-by-course" type="button" role="tab" aria-controls="pane-by-course" aria-selected="true">
									{{ 'By Year'|t }}
								</button>
							</li>

						</ul>

						<div class="tab-content" id="iecsTabsContent">

							<div
								class="tab-pane fade show active" id="pane-by-semester" role="tabpanel" aria-labelledby="tab-by-semester">

								{# Definimos los semestres que queremos mostrar #}
								{% set semester_terms = [1, 2] %}
								{% set semester_labels = {
    1: '1st term'|t,
    2: '2nd term'|t
  } %}


								{# --- BOTONES DE SEMESTRE (como los de course) --- #}
								<div class="custom-btn-group btn-group btn-group-adjustment mb-3" role="group" aria-label="{{ 'Semesters'|t }}">
									{% for term in semester_terms %}
										<button type="button" class="btn btn-outline-primary toggle-button" data-bs-toggle="collapse" data-bs-target="#semester{{ term }}" aria-expanded="false" aria-controls="semester{{ term }}">
											{{ semester_labels[term] }}
										</button>

										{# Versión móvil: tabla dentro del propio loop (como en courses) #}
										<div class="courses-container d-block d-sm-block d-md-none d-lg-none">
											<div id="semester{{ term }}" class="collapse">
												<h4 class="subsection-title">{{ semester_labels[term] }}</h4>
												<table class="table table-bordered">
													<thead>
														<tr>
															<th>{{ translations[current_language]['Code'] }}</th>
															<th>{{ translations[current_language]['Name'] }}</th>
															<th>{{ translations[current_language]['Course'] }}</th>
															<th>{{ translations[current_language]['Quarter'] }}</th>
															<th>{{ translations[current_language]['ECTS'] }}</th>
															<th>{{ translations[current_language]['Type'] }}</th>
														</tr>
													</thead>
													<tbody>
														{% for row in view.result %}
															{% set iec = row._relationship_entities['reverse__node__field_iec_programme'] %}


															{% if iec.field_iec_term[0].value == term %}

																{% if iec.hasTranslation(current_language) %}
																	{% set translated_iec = iec.getTranslation(current_language) %}
																{% else %}
																	{% set translated_iec = iec %}
																{% endif %}


																<tr>
																	<td>
																		{% if translated_iec.field_iec_code is not empty %}
																			{{ translated_iec.field_iec_code[0].value }}
																		{% else %}
																			{{ 'Sin codigo'|t }}
																		{% endif %}
																	</td>
																	<td>
																		<a href="{{ row.custom_url }}">
																			{{ translated_iec.title.value }}
																		</a>
																	</td>
																	<td>
																		{# Curso al que pertenece (usamos courses[year]) #}
																		{% set course_year = translated_iec.field_iec_year[0].value %}
																		{% if course_year in courses|keys %}
																			{{ translations[current_language][courses[course_year]] }}
																		{% else %}
																			{{ '-' }}
																		{% endif %}
																	</td>
																	<td>{{ cuatrimestres_curso[term] }}</td>
																	<td>
																		{% if translated_iec.field_iec_credits is not empty %}
																			{{ translated_iec.field_iec_credits[0].value }}
																		{% else %}
																			{{ '0' }}
																		{% endif %}
																	</td>
																	<td>
																		{% if translated_iec.field_iec_type is not empty %}
																			{{ translations[current_language][translated_iec.field_iec_type[0].value] }}
																		{% else %}
																			{{ 'Sin tipo'|t }}
																		{% endif %}
																	</td>
																</tr>
															{% endif %}
														{% endfor %}
													</tbody>
												</table>
											</div>
										</div>
									{% endfor %}
								</div>

								{# --- Versión escritorio: tablas debajo, como en By course --- #}
								<div class="courses-container d-none d-md-block d-lg-block">
									{% for term in semester_terms %}
										<div id="semester{{ term }}" class="collapse">
											<h4 class="subsection-title">{{ semester_labels[term] }}</h4>
											<table class="table table-bordered">
												<thead>
													<tr>
														<th>{{ translations[current_language]['Code'] }}</th>
														<th>{{ translations[current_language]['Name'] }}</th>
														<th>{{ translations[current_language]['Course'] }}</th>
														<th>{{ translations[current_language]['Quarter'] }}</th>
														<th>{{ translations[current_language]['ECTS'] }}</th>
														<th>{{ translations[current_language]['Type'] }}</th>
													</tr>
												</thead>
												<tbody>
													{% for row in view.result %}
														{% set iec = row._relationship_entities['reverse__node__field_iec_programme'] %}


														{% if iec.field_iec_term[0].value == term %}

															{% if iec.hasTranslation(current_language) %}
																{% set translated_iec = iec.getTranslation(current_language) %}
															{% else %}
																{% set translated_iec = iec %}
															{% endif %}

															<tr>
																<td>
																	{% if translated_iec.field_iec_code is not empty %}
																		{{ translated_iec.field_iec_code[0].value }}
																	{% else %}
																		{{ 'Sin codigo'|t }}
																	{% endif %}
																</td>
																<td>
																	<a href="/{{ row.custom_url }}">
																		{{ translated_iec.title.value }}
																	</a>
																</td>
																<td>
																	{% set course_year = translated_iec.field_iec_year[0].value %}
																	{% if course_year in courses|keys %}
																		{{ translations[current_language][courses[course_year]] }}
																	{% else %}
																		{{ '-' }}
																	{% endif %}
																</td>
																<td>{{ cuatrimestres_curso[term] }}</td>
																<td>
																	{% if translated_iec.field_iec_credits is not empty %}
																		{{ translated_iec.field_iec_credits[0].value }}
																	{% else %}
																		{{ '0' }}
																	{% endif %}
																</td>
																<td>
																	{% if translated_iec.field_iec_type is not empty %}
																		{{ translations[current_language][translated_iec.field_iec_type[0].value] }}
																	{% else %}
																		{{ 'Sin tipo'|t }}
																	{% endif %}
																</td>
															</tr>
														{% endif %}
													{% endfor %}
												</tbody>
											</table>
										</div>
									{% endfor %}
								</div>
							</div>


							{# =========================
														       TAB 1: BY COURSE (lo que ya tenías)
														       ========================= #}
							<div
								class="tab-pane fade" id="pane-by-course" role="tabpanel" aria-labelledby="tab-by-course">

								<!-- Contenedor de los botones de los cursos -->
								<div class="custom-btn-group btn-group btn-group-adjustment mb-3" role="group" aria-label="{{ 'Courses'|t }}">
