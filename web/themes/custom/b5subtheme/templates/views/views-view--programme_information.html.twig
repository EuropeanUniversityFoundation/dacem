        <div class="degree-info-item mb-2">
          <strong>{{ translations[current_language]['Professional Practices'] }}:</strong>
          {{ translations[current_language][translated_entity.field_professional_practices.value] }}
        </div>
      </div>

      <!-- Columna 2: Coordination -->
      <div class="col-12 col-md-6 col-xl-12">
        <h3 class="mt-4 mt-md-0 mt-xl-4">
          {{ translations[current_language]['Coordination'] }}
        </h3>

        <div class="degree-info-item mb-1">{{ translated_entity.field_coordinator.value }}</div>

        <div class="degree-info-item mb-1">
          <i class="fa fa-phone"></i> {{ translated_entity.field_programme_phone.value }}
        </div>

        <div class="degree-info-item mb-1">
          <i class="fa fa-envelope"></i> {{ translated_entity.field_email.value }}
        </div>
      </div>

    </div>
  </div>



