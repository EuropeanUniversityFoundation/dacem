<div class="section-container">
	<div class="my-custom-container-2">


		<div class="scrollspy-example" data-bs-spy="scroll" data-bs-target="#programme-navbar" data-bs-root-margin="0px 0px -60%" tabindex="0">

			<div class="row">
				<div class="col-sm-12 col-md-12 col-xl-8 order-2 order-xl-1">
					<div class="programme-section " id="general-information" style="text-align: justify;">
						<h3 class="subsection-title m-0">{{ translations[current_language]['Presentation'] }}</h3>
						{{ translated_entity.field_programme_description.value|raw }}
					</div>
				
				<div class="programme-section" id="main-objective" style="text-align: justify;">
					<h3 class="subsection-title">{{ translations[current_language]['Main Objective'] }}</h3>
					{{ translated_entity.field_main_objective.value|raw }}
				</div>
				<div class="programme-section" id="competencies" style="text-align: justify;">
					<h3 class="subsection-title">{{ translations[current_language]['Competencies'] }}</h3>
					{{ translated_entity.field_competencies.value|raw }}
				</div>
				<div class="programme-section" id="qualification" style="text-align: justify;">
					<h3 class="subsection-title">{{ translations[current_language]['Qualification'] }}</h3>
					{{ translated_entity.field_programme_qualification.value|raw }}
				</div>


				<div class="programme-section" id="structure" style="text-align: justify;">
					<h3 class="subsection-title">{{ translations[current_language]['Structure and Distribution of credits'] }}</h3>
					<table class="table table-bordered">
						<thead>
							<tr>
								<th>{{ translations[current_language]['Course'] }}</th>
								<th>{{ translations[current_language]['Nucleo'] }}</th>
								<th>{{ translations[current_language]['Obligatorio'] }}</th>
								<th>{{ translations[current_language]['Opcional'] }}</th>
								<th>{{ translations[current_language]['Practicas externas'] }}</th>
								<th>{{ translations[current_language]['Proyecto final'] }}</th>
								<th>{{ translations[current_language]['TOTAL'] }}</th>
							</tr>
						</thead>
						<tbody>
							{% for course_id, course_name in courses %}
								{% set total_credits = 0 %}
								<tr>
									<td>{{ cuatrimestres_curso[course_id] }}</td>
									{% for credit_type in credit_types %}
										<td>{{ credits[course_id][credit_type]|number_format(2, '.', '') }}</td>
										{% set total_credits = total_credits + credits[course_id][credit_type] %}
									{% endfor %}
									<td>{{ total_credits|number_format(2, '.', '') }}</td>
								</tr>
							{% endfor %}
							<tr>
								<td>{{ 'TOTAL'|t }}</td>
								{% set grand_total_credits = 0 %}
								{% for credit_type in credit_types %}
									{% set type_total = 0 %}
									{% for course_id in courses %}
										{% set type_total = type_total + credits[course_id][credit_type] %}
									{% endfor %}
									<td>{{ type_total|number_format(2, '.', '') }}</td>
									{% set grand_total_credits = grand_total_credits + type_total %}
								{% endfor %}
								<td>{{ grand_total_credits|number_format(2, '.', '') }}</td>
							</tr>
						</tbody>
					</table>
				</div>


				<div class="programme-section" id="iecs" style="text-align: justify;">
					<h3 class="subsection-title">{{ translations[current_language]['Subjects'] }}</h3>
					<p>{{ 'The following tables show all the iecs that make up the Study Plan with reference to the 2023-24 academic year'|t }}:</p>

					<!-- Contenedor de	 los botones de los cursos -->
					<div class="custom-btn-group btn-group btn-group-adjustment mb-3" role="group" aria-label="{{ 'Courses'|t }}">
						{% for course_id, course_name in courses %}
							<button type="button" class="btn btn-outline-primary toggle-button" data-bs-toggle="collapse" data-bs-target="#course{{ loop.index }}" aria-expanded="false" aria-controls="course{{ loop.index }}">
								{{ translations[current_language][course_name] }}
							</button>


							<div class="courses-container d-block d-sm-block d-md-none d-lg-none">

								<div id="course{{ loop.index }}" class="collapse">
									<h4 class="subsection-title">{{ translations[current_language][course_name]}}</h4>
									<table class="table table-bordered">
										<thead>
											<tr>
												<th>{{ translations[current_language]['Code'] }}</th>
												<th>{{ translations[current_language]['iec'] }}</th>
												<th>{{ translations[current_language]['Quarter'] }}</th>
												<th>{{ translations[current_language]['ECTS'] }}</th>
												<th>{{ translations[current_language]['Type'] }}</th>
											</tr>
										</thead>
										<tbody>
											{% for row in view.result %}


												{% set iec = row._relationship_entities['reverse__node__field_iec_programme'] %}

												{% if iec.hasTranslation(current_language) %}
													{% set translated_iec = iec.getTranslation(current_language) %}
												{% else %}
													{% set translated_iec = iec %}
												{% endif %}

												{% if translated_iec.field_iec_year[0].value == course_id %}
													<tr>


														<td>
															{% if translated_iec.field_code is not empty %}
																{{ translated_iec.field_code[0].value|t|capitalize }}
															{% else %}
																{{ 'Sin codigo'|t }}
															{% endif %}
														</td>

														<td>

															<!--<a href="{{ path('entity.node.canonical', {'node': translated_iec.id()}) }}">-->
															<a href="{{ row.custom_url }}">
																{{ translated_iec.title.value }}
															</a>
														</td>
														<td>{{ cuatrimestres_curso[translated_iec.field_iec_term[0].value] }}</td>
														<td>
															{% if translated_iec.field_iec_credits is not empty %}
																{{ translated_iec.field_iec_credits[0].value|t|capitalize }}
															{% else %}
																{{ 0}}
															{% endif %}
														</td>
														<td>
															{% if translated_iec.field_iec_type is not empty %}

																{{ translations[current_language][translated_iec.field_iec_type[0].value]}}
															{% else %}
																{{'Sin tipo'}}
															{% endif %}
														</td>

													</tr>
												{% endif %}
											{% endfor %}
										</tbody>
									</table>
								</div>

							</div>


						{% endfor %}
					</div>

					<!-- Contenedor de las tablas colapsables, siempre debajo de los botones -->
					<div class="courses-container d-none d-md-block d-lg-block">
						{% for course_id, course_name in courses %}
							<div id="course{{ loop.index }}" class="collapse">
								<h4 class="subsection-title">{{ translations[current_language][course_name]}}</h4>
								<table class="table table-bordered">
									<thead>
										<tr>
											<th>{{ translations[current_language]['Code'] }}</th>
											<th>{{ translations[current_language]['iec'] }}</th>
											<th>{{ translations[current_language]['Quarter'] }}</th>
											<th>{{ translations[current_language]['ECTS'] }}</th>
											<th>{{ translations[current_language]['Type'] }}</th>
										</tr>
									</thead>
									<tbody>
										{% for row in view.result %}

											{% set iec = row._relationship_entities['reverse__node__field_iec_programme'] %}

											{% if iec.hasTranslation(current_language) %}
												{% set translated_iec = iec.getTranslation(current_language) %}
											{% else %}
												{% set translated_iec = iec %}
											{% endif %}

											{% if translated_iec.field_iec_year[0].value == course_id %}
												<tr>

													<td>
														{% if translated_iec.field_iec_code is not empty %}
															{{ translated_iec.field_iec_code[0].value|t|capitalize }}
														{% else %}
															{{ 'Sin codigo'|t }}
														{% endif %}
													</td>

													<td>

														<a href="/{{ row.custom_url }}">
															{{ translated_iec.title.value }}
														</a>
													</td>
													<td>{{ cuatrimestres_curso[translated_iec.field_iec_term[0].value] }}</td>
													<td>
														{% if translated_iec.field_iec_credits is not empty %}
															{{ translated_iec.field_iec_credits[0].value }}
														{% else %}
															{{ '0' }}
														{% endif %}
													</td>
													<td>

														{% if translated_iec.field_iec_type is not empty %}
															{{ translations[current_language][translated_iec.field_iec_type[0].value]}}
														{% else %}
															{{ 'Sin tipo'|t }}
														{% endif %}
													</td>

												</tr>
											{% endif %}
										{% endfor %}
									</tbody>
								</table>
							</div>
						{% endfor %}
					</div>
				</div>
			</div>


			
<div class="col-sm-12 col-md-12 col-xl-4 degree-sidebar-wrapper order-1 order-xl-2">
  <div class="degree-sidebar bg-light">
    <div class="row g-3 mx-0">

      <!-- Columna 1: General Data -->
