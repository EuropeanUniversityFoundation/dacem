															{% endif %}
														{% endfor %}
													</tbody>
												</table>
											</div>
										</div>
									{% endfor %}
								</div>

								<!-- Contenedor de las tablas colapsables, siempre debajo de los botones (desktop) -->
								<div class="courses-container d-none d-md-block d-lg-block">
									{% for course_id, course_name in courses %}
										<div id="course{{ loop.index }}" class="collapse">
											<h4 class="subsection-title">{{ translations[current_language][course_name] }}</h4>
											<table class="table table-bordered">
												<thead>
