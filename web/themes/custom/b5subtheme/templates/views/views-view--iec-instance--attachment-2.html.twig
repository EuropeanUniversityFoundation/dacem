{% set current_language = language_manager.getCurrentLanguage().getId() %}
{% set university_primary_color = '#000000' %}

{% if view.result|length > 0 %}
  {% set instance = view.result[0]._entity %}
  {% if instance and instance.hasTranslation(current_language) %}
    {% set instance = instance.getTranslation(current_language) %}
  {% endif %}
  {% set iec = instance ? instance.field_iec.entity : null %}
  {% if iec and iec.hasTranslation(current_language) %}
    {% set iec = iec.getTranslation(current_language) %}
  {% endif %}
  {% set programme = iec ? iec.field_iec_programme.entity : null %}
  {% if programme and programme.hasTranslation(current_language) %}
    {% set programme = programme.getTranslation(current_language) %}
  {% endif %}
  {% set institution = programme ? programme.field_programme_institution.entity : null %}
  {% if institution and institution.hasTranslation(current_language) %}
    {% set institution = institution.getTranslation(current_language) %}
  {% endif %}
  {% set university_primary_color = institution.field_primary_color[0].color|default('#000000') %}
{% endif %}

<style>:root
{
	--university_primary_color: {{university_primary_color}}
	;
	
}</style>




{% if view.result|length > 0 %}

  {% set current_path = path('<current>') %}
  {% set current_id = current_path|trim('/')|split('/')|last %}

  {% set current_label = 'Select'|t %}
  {% set seen_instance_ids = [] %}

  {% for row in view.result %}
    {% set instance = row._entity %}
    {% if instance and instance.hasTranslation(current_language) %}
      {% set instance = instance.getTranslation(current_language) %}
    {% endif %}
    {% if instance and instance.id not in seen_instance_ids %}
      {% set seen_instance_ids = seen_instance_ids|merge([instance.id]) %}
    {% endif %}
    {% if instance and (instance.id|striptags|trim == current_id) %}
      {% set current_label = instance.label %}
    {% endif %}
  {% endfor %}

  <div class="subject-edition-band">
    <div class="subject-edition-label">{{ 'Course edition:'|t }}</div>

    <div class="dropdown subject-edition-dropdown">
      <button
        class="subject-edition-btn dropdown-toggle"
        type="button"
        data-bs-toggle="dropdown"
        aria-expanded="false">
        {{ current_label }}
      </button>

      <ul class="dropdown-menu dropdown-menu-dark w-100">
        {% set seen_instance_ids = [] %}
        {% for row in view.result %}
          {% set instance = row._entity %}
          {% if instance and instance.hasTranslation(current_language) %}
            {% set instance = instance.getTranslation(current_language) %}
          {% endif %}
          {% if instance and instance.id not in seen_instance_ids %}
            {% set seen_instance_ids = seen_instance_ids|merge([instance.id]) %}
            <li>
              <a class="dropdown-item {% if (instance.id|striptags|trim == current_id) %}active{% endif %}"
                 href="{{ path('view.iec_instance.page_1', {'arg_0': instance.id}, {'language': language_manager.getLanguage(current_language)}) }}">
                {{ instance.label }}
              </a>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </div>
{% endif %}
