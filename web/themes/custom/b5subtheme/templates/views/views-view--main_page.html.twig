{{ attach_library('b5subtheme/university_carousel') }}

{% set current_language = view.result[0].node_field_data_langcode %}


<div class="image-banner">
	<img src="/themes/custom/b5subtheme/images/panoramic_uni6.jpg" alt="Study in Europe">
	<div class="overlay-text">
		<h2 class="text-main-image-uni">Study in Europe</h2>
		<a href="/search-programme"><button class="cta-button">FIND A PROGRAM</button></a>
	</div>
</div>

<div class="container-flex container-university-list">

	<p class="d-flex text-under-main-image-uni">Explore the best opportunities to study in Europe. Discover universities, programs, and destinations tailored to your future. Your next academic adventure starts here.</p>

	<div
		id="universityCarousel" class="carousel slide" data-bs-ride="carousel">
		<!-- Indicadores del carrusel -->
		<div class="carousel-indicators">
			{% for i in 0..((view.result|length / 3)|round(0, 'ceil') - 1) %}
				<button type="button" data-bs-target="#universityCarousel" data-bs-slide-to="{{ i }}" class="{% if loop.first %}active{% endif %}" aria-current="true"></button>
			{% endfor %}
		</div>

		<!-- Contenido del carrusel -->
		<div class="carousel-inner">
			{% for row in view.result %}
				{% set is_active = loop.index0 == 0 %}
				{% if loop.index0 % 3 == 0 %}
					<div class="carousel-item {% if is_active %}active{% endif %}">
						<div class="row justify-content-center">
						{% endif %}
						<!-- Tarjeta de la universidad -->
						<div class="col-12 col-md-4">

							<a href="/{{ row.custom_url }}" class="card h-100">

								{% set file = row._entity.field_institution_card_image.entity %}


								{% if file %}
									{% set uri = file.getFileUri() %}
									{% set image_url = file_url(uri) %}
									<div>
										<img src="{{ image_url }}" alt="{{ row._entity.title.value }}">
									</div>
								{% endif %}


							
							<div class="card-body ">
								<h5 class="card-title">{{ row._entity.title.value }}</h5>
								<p class="card-text-country">{{ row._country_name }}</p>
								
								<p class="card-text truncate-text">{{ row._entity.field_information.processed | striptags }}</p>
							</div>


						</a>
					</div>
					{% if loop.index0 % 3 == 2 or loop.last %}
					</div>
				</div>
			{% endif %}
		{% endfor %}
	</div>

	<!-- Controles del carrusel -->
	<!-- Controles del carrusel con flechas personalizadas -->
	<button class="carousel-control-prev custom-prev" type="button" data-bs-target="#universityCarousel" data-bs-slide="prev">
		<span aria-hidden="true" class="custom-arrow">
			<i class="fas fa-chevron-left"></i>
			<!-- Icono FontAwesome -->
		</span>
		<span class="visually-hidden">Previous</span>
	</button>
	<button class="carousel-control-next custom-next" type="button" data-bs-target="#universityCarousel" data-bs-slide="next">
		<span aria-hidden="true" class="custom-arrow">
			<i class="fas fa-chevron-right"></i>
			<!-- Icono FontAwesome -->
		</span>
		<span class="visually-hidden">Next</span>
	</button>
</div>

<div class="row map-and-explore">
	<div class="col-12 col-xl-7">
		<div class="map-wrapper" style="min-height: 300px;">
			{{ drupal_view('map_view', 'block_5') }}
		</div>
	</div>
	<div class="col-12 col-xl-5" style="justify-content">
		<h2>EXPLORE OUR UNIVERSITIES</h2>

		<p>Find a new place to continue your studies, meet new people and learn a new language. Before this, you should:</p>

		<ul>
			<li>
				Find which
				<strong>universities</strong>
				are
				<strong>available</strong>
				from your home university at your local international office.
			</li>
			<li>
				Ensure the
				<strong>courses</strong>
				align with your degree, are taught in a language you understand, and fit your academic
				<strong>calendar</strong>.
			</li>
			<li>
				Assess
				<strong>accommodation</strong>,
				<strong>transportation</strong>, and daily
				<strong>expenses</strong>.
			</li>
			<li>
				Research the local culture,
				<strong>student life</strong>, and opportunities for personal and
				<strong>professional growth</strong>.
			</li>
			<li>
				Check healthcare coverage,
				<strong>safety</strong>, and housing availability.
			</li>
		</ul>

		<p style="text-align: center; font-size: 18px; font-weight: bold; color: #000;">Don't miss the opportunity!</p>
	</div>


</div></div>
