{{ attach_library('b5subtheme/course_buttons') }}
{{ attach_library('b5subtheme/degree_menu_scroll') }}



{% set entity = view.result[0]._entity %}


{% set current_language = view.result[0].node_field_data_langcode %}


	{% if entity.hasTranslation(current_language) %}
	{% set translated_entity = entity.getTranslation(current_language) %}

{% else %}
	{% set translated_entity = entity %}

{% endif %}


{% set institution = entity.field_programme_institution.entity %}

{% set programme_ou = null %}
{% set programme_ou_url = '' %}
{% if translated_entity.hasField('field_programme_ou') and not translated_entity.get('field_programme_ou').isEmpty() %}
	{% set programme_ou = translated_entity.field_programme_ou.entity %}
	{% if programme_ou.hasTranslation(current_language) %}
		{% set programme_ou = programme_ou.getTranslation(current_language) %}
	{% endif %}

	{% set programme_ou_path = path('entity.node.canonical', {'node': programme_ou.id()}, {'langcode': current_language}) %}
	{% set programme_ou_path_parts = programme_ou_path|trim('/')|split('/') %}
	{% if programme_ou_path_parts|length >= 2 %}
		{% set programme_ou_alias = programme_ou_path_parts|last %}
		{% set programme_ou_institution_alias = programme_ou_path_parts[programme_ou_path_parts|length - 2] %}
		{% set programme_ou_url = path('view.organizational_unit_information.page_1', {
			'arg_0': programme_ou_institution_alias,
			'arg_1': programme_ou_alias
		}, {'langcode': current_language}) %}
	{% endif %}
{% endif %}

{% set institution_primary_color = institution.field_primary_color[0].color %}
{% set institution_text_color = institution.field_text_color[0].color %}
{% set institution_emphasis_text_color = institution.field_emphasis_text_color[0].color %}

		{% if translations is defined %}

	{% else %}
		No translations loaded.
{% endif %}


<style>:root
{
	--university_primary_color: {{institution_primary_color}}
	;
	--university_text_color: {{institution_text_color}}
	;
	--university_emphasis_text_color: {{institution_emphasis_text_color}}
	;
}</style>{% set curriculum = programme_curriculum|default({
  'years': {
    '1': {'id': '1', 'label': 'Year 1'|t},
    '2': {'id': '2', 'label': 'Year 2'|t},
    '3': {'id': '3', 'label': 'Year 3'|t},
    '4': {'id': '4', 'label': 'Year 4'|t}
  },
  'terms': {
    1: {'id': 1, 'label': 'Term 1'|t},
    2: {'id': 2, 'label': 'Term 2'|t}
  },
  'term_short_labels': {
    '1': '1',
    '2': '2'
  }
}) %}{% set iec_groups = programme_iec_groups|default({'by_year': {}, 'by_term': {}}) %}{% set cuatrimestres_curso = curriculum.term_short_labels %}{% set courses = curriculum.years %}{% set credit_types = [
  'Core',
  'Mandatory',
  'Optional',
  'Other',
] %}{% set credits = {} %}{% for course_id, course in courses %}
{% set credits = credits|merge({ (course_id): {'Core': 0, 'Mandatory': 0, 'Optional': 0, 'Other': 0} }) %}
{% endfor %}{% for row in view.result %}
{% set iec = row._relationship_entities['reverse__node__field_iec_programme'] %}

{% if iec.hasTranslation(current_language) %}
	{% set translated_iec = iec.getTranslation(current_language) %}

{% else %}

	{% set translated_iec = iec %}
{% endif %}
{% set course_id = translated_iec.field_iec_year[0].value %}
{% set credit_type = translated_iec.field_iec_type[0].value|trim %}
{% set credit_value = translated_iec.field_iec_credits[0].value|number_format(2, '.', '') %}


{% if course_id in credits|json_encode(constant('JSON_PRETTY_PRINT')) and credit_type|capitalize in credits[course_id]|json_encode(constant('JSON_PRETTY_PRINT')) %}
	{% set credits = credits|merge({ (course_id): credits[course_id]|merge({ (credit_type)|capitalize: credits[course_id][credit_type|capitalize] + credit_value }) }) %}
	{% else %}
	
{% endif %}{% endfor %}<div class="programme-page">


