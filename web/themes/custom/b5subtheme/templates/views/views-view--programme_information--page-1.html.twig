					<a href="{{ programme_ou_url }}" class="ou-tag px-3 py-1 text-decoration-none" style="background-color: {{ institution_primary_color }}; color: {{ institution_emphasis_text_color }}; border: 2px solid {{ institution_primary_color }}; border-radius: 0;">
						{{ programme_ou.title.value }}
