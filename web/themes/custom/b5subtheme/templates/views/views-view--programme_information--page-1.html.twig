											{{ term_info.label }}
										</button>

										<div class="courses-container d-block d-sm-block d-md-none d-lg-none">
											<div id="semester{{ term }}" class="collapse {{ is_default_term ? 'show' : '' }}" aria-expand>
												<h4 class="subsection-title">{{ term_info.label }}</h4>
												<table class="table table-bordered">
													<thead>
														<tr>
															<th>{{ translations[current_language]['Code'] }}</th>
															<th>{{ translations[current_language]['Name'] }}</th>
															<th>{{ 'Year'|t }}</th>
															<th>{{ 'Term'|t }}</th>
															<th>{{ translations[current_language]['ECTS'] }}</th>
															<th>{{ translations[current_language]['Type'] }}</th>
															<th>{{ 'Mobility'|t }}</th>
														</tr>
													</thead>
														<tbody>
															{% for iec_item in iec_groups.by_term[term ~ '']|default([]) %}
																<tr>
																	<td>{{ iec_item.code ?: 'Sin codigo'|t }}</td>
																	<td>
																		<a href="{{ iec_item.url }}">
																			{{ iec_item.title }}
																		</a>
																	</td>
																	<td>
																		{% if iec_item.year in courses|keys %}
																			{{ courses[iec_item.year].label }}
																		{% else %}
																			{{ '-' }}
																		{% endif %}
																	</td>
																	<td>{{ cuatrimestres_curso[term ~ ''] ?? term }}</td>
																	<td>{{ iec_item.credits ?: '0' }}</td>
																	<td>{{ iec_item.type ? translations[current_language][iec_item.type] : 'Sin tipo'|t }}</td>
																	<td>{{ iec_item.mobility ? 'Yes'|t : 'No'|t }}</td>
																</tr>
															{% endfor %}
														</tbody>
													</table>
												</div>
											</div>
									{% endfor %}
								</div>

								<div class="courses-container d-none d-md-block d-lg-block">
									{% for term, term_info in semester_terms %}
