		<ul class="nav nav-tabs justify-content-center d-none d-lg-flex">
			<li class="nav-item">
				<a class="nav-link active" href="#presentation">{{ 'Overview'|t }}</a>
			</li>
			<li class="nav-item">
				<a class="nav-link" href="#structure">{{ 'Curriculum'|t }}</a>
