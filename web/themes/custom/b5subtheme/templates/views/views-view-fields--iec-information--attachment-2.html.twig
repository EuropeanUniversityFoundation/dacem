{% if view.result|length > 0 %}
  <div class="iec-sidebar-edition">
    <div class="subject-edition-band">
      <div class="subject-edition-label">
        {{ 'Subject edition:'|t }}
      </div>

      <div class="subject-edition-dropdown">
        <select class="subject-edition-select"
                onchange="if (this.value) window.location.href=this.value;">
          {% for row in view.result %}
            {% set instance = row._entity %}
            {% set label = instance.label %}
            {% set url = path('entity.node.canonical', {'node': instance.id}) %}
            <option value="{{ url }}">{{ label }}</option>
          {% endfor %}
        </select>
      </div>
    </div>
  </div>
{% endif %}