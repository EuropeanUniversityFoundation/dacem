{% set current_language = view.result[0].node_field_data_langcode %}

{# Acceder a la asignatura actual #}
{% set subject = view.result[0]._entity %}
{% if subject.hasTranslation(current_language) %}
	{% set translated_subject = subject.getTranslation(current_language) %}
{% else %}
	{% set translated_subject = subject %}
{% endif %}

{# Acceder a la carrera a la que pertenece la asignatura #}
{% set degree = translated_subject.field_carrera.entity %}
{% if degree %}
	{% if degree.hasTranslation(current_language) %}
		{% set translated_degree = degree.getTranslation(current_language) %}
	{% else %}
		{% set translated_degree = degree %}
	{% endif %}
{% endif %}

{# Acceder a la universidad a la que pertenece la carrera #}
{% set university = degree.field_universidad.entity %}
{% if university %}
	{% if university.hasTranslation(current_language) %}
		{% set translated_university = university.getTranslation(current_language) %}
	{% else %}
		{% set translated_university = university %}
	{% endif %}
{% endif %}

{# Obtener colores de la universidad #}
{% set university_primary_color = translated_university.field_primary_color[0].color %}
{% set university_text_color = translated_university.field_text_color[0].color %}
{% set university_emphasis_text_color = translated_university.field_emphasis_text_color[0].color %}

<style>:root
{
	--university_primary_color: {{university_primary_color}}
	;
	--university_text_color: {{university_text_color}}
	;
	--university_emphasis_text_color: {{university_emphasis_text_color}}
	;
}</style>

{# Cuatrimestres del curso #}
{% set cuatrimestres_curso = {
  '1o': '1º',
  '2o': '2º',
  '3o': '3º',
  '4o': '4º',
} %}

<div class="degree-page">
	<div class="sticky-nav">
		<a href="{{ path('entity.node.canonical', {'node': translated_degree.id}) }}" class="degree-header-link">
			<div class="degree-header">
				<div class="container-fluid">
					<h1 class="degree-title">
						{{ translated_degree.title.value|raw }}
					</h1>
				</div>
			</div>
		</a>
		<div class="subject-header">
			<div class="container-fluid">
				<h5>{{ translations[current_language]['Subject'] }}</h5>
				<h2 class="subject-title">
					{{ translated_subject.label|upper }}
				</h2>
			</div>
		</div>
	</div>

	<div class="container-fluid">
		<div class="my-custom-container">
			<div class="row">
				<div class="col-lg-7 col-md-12 col-sm-12">
					<div class="degree-section" id="general-information" style="text-align: justify;">
						<h3>{{ translations[current_language]['PRESENTATION'] }}</h3>
						{{ translated_subject.field_subject_introduction.value|raw }}
					</div>
				</div>

				<div class="col-lg-5 col-md-12 mt-4 mt-lg-0">
					<div class="degree-sidebar bg-light p-3">
						<h3>{{ translations[current_language]['General Data'] }}</h3>
						<div class="row">
							<div class="col-md-6">
								<strong>{{ translations[current_language]['Academic Course'] }}:</strong>
								23/24
							</div>
							<div class="col-md-6">
								<strong>{{ translations[current_language]['Type'] }}:</strong>
								{{translations[current_language][translated_subject.field_tipo.value]|capitalize}}
							</div>
						</div>
						<div class="row mt-2">
							<div class="col-md-6">
								<strong>{{ translations[current_language]['Course'] }}:</strong>
								{{ cuatrimestres_curso[translated_subject.field_curso.value] }}
							</div>
							<div class="col-md-6">
								<strong>{{ translations[current_language]['Period'] }}:</strong>
								{{ cuatrimestres_curso[translated_subject.field_cuatrimestre.value] }}
							</div>
						</div>
						<div class="row mt-2">
							<div class="col-md-12">
								<strong>{{ translations[current_language]['ECTS Credits'] }}:</strong>
								{{ translated_subject.field_creditos.value }}
							</div>
						</div>
						<div class="row mt-2">
							<div class="col-md-12">
								<strong>{{ translations[current_language]['Modality'] }}:</strong>
								{{translations[current_language][translated_subject.field_subject_modality.value] }} 
							</div>
						</div>
						<div class="row mt-2">
							<div class="col-md-12">
								<strong>{{ translations[current_language]['Requirements'] }}:</strong>
								{{ translated_subject.field_requirements.value }}
							</div>
						</div>
						<div class="row mt-2">
							<div class="col-md-12">
								<strong>{{ translations[current_language]['Language'] }}:</strong>
								{{ translated_subject.field_subject_language.value|capitalize }}
							</div>
						</div>
						<h3 class="mt-4">{{ translations[current_language]['Coordination'] }}</h3>
						<p>{{ translated_subject.field_coordinador.value }}</p>
						<p>
							<i class="fa fa-phone"></i>
							{{ translated_subject.field_telefono.value }}
						</p>
						<p>
							<i class="fa fa-envelope"></i>
							{{ translated_subject.field_email.value }}
						</p>
					</div>
				</div>
			</div>

			<div class="row">
				<div class="col-lg-7 col-md-12 col-sm-12">
					<div class="degree-section" id="main-objective" style="text-align: justify;">
						<h3>{{ translations[current_language]['INSTRUCTORS'] }}</h3>
						{{ translated_subject.field_subject_instructors.value|raw }}
					</div>
					<div class="degree-section" id="competencies" style="text-align: justify;">
						<h3>{{ translations[current_language]['SUBJECT CONTENT'] }}</h3>
						{{ translated_subject.field_subject_contents.value|raw }}
					</div>
					<div class="degree-section" id="competencies" style="text-align: justify;">
						<h3>{{ translations[current_language]['LEARNING OUTCOMES'] }}</h3>
						{{ translated_subject.field_subject_learning_outcomes.value|raw }}
					</div>
					<div class="degree-section" id="competencies" style="text-align: justify;">
						<h3>{{ translations[current_language]['RECOMMENDED READINGS AND TOOLS'] }}</h3>
						{{ translated_subject.field_subject_recommendations.value|raw }}
					</div>
					<div class="degree-section" id="competencies" style="text-align: justify;">
						<h3>{{ translations[current_language]['PLANNED ACTIVITIES'] }}</h3>
						{{ translated_subject.field_subject_planned_activities.value|raw }}
					</div>
					<div class="degree-section" id="competencies" style="text-align: justify;">
						<h3>{{ translations[current_language]['EVALUATION METHODS AND CRITERIA'] }}</h3>
						{{ translated_subject.field_subject_evaluation.value|raw }}
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
