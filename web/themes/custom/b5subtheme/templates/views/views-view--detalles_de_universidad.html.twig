{# Seleccionar las etiquetas del idioma actual #}
{% set category_labels = categories[current_language] ?? categories['en'] %}





<style>:root
{
	--university_primary_color: {{university_primary_color}}
	;
	--university_text_color: {{university_text_color}}
	;
	--university_emphasis_text_color: {{university_emphasis_text_color}}
	;
}</style><div
class="container-fluid">
<!-- Menú superior de la universidad -->

<div class="search-and-filters-container mb-4">
	<div
		class="search-and-filters">
		<!-- Encabezado de búsqueda -->
		<div class="search-header d-flex align-items-center mb-3">
			<div class="search-header-row row">
				<div class="col-lg-5 col-md-12 col-sm-12">
					<h1>{{translations[current_language]['CATALOGUE']}}</h1>
				</div>
				<div class="col-lg-3">
					<div class="d-flex">
						<button class="btn filter-button me-2 selected" id='titulaciones-button'>{{translations[current_language]['DEGREES']}}</button>
						<button class="btn filter-button" id='asignaturas-button'>{{translations[current_language]['SUBJECTS']}}</button>
					</div>
				</div>
			</div>
		</div>

		<!-- Barra de búsqueda -->
		<div class="search-bar d-flex mb-3">
			<input type="text" class="form-control" id='search-input' placeholder={{translations[current_language]['Search']}}>
			<button class="btn btn-dark search-button ms-0" id='search-button'>
				<i class="fas fa-search"></i>
			</button>
		</div>

		<!-- Filtros -->
		<div class="row filters d-flex align-items-center flex-wrap">
			<div
				class="col-lg-1 col-md-2 col-sm-2">
				<!-- Botón de filtro (visible solo en pantallas grandes) -->
				<button class="btn btn-danger d-none d-lg-block w-100">
					<i class="fas fa-filter"></i>
				</button>
			</div>

			<div class="col-lg-2 col-md-12 col-sm-12 d-lg-none">
				<select class="form-control me-2">
					<option>{{ 'All'|t }}</option>
					{% set sorted_keys = grouped_carreras|keys|sort %}
					{% for area in sorted_keys %}
						<option>{{ category_labels[area] }}</option>
					{% endfor %}
				</select>
			</div>

			<div class="col-lg-2 col-md-12 col-sm-12">
				<select class="form-control me-2">
					<option>{{ translations[current_language]['LEVEL'] }}</option>
					<option>{{ translations[current_language]['Bachelor'] }}</option>
					<option>{{ translations[current_language]['Master'] }}</option>
				</select>
			</div>
			<div class="col-lg-2 col-md-12 col-sm-12">
				<select class="form-control me-2">
					<option>{{ translations[current_language]['LANGUAGE'] }}</option>
					<option>{{ translations[current_language]['Spanish'] }}</option>
					<option>{{ translations[current_language]['English'] }}</option>
				</select>
			</div>
			<div class="col-lg-2 col-md-12 col-sm-12">
				<select class="form-control">
					<option>2024</option>
					<option>2023</option>
					<option>2022</option>
				</select>
			</div>
		</div>
	</div>
</div>


<div
	class="row w-100">
	<!-- Barra lateral con categorías -->
	<div class="col-md-3 d-none d-lg-block ">
		<div class="navbar sidebar-categories ">


			<ul class="nav flex-column">
				{% if grouped_carreras is defined %}
					{% set sorted_keys = grouped_carreras|keys|sort %}
					{% for area in sorted_keys %}
						<li class="nav-item">
							<a class="nav-link" href="#{{ area | clean_id }}">
								<i class="{{ icon_map[area] }}"></i>
								{{ category_labels[area] }}
							</a>
						</li>
					{% endfor %}
				{% else %}
					<li class="nav-item">
						<a class="nav-link" href="#">
							<i class="fas fa-folder"></i>
							No hay áreas disponibles</a>
					</li>
				{% endif %}
			</ul>
		</div>
	</div>

	<!-- Contenido principal -->
	<div
		class="col-md-9">
		<!-- Lista de programas o titulaciones -->
		<div class="program-list m-lg-0">
			{% if grouped_carreras is defined %}
				{% for area in sorted_keys %}
					<h2 id="{{ area | clean_id }}">{{ category_labels[area]|upper }}</h2>
					<ul>
						{% for carrera in grouped_carreras[area] %}
							<li>
								<a href="{{ carrera.url }}">
									{{ carrera.title }}
								</a>
							</li>
						{% endfor %}
					</ul>
				{% endfor %}
			{% else %}
				<p>No hay carreras disponibles.</p>
			{% endif %}
		</div>
	</div>
</div></div>
