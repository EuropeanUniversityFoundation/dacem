
   {{dump(view.result)}}
<div class="bg-danger" style="height:300px;">

    <div class="section-container">
        <div class="my-custom-container-2">

            <div class="row">

                <div class="col-auto">
                    <h2 class="section-title" style="color:white">Catalogue</h2>
                </div>

                <div class="col-auto">
                    <button class="btn btn-primary bg-black">Select Home Programme</button>
                </div>

            </div>


            <div class="row">
                <div class="col-12">
                    <div class="input-group mb-3">
                        <input type="text" class="form-control bg-light border-0" placeholder="Type here to search" id="ou-search">
                        <button class="btn btn-outline-secondary pe-4 ps-4 bg-black" type="button" id="search-btn">
                            <i class="fas fa-search" style="color: white;"></i>
                        </button>
                    </div>
                </div>

            </div>

            {% if exposed %}
                <div class="catg__filters">
                    {{ exposed }}
                </div>
            {% endif %}


        </div>
    </div>


</div>


<div class="section-container bg-light">
    <div class="my-custom-container-2">


        <div class="col-lg-8 offset-lg-2 catg__results">
        {% if view.result is not empty %}
            {% for row in view.result %}
            {% set programme = row._entity %}
            {% set institution = programme.field_programme_institution.entity ?? null %}
            {% set logo_uri = null %}
            {% if institution and institution.field_logo.entity is defined %}
                {% set logo_uri = institution.field_logo.entity.fileuri %}
            {% endif %}

            <a href="{{ path('entity.node.canonical', {'node': programme.id}) }}" class="text-decoration-none text-reset">
                <div class="card shadow-none mb-3 border-0 rounded-0" style="height: 123.65px; cursor: pointer;">
                <div class="row g-0">
                    <!-- Imagen (logo institución) -->
                    <div class="col-3" style="height: 123.65px;">
                    {% if logo_uri %}
                        <img src="{{ file_url(logo_uri) }}" alt="{{ institution ? institution.label : '' }}" class="img-fluid rounded-0 h-100 object-fit-contain p-2">
                    {% else %}
                        <div class="bg-light d-flex align-items-center justify-content-center h-100">
                        <span class="text-muted small">No logo</span>
                        </div>
                    {% endif %}
                    </div>

                    <!-- Texto -->
                    <div class="col-9">
                    <div class="card-body p-2">
                        <h5 class="card-title mb-1 text-start">{{ programme.label }}</h5>

                        <div class="d-flex mb-3">
                            {% if institution.title.value is defined %}
                            
                                <span class="ou-tag px-3 py-1"
                                    style="background-color: #F44743; color: #fff; border-radius: 0;">
                                {{ institution.title.value }}
                                </span>
                            {% endif %}


                            {% if institution.field_institution_country.value %}
                                <span class="ou-tag px-3 py-1"
                                    style="background-color: black; color: white; border: 2px solid black; border-radius: 0;">
                                {{ institution.field_institution_country.value  }}
                                </span>
                            {% endif %}
                            </div>

                    </div>
                    </div>
                </div>
                </div>
            </a>
            {% endfor %}
        {% else %}
            <p class="empty">{{ empty }}</p>
        {% endif %}
        </div>


    </div>
</div>





<br><br><br><br><br><br><br><br>



      