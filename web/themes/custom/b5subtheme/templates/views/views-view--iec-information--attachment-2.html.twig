<div class="subject-edition-band">
  <div class="subject-edition-label">
    {{ 'Subject edition:'|t }}
  </div>

  <div class="dropdown subject-edition-dropdown">
    <button
      class="subject-edition-btn dropdown-toggle"
      type="button"
      data-bs-toggle="dropdown"
      aria-expanded="false">
      {{ 'Select instance'|t }}
    </button>

    <ul class="dropdown-menu dropdown-menu-dark w-100">
      {% for row in view.result %}
        {% set instance = row._entity %}
        {% if instance %}
          <li>
            <a class="dropdown-item"
               href="/iec-instance/{{ instance.id }}">
              {{ instance.label }}
            </a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</div>