<div class="section-container">
	<div class='my-custom-container-2'>

		<div
			class="admission-section" id='admission'>
			<!-- Título principal centrado -->

			<h2 class="section-title text-center">Admission</h2>


			<!-- Descripción general -->
			{% if institution.field_admission_description is not empty %}
