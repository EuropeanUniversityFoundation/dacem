					<!-- Mapa -->
					<div class="col-lg-7 col-12 mb-4 mb-lg-0">
						<div
							class="map-wrapper" style="height: 600px;">
							<!--<img src="/themes/custom/b5subtheme/images/general_information_campuses_map.png" alt="Mapa de campus" class="img-fluid h-100 w-100 object-fit-cover rounded shadow">-->
							{{ drupal_block('views_block:map_view-block_2') }}
						</div>

					</div>

					<!-- Tarjetas -->
					<div class="col-lg-5 col-12">

						<div style="max-height: 400px; overflow-y: auto;">
							{% for campus in campuses %}
								{% set campus_path = path('entity.node.canonical', {'node': campus.id}) %}
								{% set parts = campus_path|trim('/')|split('/') %}


								{# Últimos 2 segmentos son institution y campus #}
								{% set campus_alias = parts|last %}
								{% set institution_alias = parts[parts|length - 2] %}

								<a href="{{ path('view.campus_information.page_1', { 'arg_0': institution_alias, 'arg_1': campus_alias }) }}" class="text-decoration-none text-reset">

									<div class="card mb-3 shadow-sm border-0 rounded-0" style="height: 123.65px; cursor: pointer;">
										<div
											class="row g-0">
											<!-- Imagen -->
											<div class="col-3" style="height: 123.65px">
												{% if campus.field_campus_picture is not empty %}
													{% set media_entity = campus.field_campus_picture.entity %}
													{% if media_entity is not empty %}
														{% set file_entity = media_entity.field_media_image.entity %}
														{% if file_entity is not empty %}
															<img src="{{ file_url(file_entity.uri.value) }}" alt="{{ campus.title.value }}" class="img-fluid rounded-0 h-100 object-fit-cover">
														{% endif %}
													{% endif %}
												{% endif %}
											</div>
											<!-- Texto -->
											<div class="col-9">
												<div class="card-body p-2">
													<h5 class="card-title mb-1 text-start">{{ campus.title.value }}</h5>
													{% if campus.field_campus_location is not empty %}
														<p class="mb-1 text-muted small text-start">{{ campus.field_campus_location.value }}</p>
													{% endif %}
												</div>
											</div>
										</div>
									</div>
								</a>
							{% endfor %}
						</div>


					</div>

				</div>
			</div>
		</div>
	{% endif %}

	<br>


</div>

