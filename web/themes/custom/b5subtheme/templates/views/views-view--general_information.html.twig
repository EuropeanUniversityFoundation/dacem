							{# Traducción #}
							{% if organizational_unit.hasTranslation(current_language) %}
								{% set organizational_unit = organizational_unit.getTranslation(current_language) %}
							{% endif %}


							{# Campus y su etiqueta (con traducción, si existe) #}
							{% set campus_label = '' %}

							{% if organizational_unit.hasField('field_ou_campus') 
      and not organizational_unit.get('field_ou_campus').isEmpty() %}
								{% set campus_entity = organizational_unit.field_ou_campus.entity %}
								{% set campus_label = campus_entity.label %}
								{% if campus_entity and campus_entity.hasTranslation(current_language) %}
									{% set campus_label = campus_entity.getTranslation(current_language).label %}
								{% endif %}
							{% endif %}


							{# URL de la página de info de la OU #}
							{% set ou_path = path('entity.node.canonical', {'node': organizational_unit.id()}) %}
							{% set parts = ou_path|trim('/')|split('/') %}
							{% set ou_alias = parts|last %}
							{% set institution_alias = parts[parts|length - 2] %}
							{% set ou_info_url = path('view.organizational_unit_information.page_1', {
      'arg_0': institution_alias,
      'arg_1': ou_alias
    }) %}

							{# Coordenadas desde WKT #}
							{% set coords_ou = '' %}
							{% if organizational_unit.field_ou_map.value is defined and organizational_unit.field_ou_map.value %}
								{% set point  = organizational_unit.field_ou_map.value %}
								{% set coords = point|replace({'POINT(':'','POINT (':'', ')':''})|trim|split(' ') %}
								{% set lon = coords[0]|default('') %}
								{% set lat = coords[1]|default('') %}
								{% set coords_ou = lat ~ ', ' ~ lon %}
							{% endif %}

							{# -------- IMAGEN --------
																				       Intenta sacar la URL de la imagen. Si no hay, queda vacío y el JS hará fallback. #}
							{% set ou_image_url = '' %}
							{% if organizational_unit.field_ou_picture is defined 
          and organizational_unit.field_ou_picture.entity is not empty %}
								{% set img_file = organizational_unit.field_ou_picture.entity %}
								{% set ou_image_url = file_url(img_file.getFileUri()) %}

							{% endif %}

							<div class="ou-item p-3 mb-3 bg-light" data-ou-title="{{ organizational_unit.title.value|e('html_attr') }}" data-ou-type="{{ organizational_unit.field_ou_type.value|default('')|e('html_attr') }}" data-ou-area="{{ organizational_unit.field_ou_area.value|default('')|e('html_attr') }}" data-ou-description="{{ organizational_unit.field_oa_description.value|striptags|e('html_attr') }}" data-ou-address="{{ organizational_unit.field_ou_address.value|default('')|e('html_attr') }}" data-ou-gps="{{ coords_ou|e('html_attr') }}" data-ou-web="{{ organizational_unit.field_ou_web.uri|default('')|e('html_attr') }}" data-ou-web-label="{{ organizational_unit.field_ou_web.title|default('')|e('html_attr') }}" data-ou-email="{{ organizational_unit.field_ou_email.value|default('')|e('html_attr') }}" data-ou-phone="{{ organizational_unit.field_ou_phone.value|default('')|e('html_attr') }}" data-ou-campus-id="{{ organizational_unit.field_ou_campus.entity.id()|e('html_attr') }}" data-ou-campus-label="{{ campus_label|e('html_attr') }}" data-ou-url="{{ ou_info_url|e('html_attr') }}" data-ou-image="{{ ou_image_url|e('html_attr') }}" onclick="loadOUDetails(this)">

								<h5 class="mb-1">{{ organizational_unit.title.value }}</h5>
								<p class="mb-0 small ou-type">
									{% set ou_type = organizational_unit.field_ou_type.value|default('') %}
									{% set campus = campus_label|default('') %}

									{% if ou_type %}
										{{ ou_type }}
									{% endif %}

									{% if ou_type and campus %}
										&nbsp;·&nbsp;
									{% endif %}

									{% if campus %}
										<strong>{{ campus }}</strong>
									{% endif %}
								</p>

							</div>
						{% endif %}
					{% else %}
						<p>No Organizational Units found.</p>
					{% endfor %}

				</div>


			</div>

			<!-- Columna derecha: detalle dinámico -->
			<div class="col-lg-6">
				<div id="ou-details" class="bg-light h-100">
					<p class="text-muted text-center pt-5">Click on an Organizational Unit to see its details.</p>
					<!-- Aquí se rellenará dinámicamente con JS -->
				</div>
			</div>
		</div>
	</div>
{% endif %}</div><!--
		<div class="last-update bg-black text-white p-3">
		  <div class="section-container pt-0 pb-0">
		    <div class="my-custom-container-2">
		
		      <span class="rs-source">
		        Source: <span class="rs-source-site">Example.com</span>
		      </span>
		
		      <span class="rs-last-update">
		        <em>Last update: {{ last_updated }}</em>
		      </span>
		
		    </div>
		  </div>
		</div>
		--><script>
function loadOUDetails(el) {
document.querySelectorAll('.ou-item').forEach(item => item.classList.remove('selected'));
el.classList.add('selected');

const title = el.dataset.ouTitle || '';
const type = el.dataset.ouType || '';
const description = el.dataset.ouDescription || '';
const address = el.dataset.ouAddress || '';
const gps = el.dataset.ouGps || '';
const web = el.dataset.ouWeb || '';
const webLabel = el.dataset.ouWebLabel || web;
const email = el.dataset.ouEmail || '';
const phone = el.dataset.ouPhone || '';
const campus = el.dataset.ouCampusLabel || '';
const url = el.dataset.ouUrl || '#';
const image = el.dataset.ouImage || '';

const imageSrc = image ? image : '/themes/custom/b5subtheme/images/ou-default.png';

// Bloques opcionales: si el valor está vacío, no se renderiza nada (ni icono ni espacio).
const webHTML = web ? `
      <div class="d-flex align-items-start mb-2">
        <i class="fas fa-globe me-2 mt-1"></i>
        <p class="mb-0"><a href="${web}" target="_blank" rel="noopener">${webLabel}</a></p>
      </div>
  ` : '';

const emailHTML = email ? `
      <div class="d-flex align-items-start mb-2">
        <i class="fas fa-envelope me-2 mt-1"></i>
        <p class="mb-0">${email}</p>
      </div>
  ` : '';

const phoneHTML = phone ? `
	  <div class="d-flex align-items-start mb-2">
        <i class="fas fa-phone me-2 mt-1"></i>
        <p class="mb-0">${phone}</p>
      </div>
  ` : '';

const addressHTML = address ? `
	    <div class="d-flex align-items-start mt-3 mb-2">
        <i class="fas fa-map-marker-alt me-2 mt-1"></i>
        <p class="mb-0">${address}</p>
      </div>
  ` : '';

const gpsHTML = gps ? `
	   <div class="d-flex align-items-start mb-2">
        <i class="fas fa-location-arrow me-2 mt-1"></i>
        <p class="mb-0">${gps}</p>
      </div>
  ` : '';

const html = `
    <div class="mb-3 text-center">
      <img src="${imageSrc}" alt="Organizational Unit" class="img-fluid w-100" style="max-height: 600px; object-fit: cover;" loading="lazy">
    </div>

    <div class="p-4">
      <h4 class="fw-bold">${title}</h4>

      <div class="ou-tag-bar text-white mb-3">
        <span class="ou-type">${
(type || '').toUpperCase()
}</span>
        <!--<span class="ou-campus">${campus}</span>-->
      </div>

      <div class="mt-3">${description}</div>
	  <br>

      ${webHTML}
      ${emailHTML}
      ${phoneHTML}
      ${addressHTML}
      ${gpsHTML}

      <div class="mt-5 text-center">
        <a class="btn btn-dark see-more-ou-button" href="${url}">{{ translations[current_language]['See more'] }}</a>
      </div>
	 
    </div>
  `;

document.getElementById('ou-details').innerHTML = html;
}


/* ==========================================================
   FILTERS + SEARCH (refactor)
   ========================================================== */

let currentCampus = '';
let currentType = '';
let currentArea = '';

const campusButton = document.getElementById('campus-filter-button');
const typeButton = document.getElementById('type-filter-button');
const areaButton = document.getElementById('area-filter-button');
const searchInput = document.getElementById('ou-search');

/** Helper: update button label and color based on active state */
function setButton(buttonEl, hasValue, selectedLabel, defaultLabel) {
const active = !! hasValue;
buttonEl.textContent = active ? (selectedLabel || '').trim() : defaultLabel;

// Aplicar color dinámico si está activo
if (active) {
buttonEl.style.backgroundColor = getComputedStyle(document.documentElement).getPropertyValue('--university_primary_color');
buttonEl.style.color = '#fff';
buttonEl.style.borderColor = getComputedStyle(document.documentElement).getPropertyValue('--university_primary_color');
} else {
buttonEl.style.backgroundColor = '';
buttonEl.style.color = '';
buttonEl.style.borderColor = '';
}
}

/** Apply combined filters (text + type + area + campus) */
function filterOUList() {
const query = (searchInput ?. value || '').toLowerCase();
const items = document.querySelectorAll('#ou-list .ou-item');

items.forEach(item => {
const title = item.dataset.ouTitle ?. toLowerCase() || '';
const type = item.dataset.ouType ?. toLowerCase() || '';
const area = item.dataset.ouArea ?. toLowerCase() || '';
const campus = item.dataset.ouCampusId || '';

const matchText = ! query || title.includes(query) || type.includes(query);
const matchType = ! currentType || type === currentType.toLowerCase();
const matchArea = ! currentArea || area === currentArea.toLowerCase();
const matchCampus = ! currentCampus || campus === currentCampus;

item.style.display = (matchText && matchType && matchArea && matchCampus) ? '' : 'none';
});
}

/* ----- Dropdown handlers (Campus / Type / Area) ----- */
document.querySelectorAll('#filter-campus .dropdown-item').forEach(item => {
item.addEventListener('click', function (e) {
e.preventDefault();
currentCampus = this.dataset.campus || '';
setButton(campusButton, currentCampus, this.textContent, 'Campus');
filterOUList();
});
});

document.querySelectorAll('#filter-type .dropdown-item').forEach(item => {
item.addEventListener('click', function (e) {
e.preventDefault();
currentType = this.dataset.type || '';
setButton(typeButton, currentType, this.textContent, 'Type');
filterOUList();
});
});

document.querySelectorAll('#filter-area .dropdown-item').forEach(item => {
item.addEventListener('click', function (e) {
e.preventDefault();
currentArea = this.dataset.area || '';
setButton(areaButton, currentArea, this.textContent, 'Knowledge Area');
filterOUList();
});
});

/* ----- Live search (single listener) ----- */
searchInput.addEventListener('input', filterOUList);

/* ----- Initial visual state for buttons ----- */
setButton(campusButton, '', '', 'Campus');
setButton(typeButton, '', '', 'Type');
setButton(areaButton, '', '', 'Knowledge Area');

/* ==========================================================
   SIMPLE PAGINATION (unchanged)
   ========================================================== */
document.addEventListener('DOMContentLoaded', function () {
const items = document.querySelectorAll('#ou-list .ou-item');
const itemsPerPage = 7;
let currentPage = 1;

function showPage(page) {
const start = (page - 1) * itemsPerPage;
const end = page * itemsPerPage;

items.forEach((item, index) => {
item.style.display = (index >= start && index < end) ? '' : 'none';
});

renderPagination(page);
}

function renderPagination(activePage) {
const totalPages = Math.ceil(items.length / itemsPerPage) || 1;
const pagination = document.getElementById('pagination-controls');
if (! pagination) 
return;



pagination.innerHTML = '';

for (let i = 1; i <= totalPages; i++) {
const li = document.createElement('li');
li.className = 'page-item' + (
i === activePage ? ' active' : ''
);
li.innerHTML = `<a class="page-link" href="#">${i}</a>`;
li.addEventListener('click', function (e) {
e.preventDefault();
currentPage = i;
showPage(currentPage);
});
pagination.appendChild(li);
}
}

if (items.length > 0) {
showPage(currentPage);
}
});</script>
