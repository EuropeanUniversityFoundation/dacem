{% if institution.field_general_campus_description is not empty  %}


	<div class='section-container section-bg-grey' id="campuses" style="scroll-margin-top: 150px;">

		<div class="my-custom-container-2">


			<div class="row mb-4">
				<div class="col-12">
					<h2 class="section-title text-center">Campuses</h2>


					{% if institution.field_general_campus_description is not empty  %}
						<p>
							{{institution.field_general_campus_description.value | raw}}
						</p>
					{% endif %}
				</div>
			</div>

			{% if campuses is not empty %}

			<!-- Contenido: Mapa + Tarjetas -->
			<div
				class="row">
				<!-- Mapa -->
				<div class="col-lg-7 col-12 mb-4 mb-lg-0">
					<div class="map-wrapper">

						{{ drupal_block('views_block:map_view-block_2') }}
					</div>

				</div>

				<!-- Tarjetas -->
				<div class="col-lg-5 col-12">

					<div style="max-height: 500px; overflow-y: auto;">
						{% for campus in campuses %}
							{% set campus_path = path('entity.node.canonical', {'node': campus.id}) %}
							{% set parts = campus_path|trim('/')|split('/') %}


							{# Últimos 2 segmentos son institution y campus #}
							{% set campus_alias = parts|last %}
							{% set institution_alias = parts[parts|length - 2] %}

							<a href="{{ path('view.campus_information.page_1', { 'arg_0': institution_alias, 'arg_1': campus_alias }) }}" class="text-decoration-none text-reset">

								<div class="card shadow-none mb-3 border-0 rounded-0" style="height: 123.65px; cursor: pointer;">
									<div
										class="row g-0">
										<!-- Imagen -->
										<div class="col-3" style="height: 123.65px">
											{% if campus.field_campus_picture is not empty %}
												<img src="{{ file_url(campus.field_campus_picture.entity.fileuri) }}" alt="{{ campus.title.value }}" class="img-fluid rounded-0 h-100 object-fit-cover">
											{% endif %}
										</div>

										<!-- Texto -->
										<div class="col-9">
											<div class="card-body p-2">
												<h5 class="card-title mb-1 text-start">{{ campus.title.value }}</h5>
												{% if campus.field_campus_location is not empty %}
													<p class="mb-1 text-muted small text-start">{{ campus.field_campus_location.value }}</p>
												{% endif %}
											</div>
										</div>
									</div>
								</div>
							</a>
						{% endfor %}
					</div>


				</div>

			</div>

			{% endif %}

		</div>
	{% endif %}


</div></div>{% if  not (view.result|length == 1 and view.result[0]._relationship_entities['reverse__node__field_ou_institution'] is null) %}
