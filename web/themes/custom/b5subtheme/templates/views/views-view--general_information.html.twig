				<h3 style="font-weight: bold;">DESCRIPTION</h3>
				<p>{{ institution.field_admission_description.value | raw}}</p>
			{% endif %}

			<!-- Main Requirements -->
			{% if institution.field_main_requirements is not empty %}
				<h3 style="font-weight: bold;">MAIN REQUIREMENTS</h3>
				<p>{{ institution.field_main_requirements.value }}</p>
			{% endif %}

			<!-- Language Policy -->
			{% if institution.field_admission_language_policy is not empty %}
				<h3 style="font-weight: bold;">LANGUAGE POLICY</h3>
				<p>{{ institution.field_admission_language_policy.value | raw}}</p>

				<!-- Subapartado: Languages -->
				{% if institution.field_admission_languages is not empty %}
					<h4 style="font-weight: bold; margin-left: 20px;">LANGUAGES</h4>
					<ul style="margin-left: 20px;">
						{% for language in institution.field_admission_languages %}
							<li>{{ language.value }}</li>
						{% endfor %}
					</ul>
				{% endif %}

			{% endif %}

			<!-- Registration Procedures -->
			{% if institution.field_admission_registration is not empty %}
				<h3 style="font-weight: bold;">REGISTRATION PROCEDURES</h3>
				<p>{{ institution.field_admission_registration.value | raw}}</p>
			{% endif %}
		</div>
