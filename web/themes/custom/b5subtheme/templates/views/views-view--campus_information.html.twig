let currentCampus = '';

document.querySelectorAll('#filter-campus .dropdown-item').forEach(item => {
item.addEventListener('click', function (e) {
e.preventDefault();
currentCampus = this.dataset.campus;
document.getElementById('campus-filter-button').textContent = currentCampus ? `Campus: ${
this.textContent
}` : 'Campus';
filterOUList();
});
});


// 🔍 Buscador en tiempo real
document.getElementById('ou-search').addEventListener('input', function () {
const query = this.value.toLowerCase();
const items = document.querySelectorAll('#ou-list .ou-item');

items.forEach(item => {
const title = item.dataset.ouTitle ?. toLowerCase() || '';
const type = item.dataset.ouType ?. toLowerCase() || '';

if (title.includes(query) || type.includes(query)) {
item.style.display = '';
} else {
item.style.display = 'none';
}
});
});


let currentType = '';
let currentArea = '';
// Cambiar texto del botón TYPE
const typeButton = document.getElementById('type-filter-button');
const areaButton = document.getElementById('area-filter-button');

document.querySelectorAll('#filter-type .dropdown-item').forEach(item => {
item.addEventListener('click', function (e) {
e.preventDefault();
currentType = this.dataset.type;
typeButton.textContent = currentType ? `Type: ${
this.textContent
}` : 'Type';
filterOUList();
});
});

document.querySelectorAll('#filter-area .dropdown-item').forEach(item => {
item.addEventListener('click', function (e) {
e.preventDefault();
currentArea = this.dataset.area;
areaButton.textContent = currentArea ? `Knowledge Area: ${
this.textContent
}` : 'Knowledge Area';
filterOUList();
});
});


// Filtro general (combina búsqueda + tipo + área)
function filterOUList() {
const query = document.getElementById('ou-search').value.toLowerCase();
const items = document.querySelectorAll('#ou-list .ou-item');

items.forEach(item => {
const title = item.dataset.ouTitle ?. toLowerCase() || '';
const type = item.dataset.ouType ?. toLowerCase() || '';
const area = item.dataset.ouArea ?. toLowerCase() || '';
const campus = item.dataset.ouCampusId || '';
console.log(campus);

const matchText = title.includes(query);
const matchType = ! currentType || type === currentType.toLowerCase();
const matchArea = ! currentArea || area === currentArea.toLowerCase();
const matchCampus = ! currentCampus || campus === currentCampus;


if (matchText && matchType && matchArea && matchCampus) {
item.style.display = '';
} else {
item.style.display = 'none';
}
});
}


// Búsqueda con combinación de filtros
document.getElementById('ou-search').addEventListener('input', filterOUList);


document.addEventListener("DOMContentLoaded", function () {
const items = document.querySelectorAll("#ou-list .ou-item");
const itemsPerPage = 2;
let currentPage = 1;

function showPage(page) {
const start = (page - 1) * itemsPerPage;
const end = page * itemsPerPage;

items.forEach((item, index) => {
item.style.display = (index >= start && index < end) ? '' : 'none';
});

renderPagination(page);
}

function renderPagination(activePage) {
const totalPages = Math.ceil(items.length / itemsPerPage);
const pagination = document.getElementById("pagination-controls");
pagination.innerHTML = '';

for (let i = 1; i <= totalPages; i++) {
const li = document.createElement("li");
li.className = "page-item" + (
i === activePage ? " active" : ""
);
li.innerHTML = `<a class="page-link" href="#">${i}</a>`;
li.addEventListener("click", function (e) {
e.preventDefault();
currentPage = i;
showPage(currentPage);
});
pagination.appendChild(li);
}
}

if (items.length > 0) {
showPage(currentPage);
}
});</script>




<script>

(function () {
  const $ = (sel, ctx=document) => ctx.querySelector(sel);
  const $$ = (sel, ctx=document) => Array.from(ctx.querySelectorAll(sel));

  const input   = $('#programmeSearch');
  const btn     = $('#programmeSearchBtn');
  const menuArea  = $('#filter-programme-area');
  const btnArea   = $('#programme-area-filter-button');
  const menuLevel = $('#filter-level');
  const btnLevel  = $('#level-filter-button');
  const btnAZ   = document.querySelector('.btn.btn-danger.btn-sm');

  const norm = s => (s||'').toString().trim().toLowerCase()
    .normalize('NFD').replace(/[\u0300-\u036f]/g,'');
  const slug = s => norm(s).replace(/[^a-z0-9]+/g,'_').replace(/^_+|_+$/g,'');

  const state = { q:'', area:'', level:'', az:false };

  const groups = [];
  document.querySelectorAll('h5.text-uppercase.fw-bold.mt-5.mb-3').forEach(h5 => {
    const row = h5.nextElementSibling;
    if (row && row.classList.contains('row')) groups.push({h5,row});
  });

  function cardMatches(card) {
    const name  = norm(card.dataset.name);
    const area  = slug(card.dataset.programmeArea || '');
    const level = slug(card.dataset.level || '');

    const okQ = !state.q
      || name.includes(state.q)
      || slug(card.dataset.programmeArea || '').includes(state.q)
      || slug(card.dataset.level || '').includes(state.q);

    const okArea  = !state.area || area === state.area;
    const okLevel = !state.level || level === state.level;
    return okQ && okArea && okLevel;
  }

  function applyFilter() {
    const cards = $$('.programme-card');
    cards.forEach(card => {
      const show = cardMatches(card);
      card.closest('.col').style.display = show ? '' : 'none';
    });
    groups.forEach(({h5,row}) => {
      const visible = row.querySelectorAll(':scope > .col:not([style*="display: none"])').length > 0;
      h5.style.display  = visible ? '' : 'none';
      row.style.display = visible ? '' : 'none';
    });
    if (state.az) sortAZ();
  }

  function sortAZ() {
    groups.forEach(({row}) => {
      const visibles = $$('.col', row).filter(c => c.style.display !== 'none');
      visibles.sort((a,b) => {
        const na = norm(a.querySelector('.programme-card').dataset.name);
        const nb = norm(b.querySelector('.programme-card').dataset.name);
        return na.localeCompare(nb);
      });
      visibles.forEach(col => row.appendChild(col));
    });
  }

  let t;
  input.addEventListener('input', () => { clearTimeout(t); t = setTimeout(() => { state.q = norm(input.value); applyFilter(); }, 120); });
  btn.addEventListener('click', e => { e.preventDefault(); state.q = norm(input.value); applyFilter(); });

  menuArea.addEventListener('click', e => {
    const a = e.target.closest('a[data-programme-area]');
    if (!a) return;
    e.preventDefault();
    state.area = a.dataset.programmeArea ? slug(a.dataset.programmeArea) : '';
    btnArea.textContent = state.area ? a.textContent.trim() : 'Knowledge Area';
    applyFilter();
  });

  menuLevel.addEventListener('click', e => {
    const a = e.target.closest('a[data-type]');
    if (!a) return;
    e.preventDefault();
    state.level = a.dataset.type ? slug(a.dataset.type) : '';
    btnLevel.textContent = state.level ? a.textContent.trim() : 'Level';
    applyFilter();
  });

  if (btnAZ) {
    btnAZ.addEventListener('click', e => {
      e.preventDefault();
      state.az = !state.az;
      btnAZ.classList.toggle('btn-outline-danger', state.az);
      btnAZ.classList.toggle('btn-danger', !state.az);
      if (state.az) sortAZ();
    });
  }
})();

</script>



<script>
(function () {
  // Congela el scroll cuando se muestra/oculta un panel de acordeón
  const keepScroll = () => {
    const y = window.scrollY;
    // reestablece inmediatamente (sin animación)
    window.requestAnimationFrame(() => window.scrollTo(0, y));
  };

  // Escucha eventos de Bootstrap 5
  document.querySelectorAll('.accordion .collapse').forEach(el => {
    el.addEventListener('shown.bs.collapse', keepScroll);
    el.addEventListener('hidden.bs.collapse', keepScroll);
  });

  // Por si algún trigger es <a href="#…">, anula el salto
  document.querySelectorAll('.accordion [data-bs-toggle="collapse"]').forEach(tr => {
    if (tr.tagName === 'A') {
      tr.addEventListener('click', e => e.preventDefault());
    }
  });
})();
</script>
