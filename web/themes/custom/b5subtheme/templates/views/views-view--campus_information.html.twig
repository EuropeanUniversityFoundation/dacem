                            <span class="text-muted ms-2">{{ p.ects }} ECTS</span>
                          {% endif %}
                        </li>
                      {% endfor %}
                    </ul>
                  </div>
                {% endif %}
              {% endfor %}
            </div>

          </div>
        </div>
      </div>
    {% endif %}
  {% endfor %}
</div>
{% endif %}
