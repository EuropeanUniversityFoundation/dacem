						{% endif %}
					{% else %}
						{{ lc_value|raw }}
					{% endif %}
				</div>
			</div>
		</div>
	{% endif %}

	{# ===== 5) Events and culture ===== #}
	{% set ec_rendered = rs_fallback_data.field_cultural_event_city_calend.rendered ?? '' %}
	{% set ec_source   = rs_fallback_data.field_cultural_event_city_calend.source   ?? '' %}
