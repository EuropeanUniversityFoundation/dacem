<div class="rs-campuses-section">
    {% if campuses %}
        <h3 class="text-center">CAMPUS</h3> <!-- 🔹 Título centrado -->
        
        <div class="container"> <!-- 🔹 Contenedor para limitar el ancho -->
            <div class="row row-cols-1 row-cols-md-3 g-4 mt-4 justify-content-center">
                {% for campus in campuses %}
                    <div class="col">
                        <div class="card h-100 shadow-sm">
                            <!-- Nombre del Campus -->
                            <div class="card-header text-center">
                                <h5 class="card-title fw-bold">{{ campus.label }}</h5>
                            </div>

                            <!-- Imagen del Campus -->
                            {% if campus.field_campus_picture is not empty %}
                                {% set media_entity = campus.field_campus_picture.entity %}
                                {% if media_entity is not empty %}
                                    {% set file_entity = media_entity.field_media_image.entity %}
                                    {% if file_entity is not empty %}
                                        <img src="{{ file_url(file_entity.uri.value) }}" class="card-img-right img-fluid" alt="{{ campus.title.value }}">
                                    {% endif %}
                                {% endif %}
                            {% endif %}

                            <div class="card-body">
                                <!-- Descripción del Campus -->
                                {% if campus.field_campus_description %}
                                    <p class="card-text">{{ campus.field_campus_description.value|striptags }}</p>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}
</div>





















<div class="col-lg-9 col-md-12 col-sm-12">

	<div id="student-affairs" class="mb-5">
		<h3>STUDENT AFFAIRS</h3>
		{% if rs.field_rs_students_affairs_office.value is not empty %}
			<div class="rs-section" id="students-affairs-office" style="text-align: justify;">
