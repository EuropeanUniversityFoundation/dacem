{% set current_language = view.result[0].node_field_data_langcode %}


{% set rs = view.result[0]._entity %}
{% if rs.hasTranslation(current_language) %}
	{% set rs = rs.getTranslation(current_language) %}
{% else %}
	{% set rs = rs %}
{% endif %}


{% set university = view.result[0]._relationship_entities.field_rs_institution %}
{#{dump(view.result[0])}#}


{% set university_primary_color = university.field_primary_color[0].color %}
{% set university_text_color = university.field_text_color[0].color %}
{% set university_emphasis_text_color = university.field_emphasis_text_color[0].color %}


{% set menu_titles = {
  'student_affairs': 'Student affairs',
  'students_mobility': 'Students mobility',
  'facilities': 'Facilities',
  'university_life': 'University life',
  'extra_academic_activities': 'Extra-academic activites'
} %}


<style>:root
{
	--university_primary_color: {{university_primary_color}}
	;
	--university_text_color: {{university_text_color}}
	;
	--university_emphasis_text_color: {{university_emphasis_text_color}}
	;
}</style><div class="sticky-nav">

<div class="rs-header">
	<div class="container-fluid container-fluid-programme-band ">
		<h1 class="programme-title">RESOURCES AND SERVICES</h1>
	</div>
</div>


<nav id="rs-navbar" class="rs-nav navbar navbar-expand-lg bg-white">
	<div
		class="my-custom-constainer">
		<!-- Menú desplegable para pantallas pequeñas -->
		<div class="dropdown d-lg-none w-100">
			<button id="rsDropdownButton" class="btn btn-secondary dropdown-toggle w-100 fw-bold" type="button" data-bs-toggle="dropdown" aria-expanded="false">
				{{ 'Student affairs'|t }}
			</button>
			<ul class="dropdown-menu w-100 text-center" aria-labelledby="rsDropdownButton">
				<li>
					<a class="dropdown-item fw-bold" href="#student-affairs">{{ 'Student affairs'|t }}</a>
				</li>
				<li>
					<a class="dropdown-item fw-bold" href="#students-mobility">{{ 'Students mobility'|t }}</a>
				</li>
				<li>
					<a class="dropdown-item fw-bold" href="#facilities">{{ 'Facilities'|t }}</a>
				</li>
				<li>
					<a class="dropdown-item fw-bold" href="#university-life">{{ 'University life'|t }}</a>
				</li>
				<li>
					<a class="dropdown-item fw-bold" href="#extra-academic-activities">{{ 'Extra-academic activities'|t }}</a>
				</li>
			</ul>
		</div>

		<!-- Menú de pestañas visible en pantallas grandes -->
		<ul class="nav nav-tabs justify-content-center d-none d-lg-flex">
			<li class="nav-item">
				<a class="nav-link mx-2 fw-bold" href="#student-affairs">{{ menu_titles.student_affairs }}</a>
			</li>
			<li class="nav-item">
				<a class="nav-link mx-2 fw-bold" href="#students-mobility">{{ menu_titles.students_mobility }}</a>
			</li>
			<li class="nav-item">
				<a class="nav-link mx-2 fw-bold" href="#facilities">{{ menu_titles.facilities }}</a>
			</li>
			<li class="nav-item">
				<a class="nav-link mx-2 fw-bold" href="#university-life">{{ menu_titles.university_life }}</a>
			</li>
			<li class="nav-item">
				<a class="nav-link mx-2 fw-bold" href="#extra-academic-activities">{{ menu_titles.extra_academic_activities }}</a>
			</li>
		</ul>
	</div>
</nav></div><div>


<div class="rs-campuses-section">
	{% if campuses %}
		<h3 class="text-center">CAMPUS</h3>
		<!-- 🔹 Título centrado -->

		<div
			class="container">
			<!-- 🔹 Contenedor para limitar el ancho -->
			<div class="row row-cols-1 row-cols-md-3 g-4 mt-4 justify-content-center">
				{% for campus in campuses %}
					<div class="col">
						<div
							class="card h-100 shadow-sm">
							<!-- Nombre del Campus -->
							<div class="card-header text-center">
								<h5 class="card-title fw-bold">{{ campus.label }}</h5>
							</div>

							<!-- Imagen del Campus -->
							{% if campus.field_campus_picture is not empty %}
								{% set media_entity = campus.field_campus_picture.entity %}
								{% if media_entity is not empty %}
									{% set file_entity = media_entity.field_media_image.entity %}
									{% if file_entity is not empty %}
										<img src="{{ file_url(file_entity.uri.value) }}" class="card-img-right img-fluid" alt="{{ campus.title.value }}">
									{% endif %}
								{% endif %}
							{% endif %}

							<div
								class="card-body">
								<!-- Descripción del Campus -->
								{% if campus.field_campus_description %}
									<p class="card-text">{{ campus.field_campus_description.value|striptags }}</p>
								{% endif %}
							</div>
						</div>
					</div>
				{% endfor %}
			</div>
		</div>
	{% endif %}
</div>




<div class="students-affairs-section">

	<div class="image-banner">
		<img src="/themes/custom/b5subtheme/images/university_life.jpg" alt="Descripción de la imagen" class="img-fluid"></div>

	<div class="my-custom-container">
		<div class="row mb-5">
			{% if rs.field_rs_students_affairs_office.value is not empty %}
				<div class="col-12">

					<h2>Students Affairs Office</h2>
					<div class="facility-text">
						{{ rs.field_rs_students_affairs_office.value|raw }}
					</div>

				</div>
			{% endif %}
		</div>


		<div class="row">
			{% if rs.field_financial_support_for_stud.value is not empty %}
				<div class="col-md-6 mb-4">

					<h2>Financial Support for Students</h2>
					<div class="facility-text">
						{{ rs.field_financial_support_for_stud.value|raw }}
					</div>

				</div>
			{% endif %}

			{% if rs.field_rs_insurance.value is not empty %}
				<div class="col-md-6 mb-4">

					<h2>Insurance</h2>
					<div class="facility-text">
						{{ rs.field_rs_insurance.value|raw }}
					</div>

				</div>
			{% endif %}


		</div>
	</div>
</div>












<div class="col-lg-12 col-md-12 col-sm-12">


	<div id="facilities" class="facilities-section mb-5">
	<div class="image-banner">
		<img src="/themes/custom/b5subtheme/images/facilities.jpg" alt="Descripción de la imagen" class="img-fluid"></div>
		<div class="my-custom-container">
			<h3>FACILITIES</h3>

			<div class="row mb-4">
				{% if rs.field_rs_medical_facilities.value is not empty %}
					<div class="col-md-6 mb-4">
						<div class="facility-box">
							<div class="facility-icon">
								<i class="fas fa-hospital-alt"></i>
							</div>
							<h4>Medical Facilities</h4>
							<div class="facility-text">
								{{ rs.field_rs_medical_facilities.value|raw }}
							</div>
						</div>
					</div>
				{% endif %}

				{% if rs.field_rs_learning_facilities.value is not empty %}
					<div class="col-md-6 mb-4">
						<div class="facility-box">
							<div class="facility-icon">
								<i class="fas fa-graduation-cap"></i>
							</div>
							<h4>Learning Facilities</h4>
							<div class="facility-text">
								{{ rs.field_rs_learning_facilities.value|raw }}
							</div>
						</div>
					</div>
				{% endif %}
			</div>

			<div class="row">
				{% if rs.field_sport_and_leisure_faciliti.value is not empty %}
					<div class="col-md-6 mb-4">
						<div class="facility-box">
							<div class="facility-icon">
								<i class="fas fa-dumbbell"></i>
							</div>
							<h4>Sport and Leisure Facilities</h4>
							<div class="facility-text">
								{{ rs.field_sport_and_leisure_faciliti.value|raw }}
							</div>
						</div>
					</div>
				{% endif %}

				{% if rs.field_rs_special_facilities.value is not empty %}
					<div class="col-md-6 mb-4">
						<div class="facility-box">
							<div class="facility-icon">
								<i class="fas fa-star"></i>
							</div>
							<h4>Special Facilities</h4>
							<div class="facility-text">
								{{ rs.field_rs_special_facilities.value|raw }}
							</div>
						</div>
					</div>
				{% endif %}
			</div>

		</div>
	</div>


</div>


