<div class="collapse bg-dark text-white container-campuses-rs" id="campusCollapse">

	{% if campuses %}


		<div class="d-flex flex-wrap gap-3 justify-content-center campuses-row-rs">


			<a href="{{ university.custom_url }}" class="campus-card-rs d-flex align-items-center text-decoration-none">

				{% if university.field_logo is not empty %}
					{% set media_entity = university.field_logo.entity %}
					{% if media_entity is not empty %}
						{% set file_entity = media_entity.field_media_image.entity %}
						{% if file_entity is not empty %}
							<img src="{{ file_url(file_entity.uri.value) }}" alt="{{ university.label }}" class="campus-card-rs-img">
						{% endif %}
					{% endif %}
				{% endif %}

				<div class="d-flex campus-card-rs-name align-items-center justify-content-center px-3 py-2
																																						          {% if is_university %} bg-danger text-white {% else %} bg-secondary text-white {% endif %}">
					<h5>{{ university.label }}</h5>
				</div>
			</a>


			{% for campus in campuses %}
				{% set is_university = campus.label == 'University' %}

				<a href="{{ campus.custom_url }}" class="campus-card-rs d-flex align-items-center text-decoration-none">

					{% if campus.field_campus_picture is not empty %}
						{% set media_entity = campus.field_campus_picture.entity %}
						{% if media_entity is not empty %}
							{% set file_entity = media_entity.field_media_image.entity %}
							{% if file_entity is not empty %}
								<img src="{{ file_url(file_entity.uri.value) }}" alt="{{ campus.label }}" class="campus-card-rs-img">
							{% endif %}
						{% endif %}
					{% endif %}

					<div class="d-flex campus-card-rs-name align-items-center justify-content-center px-3 py-2
																																										          {% if is_university %} bg-danger text-white {% else %} bg-secondary text-white {% endif %}">
						<h5>{{ campus.label }}</h5>
					</div>
				</a>
			{% endfor %}
		</div>


	{% endif %}
</div>
{% if rs_campus_title %}
	<div class="rs-campus-title d-flex justify-content-center my-4">
		<h1 class="text-center">{{ rs_campus_title }}</h1>
	</div>
{% endif %}


<div class="rs-section students-affairs-section" id="student-affairs">


	<div class="my-custom-container-2">
		<div class="row mb-5">
			{% if rs_mode == 'campus' %}
				{% if rs_fallback_data.field_rs_students_affairs_office.rendered %}
					<div class="col-12">
						<h2>Students Affairs Office</h2>
						<div class="facility-text">
							{{ rs_fallback_data.field_rs_students_affairs_office.rendered|raw }}
							{% if rs_fallback_data.field_rs_students_affairs_office.source == 'institution' %}
								<small class="text-muted">* Information provided by the institution</small>
							{% else %}
								<small class="text-muted">* Only for this campus</small>
							{% endif %}
						</div>
					</div>
				{% endif %}
			{% else %}

				{% if rs.field_rs_students_affairs_office.value is not empty %}


					<div class="col-12">
						<h2>Students Affairs Office</h2>
						<div class="facility-text">
							{{ rs.field_rs_students_affairs_office.value|raw }}
						</div>
					</div>
				{% endif %}
			{% endif %}
		</div>

		<div class="row">
			{% if rs_mode == 'campus' %}
				{% if rs_fallback_data.field_financial_support_for_stud.rendered %}
					<div class="col-md-6 mb-4">
						<h2>Financial Support for Students</h2>
						<div class="facility-text">
							{{ rs_fallback_data.field_financial_support_for_stud.rendered|raw }}
							{% if rs_fallback_data.field_financial_support_for_stud.source == 'institution' %}
								<small class="text-muted">* Information provided by the institution</small>
							{% else %}
								<small class="text-muted">* Only for this campus</small>
							{% endif %}
						</div>
					</div>
				{% endif %}

				{% if rs_fallback_data.field_rs_insurance.rendered %}
					<div class="col-md-6 mb-4">
						<h2>Insurance</h2>
						<div class="facility-text">
							{{ rs_fallback_data.field_rs_insurance.rendered|raw }}
							{% if rs_fallback_data.field_rs_insurance.source == 'institution' %}
								<small class="text-muted">* Information provided by the institution</small>
							{% else %}
								<small class="text-muted">* Only for this campus</small>
							{% endif %}
						</div>
					</div>
				{% endif %}
			{% else %}
				{% if rs.field_financial_support_for_stud.value is not empty %}
					<div class="col-md-6 mb-4">
						<h2>Financial Support for Students</h2>
						<div class="facility-text">
							{{ rs.field_financial_support_for_stud.value|raw }}
						</div>
					</div>
				{% endif %}

				{% if rs.field_rs_insurance.value is not empty %}
					<div class="col-md-6 mb-4">
						<h2>Insurance</h2>
						<div class="facility-text">
							{{ rs.field_rs_insurance.value|raw }}
						</div>
					</div>
				{% endif %}
			{% endif %}
		</div>
	</div>

</div>

