				<h1 class="section-title">Sport clubs/programs</h1>
				<div class="facility-text">
					{% if rs_mode == 'campus' %}
						{{ sp_rendered|raw }}
						{% if sp_source == 'institution' %}
							<small class="text-muted">* For the whole institution</small>
						{% endif %}
					{% else %}
						{{ sp_value|raw }}
					{% endif %}
				</div>
			</div>
		</div>
	{% endif %}

