	<script>
		(function () {
const norm = s => (s || '').toString().trim();

const searchInput = document.getElementById('programme-search');
const searchBtn = document.getElementById('search-btn');
if (! searchInput) 
return;


const wrapper = document.querySelector('[data-view-dom-id]');
if (! wrapper) 
return;

const form = wrapper.querySelector('form[id^="views-exposed-form-"]');
if (! form) 
return;


function resetPageParam() {
let pageField = form.querySelector('input[name="page"]');
if (! pageField) {
pageField = document.createElement('input');
pageField.type = 'hidden';
pageField.name = 'page';
form.appendChild(pageField);
}
pageField.value = 0;
}

function submitSearch() {
const val = norm(searchInput.value);

// 1) Pon el valor en TODOS los combine existentes
form.querySelectorAll('input[name="combine"]').forEach(el => {
el.value = val;
});

// 2) Inyecta un hidden al FINAL del form (último gana en la querystring)
let injected = form.querySelector('input[name="combine"][data-injected="1"]');
if (! injected) {
injected = document.createElement('input');
injected.type = 'hidden';
injected.name = 'combine';
injected.setAttribute('data-injected', '1');
form.appendChild(injected); // al final
}injected.value = val;

resetPageParam();
form.submit();
}

// Mantén sincronizado si ya había valor del exposed al cargar
const firstCombine = wrapper.querySelector('input[name="combine"]');
if (firstCombine && ! searchInput.value) 
searchInput.value = firstCombine.value || '';


searchInput.addEventListener('keydown', (e) => {
if (e.key === 'Enter') {
e.preventDefault();
submitSearch();
}
});
if (searchBtn) 
searchBtn.addEventListener('click', (e) => {
e.preventDefault();
submitSearch();
});

})();
	</script>



<script>
		(function () {
function replaceLastPathSegment(pathname, newSegment) { // Quita trailing slash salvo que sea "/"
const hasTrailingSlash = pathname.length > 1 && pathname.endsWith('/');
const clean = hasTrailingSlash ? pathname.slice(0, -1) : pathname;

const parts = clean.split('/').filter(Boolean); // sin vacíos
if (parts.length === 0) 
return '/' + newSegment;


parts[parts.length - 1] = newSegment;
return '/' + parts.join('/') + (hasTrailingSlash ? '/' : '');
}

document.querySelectorAll('.newcatalogue-btn[data-target-segment]').forEach((btn) => {
btn.addEventListener('click', (e) => {
e.preventDefault();

const target = btn.getAttribute('data-target-segment');
if (! target) 
return;


const {pathname, search, hash} = window.location;
const nextPath = replaceLastPathSegment(pathname, target);

// Mantiene ?query y #hash
window.location.href = nextPath + search + hash;
});
});
})();
	</script>
