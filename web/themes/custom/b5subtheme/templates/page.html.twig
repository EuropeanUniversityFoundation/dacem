{# themes/custom/b5subtheme/templates/page.html.twig #}


<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {{ attach_library('b5subtheme/global-styling') }}
  <title>{{ head_title|safe_join(' | ') }}</title>
</head>
<body>

  <header>
    {{ page.header }}
  </header>

  <main>
    {{ page.content }}
  </main>
<a href="#" class="back-to-top" title="Go to top">
  <i class="fas fa-arrow-up"></i>
</a>

  <footer>
  {#% include '@dacem_footer/dacem_footer_block.html.twig' %#}
  {{page.footer}}
  </footer>

</body>
</html>
