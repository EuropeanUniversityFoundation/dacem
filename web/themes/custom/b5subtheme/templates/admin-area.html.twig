<h1>{{ title }}</h1>




<!-- EN CASO DE SER UNIVERSITY ADMIN -->
{% if data.role == 'universitytypegroup-university_a' %}
	<div class="d-flex align-items-center">
		<h2 class="me-3 mb-0">
			<a class='h1' href="{{ data.university.link }}">{{ data.university.title }}</a>
		</h2>
		<a href="{{ data.university.edit_link }}" class="btn btn-primary">Edit University</a>
	</div>


	{% for degree in data.degrees %}
		<table
			class="table table-bordered mt-4">
			<!-- Primera fila: nombre de la degree -->
			<thead class="table-my-area">
				<tr>

					<th class="table-my-area" colspan="2">
						<a class='h3' href="{{ degree.link }}">{{ degree.title }}</a>
						<a href="{{ degree.edit_link }}" class="btn btn-secondary btn-sm">Edit</a>
						<a href="{{ degree.delete_link }}" class="btn btn-danger btn-sm">Delete</a>
					</th>

				</tr>
				<!-- Segunda fila: encabezados para subjects y acciones -->
				<tr>
					<th class="table-my-area">Subject</th>
					<th class="table-my-area">Actions</th>
				</tr>
			</thead>
			<tbody>
				{% for subject in degree.subjects %}
					<tr>
						<td>
							<a href="{{ subject.link }}">{{ subject.title }}</a>
						</td>
						<td>
							<a href="{{ subject.edit_link }}" class="btn btn-secondary btn-sm">Edit</a>
							<a href="{{ subject.delete_link }}" class="btn btn-danger btn-sm">Delete</a>
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	{% endfor %}




  <!-- EN CASO DE SER DEGREE ADMIN -->
{% elseif data.role == 'universitytypegroup-degree_admin' %}
	<p>El valor es degree admin.</p>
  
  <div class="d-flex align-items-center">
		<h2 class="me-3 mb-0">
			<a class='h1' href="{{ data.university.link }}">{{ data.university.name }}</a>
		</h2>
	</div>

  

  {% for degree in data.degrees %}
		<table
			class="table table-bordered mt-4">
			<!-- Primera fila: nombre de la degree -->
			<thead class="table-my-area">
				<tr>

					<th class="table-my-area" colspan="2">
						<a class='h3' href="{{ degree.link }}">{{ degree.title }}</a>
						<a href="{{ degree.edit_link }}" class="btn btn-secondary btn-sm">Edit</a>
						<a href="{{ degree.delete_link }}" class="btn btn-danger btn-sm">Delete</a>
					</th>

				</tr>
				<!-- Segunda fila: encabezados para subjects y acciones -->
				<tr>
					<th class="table-my-area">Subject</th>
					<th class="table-my-area">Actions</th>
				</tr>
			</thead>
			<tbody>
				{% for subject in degree.subjects %}
					<tr>
						<td>
							<a href="{{ subject.link }}">{{ subject.title }}</a>
						</td>
						<td>
							<a href="{{ subject.edit_link }}" class="btn btn-secondary btn-sm">Edit</a>
							<a href="{{ subject.delete_link }}" class="btn btn-danger btn-sm">Delete</a>
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	{% endfor %}





{% elseif data.role == 'universitytypegroup-subject_admi' %}
	

  <div class="language-switcher">
  {{ block|raw }}
</div>
  
  <div class="d-flex align-items-center">
		<h2 class="me-3 mb-0">
			<a class='h1' href="{{ data.university.link }}">{{ data.university.name }}</a>
		</h2>
	</div>



  {% if data.subjects_by_degree is not empty %}
  {% for degree in data.subjects_by_degree %}
    <table class="table table-bordered mt-4">
      <thead style="background-color: #f8f9fa; color: #333;">
        <tr>
          <th colspan="2">
            <a class="h2" href="{{ degree.degree_link }}">{{ degree.degree_title }}</a>
          </th>
        </tr>
        <tr>
          <th>Subject</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for subject in degree.subjects %}
          <tr>
            <td>
              <a href="{{ subject.link }}">{{ subject.title }}</a>
            </td>
            <td>
              <a href="{{ subject.edit_link }}" class="btn btn-secondary btn-sm">Edit</a>
              <a href="{{ subject.delete_link }}" class="btn btn-danger btn-sm">Delete</a>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% endfor %}
{% else %}
  <p>No subjects found for this user.</p>
{% endif %}



{% endif %}


