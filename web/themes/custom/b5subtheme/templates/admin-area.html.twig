<h1>{{ title }}</h1>


<!-- ******************************* -->
<!-- EN CASO DE SER UNIVERSITY ADMIN -->
<!-- ******************************* -->
	{% if data.role == 'universitytypegroup-university_a' %}
		<div class="d-flex align-items-center mb-3 ms-3"> <h2 class="me-3 mb">
			<a class='h1' href="{{ data.university.link }}">{{ data.university.title }}</a>
		</h2>
		<a href="{{ data.university.edit_link }}" class="btn btn-primary">Edit University</a>
		
		<a href="{{ data.university.create_degree_link }}" class="btn btn-success btn-sm me-2">Create Degree</a>
		<a href="{{ data.university.translation_link }}" class="btn btn-warning btn-sm">Language</a>
	</div>

	<div class="degree-container-admin-area ms-3">
  <div class="d-flex justify-content-between align-items-center">
    <h3 class="mb-0">Users</h3>
    <div class="d-flex">

      <a href="{{ data.create_user_link }}" class="btn btn-success btn-sm me-2">Create User</a>
	  
      <button class="btn btn-link btn-sm toggle-users" data-bs-toggle="collapse" data-bs-target="#group-members" aria-expanded="false" aria-controls="group-members">
        Show Users
      </button>
    </div>
  </div>

  <div id="group-members" class="collapse mt-2">
    <table class="table table-bordered">
      <thead>
        <tr>
          <th>Name</th>
          <th>Role</th>
          <th>Entities</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for member in data.group_members %}
          <tr>
            <td>{{ member.name }}</td>
            <td>{{ member.roles|join(', ') }}</td>
            <td>
              {% if member.entities is not empty %}
                <ul class="list-unstyled">
                  {% for entity in member.entities %}
                    <li>
                      <a href="{{ entity.link }}">{{ entity.title }}</a>
                    </li>
                  {% endfor %}
                </ul>
              {% else %}
                <span>No associated entities</span>
              {% endif %}
            </td>
            <td>
              <a href="{{ member.edit_link }}" class="btn btn-secondary btn-sm">Edit</a>
              <a href="{{ member.delete_link }}" class="btn btn-danger btn-sm">Delete</a>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>





<hr>



<div class="degree-container-admin-area ms-3 ">
	{% for degree in data.degrees %}
		
			<div class="d-flex justify-content-between align-items-center">
				<div>
					<a class="h3" href="{{ degree.link }}">{{ degree.title }}</a>
				</div>
				<div>
					<a href="{{ degree.edit_link }}" class="btn btn-secondary btn-sm">Edit</a>
					<a href="{{ degree.translation_link }}" class="btn btn-warning btn-sm">Language</a>
					<a href="{{ degree.delete_link }}" class="btn btn-danger btn-sm">Delete</a>
					<a href="{{ degree.create_subject_link }}" class="btn btn-success btn-sm">Create Subject</a>
					<button class="btn btn-link btn-sm toggle-subjects" data-bs-toggle="collapse" data-bs-target="#subjects-{{ loop.index }}" aria-expanded="false" aria-controls="subjects-{{ loop.index }}">
						Show Subjects
					</button>
					
				</div>
			</div>
			<div id="subjects-{{ loop.index }}" class="collapse mt-2">
				<table class="table table-bordered">
					<thead>
						<tr>
							<th>Subject</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody>
						{% for subject in degree.subjects %}
							<tr>
								<td>
									<a href="{{ subject.link }}">{{ subject.title }}</a>
								</td>
								<td>
									<a href="{{ subject.edit_link }}" class="btn btn-secondary btn-sm">Edit</a>
									<a href="{{ subject.translation_link }}" class="btn btn-warning btn-sm">Language</a>
									<a href="{{ subject.delete_link }}" class="btn btn-danger btn-sm">Delete</a>
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		
		<hr>
	{% endfor %}
</div>

	<!-- ******************************* -->
	<!-- EN CASO DE SER DEGREE ADMIN -->
	<!-- ******************************* -->
{% elseif data.role == 'universitytypegroup-degree_admin' %}
	<div class="d-flex align-items-center mb-3">
		<h2 class="me-3 ms-3">
			<a class="h1" href="{{ data.university.link }}">{{ data.university.name }}</a>
		</h2>
	</div>

	{% for degree in data.degrees %}
		<div class="degree-container-admin-area ms-3">
			<div class="d-flex justify-content-between align-items-center">
				<div>
					<a class="h3" href="{{ degree.link }}">{{ degree.title }}</a>
				</div>
				<div>
					<a href="{{ degree.edit_link }}" class="btn btn-secondary btn-sm">Edit</a>
					<a href="{{ degree.translation_link }}" class="btn btn-warning btn-sm">Language</a>
					<a href="{{ degree.delete_link }}" class="btn btn-danger btn-sm">Delete</a>
					<a href="{{ degree.create_subject_link }}" class="btn btn-success btn-sm">Create Subject</a>
					<button class="btn btn-link btn-sm toggle-subjects" data-bs-toggle="collapse" data-bs-target="#subjects-degree-{{ loop.index }}" aria-expanded="false" aria-controls="subjects-degree-{{ loop.index }}">
						Show Subjects
					</button>
					
				</div>
			</div>
			<div id="subjects-degree-{{ loop.index }}" class="collapse mt-2">
				<table class="table table-bordered">
					<thead>
						<tr>
							<th>Subject</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody>
						{% for subject in degree.subjects %}
							<tr>
								<td>
									<a href="{{ subject.link }}">{{ subject.title }}</a>
								</td>
								<td>
									<a href="{{ subject.edit_link }}" class="btn btn-secondary btn-sm">Edit</a>
									<a href="{{ subject.translation_link }}" class="btn btn-warning btn-sm">Language</a>
									<a href="{{ subject.delete_link }}" class="btn btn-danger btn-sm">Delete</a>

								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>
		<hr>
	{% endfor %}


	<!-- ******************************* -->
	<!-- EN CASO DE SER SUBJECT ADMIN -->
	<!-- ******************************* -->
{% elseif data.role == 'universitytypegroup-subject_admi' %}

	<div class="language-switcher">
		{{ block|raw }}
	</div>

	<div class="d-flex align-items-center mb-0">
		<h2 class="me-3 ">
			<a class="h1" href="{{ data.university.link }}">{{ data.university.name }}</a>
		</h2>
	</div>

	{% if data.subjects_by_degree is not empty %}
		{% for degree_id, degree in data.subjects_by_degree %}
			<div class="degree-container-admin-area ms-3">
				<div class="d-flex justify-content-between align-items-center">
					<div>
						<a class="h3" href="{{ degree.degree_link }}">{{ degree.degree_title }}</a>
					</div>
					<div>
						<button class="btn btn-link btn-sm toggle-subjects" data-bs-toggle="collapse" data-bs-target="#subjects-degree-{{ loop.index }}" aria-expanded="false" aria-controls="subjects-degree-{{ loop.index }}">
							Show Subjects
						</button>
					</div>
				</div>
				<div id="subjects-degree-{{ loop.index }}" class="collapse mt-2">
					<table class="table table-bordered">
						<thead>
							<tr>
								<th>Subject</th>
								<th>Actions</th>
							</tr>
						</thead>
						<tbody>
							{% for subject in degree.subjects %}
								<tr>
									<td>
										<a href="{{ subject.link }}">{{ subject.title }}</a>
									</td>
									<td>
										<a href="{{ subject.edit_link }}" class="btn btn-secondary btn-sm">Edit</a>
										<a href="{{ subject.translation_link }}" class="btn btn-warning btn-sm">Language</a>
										<a href="{{ subject.delete_link }}" class="btn btn-danger btn-sm">Delete</a>

									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</div>
			<hr>
		{% endfor %}
	{% else %}
		<p>No subjects found for this user.</p>
	{% endif %}

{% endif %}
