{{ attach_library('b5subtheme/fontawesome') }}


{% if content['#view'].result|length > 0 %}


		<div class="section-container section-bg-grey">
		<div class='text-center my-custom-container-2  section-bg-grey' id='academic-authorities'>
			<h2 class="section-title">Academic Authorities</h2>

			<div class="authorities-grid">
				{% for row in content['#view'].result %}
					<div class="authority-item">
						{% set file_entity = row._entity.field_ac_photo.entity %}

						<div class="authority-photo">
						{% if file_entity and file_entity.uri %}
							<img
							src="{{ file_url(file_entity.uri.value) }}"
							alt="{{ row._entity.title.value|default('') }}"
							class="img-fluid"
							>
						{% else %}
							<img
							src="/themes/custom/b5subtheme/images/default-profile.jpg"
							alt="{{ row._entity.title.value|default('') }}"
							class="img-fluid"
							>
						{% endif %}
						</div>
						<div class="authority-info">
							<h4>{{ row._entity.title.value }}</h4>
							{% if row._entity.field_institution_role is not empty %}
								<p class="text-center">{{ row._entity.field_institution_role.value | upper}}</p>
							{% endif %}
							<div class="authority-icons mt-2">
								<a href="#" class="authority-icon me-3">
									<i class="fas fa-globe fa-lg"></i>
								</a>
								<a href="#" class="authority-icon me-3">
									<i class="fab fa-instagram fa-lg"></i>
								</a>
								<a href="#" class="authority-icon">
									<i class="fab fa-linkedin fa-lg"></i>
								</a>
							</div>
						</div>
					</div>

				{% endfor %}
			</div>
		</div>
		</div>
	
	


	<div class="spacer"></div>

{% endif %}
