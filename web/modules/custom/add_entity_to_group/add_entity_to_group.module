<?php
use Drupal\group\Entity\Group;
use Drupal\group\Entity\GroupContent;
use Drupal\node\Entity\Node;
use Drupal\Core\Language\LanguageInterface;
use Drupal\group\Entity\GroupRelationship;



/**
 * Implements hook_form_alter().
 */
function add_entity_to_group_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id)
{



  // Casos para carreras.
  if ($form_id === 'node_programme_form') {
    // Determinar la operación actual.
    $operation = $form_state->getFormObject()->getOperation();
    if ($operation === 'default') {
      _alter_edit_programme_form($form, $form_state);
    } elseif ($operation === 'edit') {
      _alter_edit_programme_form($form, $form_state);
    }
  }

  // Casos para asignaturas.
  if ($form_id === 'node_individual_educational_component_form') {
    // Determinar la operación actual.
    $operation = $form_state->getFormObject()->getOperation();
    if ($operation === 'default') {
      _alter_edit_individual_educational_component_form($form, $form_state);
    } elseif ($operation === 'edit') {
      _alter_edit_individual_educational_component_form($form, $form_state);
    }
  }


  // Casos para asignaturas.
  if ($form_id === 'node_individual_educational_component_form') {
    // Determinar la operación actual.
    $operation = $form_state->getFormObject()->getOperation();
    if ($operation === 'default') {
      _alter_edit_individual_educational_component_form($form, $form_state);
    } elseif ($operation === 'edit') {
      _alter_edit_individual_educational_component_form($form, $form_state);
    }
  }






}

/**
 * Altera el formulario al crear una carrera.
 */
function _alter_create_programme_form(&$form, \Drupal\Core\Form\FormStateInterface $form_state)
{
  //\Drupal::messenger()->addMessage('Hook add entity to group alter create carrera form ****************************');






  if (isset($form['field_programme_institution'])) {
    // Obtener el ID de la carrera desde la URL (si está presente).
    $universidad_id = \Drupal::request()->query->get('field_programme_institution');

    if (isset($form['uid'])) {

      $form['uid']['#access'] = TRUE;
      $form['uid']['#disabled'] = FALSE; // Asegúrate de que el campo no esté bloqueado.
    }

    // Si hay un ID de carrera en la URL, usarlo como valor predeterminado.
    if ($universidad_id) {
      $universidad = \Drupal::entityTypeManager()->getStorage('node')->load($universidad_id);
      if ($universidad_id && $universidad->bundle() === 'institution') {
        // Preseleccionar la carrera y deshabilitar el campo.
        $form['field_programme_institution']['widget'][0]['target_id']['#default_value'] = $universidad;
        $form['field_programme_institution']['widget'][0]['target_id']['#disabled'] = TRUE; // Deshabilitar el campo.

        //\Drupal::messenger()->addMessage(t('Universidad preseleccionada: @name', ['@name' => $universidad->label()]));
        return; // Salir, ya que la carrera fue configurada correctamente.
      }
    }

    // Si no hay carrera válida, mostrar un mensaje de error.
    //\Drupal::messenger()->addError(t('No se pudo preseleccionar la carrera.'));
  }
}

/**
 * Altera el formulario al editar una carrera.
 */
function _alter_edit_programme_form(&$form, \Drupal\Core\Form\FormStateInterface $form_state)
{
  $node = $form_state->getFormObject()->getEntity();

  if ($node->hasField('field_programme_institution') && !$node->get('field_programme_institution')->isEmpty()) {
    $university = $node->get('field_programme_institution')->entity;

    if ($university) {
      //\Drupal::messenger()->addMessage('Universidad encontrada: ' . $university->label());
      $user_options = _get_group_users_by_role($university, 'universitytypegroup-degree_admin');

      if (!empty($user_options)) {
        _set_uid_field_as_select($form, $node, $user_options);

        if (!_add_entity_to_group_is_translation_add_form()) {
          _add_create_user_button($form, $university);
        }
      }
    }
  }
}

/**
 * Altera el formulario al crear una asignatura.
 */
function _alter_create_individual_educational_component_form(&$form, \Drupal\Core\Form\FormStateInterface $form_state)
{
  // Verificar si el campo field_iec_programme existe en el formulario.
  //\Drupal::messenger()->addMessage(t('El campo de asdfasdfasdffaasdsdfautor esasdfasdfasdtasdfasdfasdfá habasdfasdfilitado.'));
  if (isset($form['uid'])) {
    // Hacer que el campo de autor sea visible y editable.
    $form['uid']['#access'] = TRUE;
    $form['uid']['#disabled'] = FALSE;  // Hacer editable el campo.

    // Mover el campo "Autor" a la parte superior del formulario.

    //\Drupal::messenger()->addMessage(t('El campo de autor está habilitado.'));
  }
  if (isset($form['field_iec_programme'])) {
    // Obtener el ID de la carrera desde la URL (si está presente).
    $carrera_id = \Drupal::request()->query->get('field_iec_programme');


    // Si hay un ID de carrera en la URL, usarlo como valor predeterminado.
    if ($carrera_id) {
      $carrera = \Drupal::entityTypeManager()->getStorage('node')->load($carrera_id);
      if ($carrera && $carrera->bundle() === 'programme') {
        // Preseleccionar la carrera y deshabilitar el campo.
        $form['field_iec_programme']['widget'][0]['target_id']['#default_value'] = $carrera;
        $form['field_iec_programme']['widget'][0]['target_id']['#disabled'] = TRUE; // Deshabilitar el campo.
        //\Drupal::messenger()->addMessage(t('Carrera preseleccionada: @name', ['@name' => $carrera->label()]));
        return; // Salir, ya que la carrera fue configurada correctamente.
      }
    }

    // Si no hay carrera válida, mostrar un mensaje de error.
    //\Drupal::messenger()->addError(t('No se pudo preseleccionar la carrera.'));
  }
}









/**
 * Altera el formulario al editar una asignatura.
 */
function _alter_edit_individual_educational_component_form(&$form, \Drupal\Core\Form\FormStateInterface $form_state)
{

  $node = $form_state->getFormObject()->getEntity();
  //\Drupal::messenger()->addMessage(t('El campo dasdfasdfdfasdfae autor sdfaestfasdfsdfasasdfá habilitado.'));
  if (isset($form['uid'])) {
    // Hacer que el campo de autor sea visible y editable.
    $form['uid']['#access'] = TRUE;
    $form['uid']['#disabled'] = FALSE;  // Hacer editable el campo.

    // Mover el campo "Autor" a la parte superior del formulario.

    //\Drupal::messenger()->addMessage(t('El campo de autor está habilitado.'));
  }

  if ($node->hasField('field_iec_programme') && !$node->get('field_iec_programme')->isEmpty()) {
    $degree = $node->get('field_iec_programme')->entity;

    if ($degree) {
      $university = $degree->get('field_programme_institution')->entity;
      if ($university) {
        $user_options = _get_group_users_by_role($university, 'universitytypegroup-subject_admi');

        if (!empty($user_options)) {
          _set_uid_field_as_select($form, $node, $user_options);

          if (!_add_entity_to_group_is_translation_add_form()) {
            _add_create_user_button($form, $university);
          }
        }
      }
    }
  }
}

















/**
 * Obtiene usuarios de un grupo con un rol específico.
 */
function _get_group_users_by_role($university, $role_id)
{
  $relationships = GroupRelationship::loadByEntity($university);
  $user_options = [];

  foreach ($relationships as $relationship) {
    $group = $relationship->getGroup();
    $members = $group->getMembers();

    foreach ($members as $member) {
      $user = $member->getUser();
      $roles = $member->getRoles();

      foreach ($roles as $role) {
        if ($role->id() === $role_id) {
          $user_options[$user->id()] = $user->getDisplayName();
        }
      }
    }
  }

  asort($user_options);
  return $user_options;
}

/**
 * Configura el campo UID como una lista desplegable.
 */
function _set_uid_field_as_select(&$form, $node, $user_options)
{
  if (isset($form['uid']) && !empty($user_options)) {
    $form['uid']['widget'][0]['target_id'] = [
      '#type' => 'select',
      '#title' => t('Author'),
      '#options' => $user_options,
      '#default_value' => $node->getOwnerId(),
      '#required' => TRUE,
    ];
  }
}

/**
 * Añade un botón para crear un usuario debajo del campo autor.
 */
function _add_create_user_button(&$form, $university)
{
  $current_url = \Drupal::request()->getRequestUri();

  $form['create_user_button'] = [
    '#type' => 'link',
    '#title' => t('Create user'),
    '#url' => \Drupal\Core\Url::fromRoute('create_user_group.create_user_form', [
      'group' => $university->id(),
    ], [
      'query' => ['destination' => $current_url],
    ]),
    '#attributes' => ['class' => ['button', 'button--primary']],
  ];
}

/**
 * Checks whether the current node form is creating a translation.
 */
function _add_entity_to_group_is_translation_add_form()
{
  return \Drupal::routeMatch()->getRouteName() === 'entity.node.content_translation_add';
}

/**
 * Función auxiliar para obtener el grupo desde el contexto.
 */
function _get_group_from_context()
{
  $route_match = \Drupal::routeMatch();
  return $route_match->getParameter('group') ?: NULL;
}








/**
 * Implements hook_form_alter() to restrict the 'institution' field in group content creation
 * and restrict the 'programme' field for assignment creation.
 */
function add_entity_to_group_form_alter2(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id)
{
  // Obtener el usuario actual.
  $current_user = \Drupal::currentUser();


  // Asegurarse de que el campo de autor esté presente en el formulario.
  if (isset($form['uid'])) {
    // Hacer que el campo de autor sea visible y editable.
    $form['uid']['#access'] = TRUE;
    $form['uid']['#disabled'] = FALSE;  // Hacer editable el campo.

    // Mover el campo "Autor" a la parte superior del formulario.

    //\Drupal::messenger()->addMessage(t('El campo de autor está habilitado.'));
  }


  // Verificar si el usuario NO es el administrador general.
  if (!$current_user->hasRole('administrator')) {


    // Verificar si estamos editando una carrera o una asignatura.
    if ($form_id === 'node_programme_edit_form' || $form_id === 'node_individual_educational_component_edit_form') {
      // Obtener el nodo actual (carrera o asignatura).
      $node = $form_state->getFormObject()->getEntity();
      $university = null;
      $degree = null;

      // Comprobar si el nodo tiene un campo que referencia a la universidad.
      if ($node->hasField('field_programme_institution') && !$node->get('field_programme_institution')->isEmpty()) {
        // Obtener la entidad Universidad referenciada.
        $university = $node->get('field_programme_institution')->entity;
      } else if ($node->hasField('field_iec_programme') && !$node->get('field_iec_programme')->isEmpty()) {
        $degree = $node->get('field_iec_programme')->entity;
        $university = $degree->get('field_programme_institution')->entity;
      }

      if ($university) {
        //\Drupal::messenger()->addMessage('Universidad encontrada: ' . $university->label());

        // Cargar las relaciones de la entidad universidad con los grupos.
        $relationships = \Drupal\group\Entity\GroupRelationship::loadByEntity($university);

        if (!empty($relationships)) {
          foreach ($relationships as $relationship) {
            // Obtener el grupo asociado a la universidad.
            $group = $relationship->getGroup();
            //\Drupal::messenger()->addMessage('Grupo encontrado: ' . $group->label());

            // Obtener los miembros del grupo.
            $members = $group->getMembers();
            $user_options = [];

            foreach ($members as $member) {
              $user = $member->getUser();
              $role = $member->getRoles();
              $user_role = reset($role); // Obtener el primer (y único) rol del array.
              //\Drupal::messenger()->addMessage('Rol de usuario ' . $user_role->id());
              if ($form_id === 'node_programme_edit_form') {
                //\Drupal::messenger()->addMessage('Estamos en form de nodo carrera ');
                if ($user_role->id() == 'universitytypegroup-degree_admin') {
                  $user_options[$user->id()] = $user->getDisplayName();
                  //\Drupal::messenger()->addMessage('É degree admin ');
                }

              } else if ($form_id === 'node_individual_educational_component_edit_form') {
                //\Drupal::messenger()->addMessage('Estamos en if de nodo asginatura ');
                if ($user_role->id() == 'universitytypegroup-subject_admi') {
                  $user_options[$user->id()] = $user->getDisplayName();
                  //\Drupal::messenger()->addMessage('É subject admin ');
                }

              }
              // Agregar los usuarios a las opciones del campo autor.

              ////\Drupal::messenger()->addMessage('Usuario encontrado: ' . $user->getDisplayName());
            }

            // Ordenar los nombres de los usuarios alfabéticamente.
            asort($user_options);

            // Modificar el campo autor para que solo muestre esos usuarios y cambiar el tipo de campo.
            if (isset($form['uid']) && !empty($user_options)) {
              // Convertir el campo de autocompletar en un campo de selección.
              $form['uid']['widget'][0]['target_id'] = [
                '#type' => 'select',
                '#title' => t('Escrito por'),
                '#options' => $user_options,
                '#default_value' => $node->getOwnerId(), // Preseleccionar el autor actual.
                '#required' => TRUE,
              ];

              //\Drupal::messenger()->addMessage('Campo de autor modificado con los usuarios del grupo.');
            } else {
              //\Drupal::messenger()->addMessage('No se encontraron usuarios en este grupo para agregar al campo autor.');
            }
          }
        } else {
          //\Drupal::messenger()->addMessage('No se encontraron grupos para esta universidad.');
        }
      } else {
        //\Drupal::messenger()->addMessage('No se encontró la universidad referenciada.');
      }


      // Añadir un botón de "Crear Usuario" debajo del campo de autor.
      $current_url = \Drupal::request()->getRequestUri();
      $form['create_user_button'] = [
        '#type' => 'link',
        '#title' => t('Create user'),
        '#url' => \Drupal\Core\Url::fromRoute('create_user_group.create_user_form', ['group' => $group->id()], ['query' => ['destination' => $current_url]]),
        '#attributes' => ['class' => ['button', 'button--primary']],
      ];

    }








    // Caso 1: Crear Carrera (Restricción de universidad).
    if ($form_id !== 'node_individual_educational_component_form') {
      return;
    }

    // Obtener el usuario actual.
    $current_user = \Drupal::currentUser();

    // Obtener el grupo al que pertenece la entidad (esto depende de tu implementación).
    // Cambia `$group` por la lógica específica para obtener el grupo.
    $group = _get_group_from_context(); // Cambia esta función por la lógica para obtener el grupo.

    if ($group && $group->bundle() === 'universitytypegroup') {
      // Obtener las relaciones de contenido del grupo.
      $relationships = $group->getRelationships();
      $carrera_options = [];

      // Filtrar las carreras que pertenecen al usuario actual.
      foreach ($relationships as $relationship) {
        $entity = $relationship->getEntity();
        if ($entity && $entity->bundle() === 'programme' && $entity->getOwnerId() === $current_user->id()) {
          $carrera_options[$entity->id()] = $entity->label();
        }
      }

      // Si se encontraron carreras y existe el campo `field_iec_programme`.
      if (!empty($carrera_options) && isset($form['field_iec_programme'])) {
        // Mensaje de depuración para verificar las opciones encontradas.


        // Configurar el campo como una lista desplegable.
        $default_value = key($carrera_options); // Obtener la primera carrera como valor predeterminado.
        $form['field_iec_programme']['widget'][0]['target_id'] = [
          '#type' => 'select',
          '#title' => t('Select a career'),
          '#options' => $carrera_options,
          '#default_value' => $default_value,
          '#empty_option' => t('- Select a career -'),
          '#required' => TRUE,
        ];
      } else {
        //\Drupal::messenger()->addMessage(t('No tienes carreras disponibles.'));
      }
    }
  }

  // Caso 2: Crear Asignatura (Restricción de carrera).
  elseif ($form_id === 'node_individual_educational_component_form') {
    //\Drupal::messenger()->addMessage(t('Creando asignatura.'));

    // Obtener el grupo desde la URL.
    $group = \Drupal::routeMatch()->getParameter('group');

    // Verificar que estamos en el contexto de un grupo y que es un grupo de tipo 'UniversityTypeGroup'.
    if ($group && $group->bundle() == 'universitytypegroup') {
      // Obtener las relaciones de contenido del grupo.
      $relationships = $group->getRelationships();
      $carrera_options = []; // Aquí almacenaremos las carreras del usuario.

      foreach ($relationships as $relationship) {
        $entity = $relationship->getEntity();

        // Verificar si la entidad es del tipo "carrera" y si el usuario es el propietario.
        if ($entity && $entity->bundle() == 'programme' && $entity->getOwnerId() == $current_user->id()) {
          // Añadir la carrera a las opciones disponibles.
          $carrera_options[$entity->id()] = $entity->label();
        }
      }

      // Verificar si hay opciones disponibles y si el campo field_iec_programme está en el formulario.
      if (!empty($carrera_options) && isset($form['field_iec_programme'])) {
        //\Drupal::messenger()->addMessage(t('Carreras disponibles: ' . implode(', ', $carrera_options)));

        // Configurar el campo field_iec_programme como lista desplegable.
        $form['field_iec_programme']['widget'][0]['target_id'] = [
          '#type' => 'select',
          '#options' => $carrera_options,
          '#default_value' => key($carrera_options), // Selecciona la primera carrera por defecto.
          '#empty_option' => t('- Select a career -'),
          '#required' => TRUE,
        ];
      } else {
        //\Drupal::messenger()->addMessage(t('No tienes carreras disponibles.'));
      }
    }


  }
}



