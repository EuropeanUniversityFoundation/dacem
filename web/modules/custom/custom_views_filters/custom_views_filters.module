<?php

use Drupal\views\ViewExecutable;
use Drupal\views\Plugin\views\query\Sql;
use Drupal\Core\Language\LanguageInterface;
use Drupal\node\Entity\Node;

use Drupal\group\Entity\GroupContent;
use Drupal\Core\Entity\EntityInterface;

  use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;



/**
 * Implements hook_views_query_alter().
 * Modifies the query to replace the alias of the university with its node ID.
 */
function custom_views_filters_views_query_alter(ViewExecutable $view, Sql $query)
{



    $current_language = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();
    $alias_manager = \Drupal::service('path_alias.manager');

    if ($view->id() === 'institution_catalogue' || $view->id() === 'iec_information' || $view->id() === 'general_information' || $view->id() === 'programme_information') {
      
        \Drupal::logger('custom_views_filters')->notice('Altering query for institution_catalogue');

        // 🔹Get the argument of the view (the instituion alias)
        $args = $view->args;
        $alias_name = '';

        if (empty($args[0])) {
            \Drupal::logger('custom_views_filters')->warning('No alias found in arguments');
            return;
        }
        if ($view->id() == 'institution_catalogue' || $view->id() == 'general_information') {
            $alias_name = $args[0]; 
        } else if ($view->id() == 'iec_information') {
            $alias_name = $args[0] . '/' . $args[1] . '/' . $args[2];
        } else if ($view->id() == 'programme_information') {
            $alias_name = $args[0] . '/' . $args[1];
        }

        $path = $alias_manager->getPathByAlias('/' . $alias_name, $current_language);
        ////dump($path);


        if (preg_match('/^\/node\/(\d+)$/', $path, $matches)) {

            $node_id = (int) $matches[1];
            $where_conditions = &$query->where;

            ////dump($where_conditions);

            foreach ($where_conditions as &$condition_group) {

                foreach ($condition_group['conditions'] as &$condition) {
                    if (isset($condition['field']) && strpos($condition['field'], 'node_field_data.nid') !== false) {
                        \Drupal::logger('custom_views_filters')->notice('Replacing :node_field_data_nid with ' . $node_id);
                    
                        $condition['value'][':node_field_data_nid'] = $node_id;
                        ////dump($condition['value'][':node_field_data_nid']);
                    }

                }
            }
        }
    } else if ($view->id() === 'resources_and_services') {
        
        $args = $view->args;
        $entity_name = '';
        if($view->current_display == 'page_1'){
            $entity_name = $args[0];
        
        }else if ($view->current_display == 'page_2'){
            $entity_name = $args[0] .'/'. $args[1];
 
        }


        if (empty($args[0])) {
            \Drupal::logger('custom_views_filters')->warning('No alias found in arguments');
            return;
        }


        $path = $alias_manager->getPathByAlias('/' . $entity_name, $current_language);

        if (preg_match('/^\/node\/(\d+)$/', $path, $matches)) {


            $entity_id = (int) $matches[1];

            $query_to_execute=null;

            if($view->current_display == 'page_1'){
     
                $query_to_execute = \Drupal::entityQuery('node')
                ->condition('type', 'resources_and_services')
                ->condition('field_rs_institution', $entity_id)
                ->notExists('field_rs_campus')
                ->accessCheck(TRUE) // ← 🔹 SOLUCIÓN AQUÍ
                ->range(0, 1);
            }else if ($view->current_display == 'page_2'){
                
                $query_to_execute = \Drupal::entityQuery('node')
                ->condition('type', 'resources_and_services')
                ->condition('field_rs_campus', $entity_id)
                ->accessCheck(TRUE) // ← 🔹 SOLUCIÓN AQUÍ
                ->range(0, 1);
            }

            //dump($query_to_execute);

            $resource_ids = $query_to_execute->execute();
            

            if (!empty($resource_ids)) {
                $resources = \Drupal::entityTypeManager()
                    ->getStorage('node')
                    ->loadMultiple($resource_ids);

                $resource = reset($resources);
                ////dump('Resource encontrado:', $resource->label());
            } else {
                //dump('No se encontraron Resources and Services para esta institución.');
            }

            if ($resource && $resource->hasTranslation($current_language)) {
                $resource = $resource->getTranslation($current_language);
            }
            ////dump('Resource en el idioma actual:', $resource->label());


       


            // 🔹 Modify the query replacing the alias with the ID
            $where_conditions = &$query->where;

            ////dump($where_conditions);

            foreach ($where_conditions as &$condition_group) {

                foreach ($condition_group['conditions'] as &$condition) {
                    if (isset($condition['field']) && strpos($condition['field'], 'node_field_data.nid') !== false) {
                        \Drupal::logger('custom_views_filters')->notice('Replacing :node_field_data_nid with ' . $resource->id());
                        ////dump('dentro if isset');
                        // Modify the value of the sql parameter
                        $condition['value'][':node_field_data_nid'] = $resource->id();
                        ////dump($condition['value'][':node_field_data_nid']);
                    }

                }
            }
        }


    }
}




/**
 * Convierte aliases compuestos a NID para campus/OU.
 */
function custom_views_filters_views_pre_view(ViewExecutable $view, $display_id, array &$args) {
  // Solo nuestras vistas
  $is_campus = ($view->id() === 'campus_information');
  $is_ou     = ($view->id() === 'organizational_unit_information');
  if (!$is_campus && !$is_ou) {
    return;
  }

  $langcode = \Drupal::languageManager()
    ->getCurrentLanguage(\Drupal\Core\Language\LanguageInterface::TYPE_CONTENT)
    ->getId();
  $alias_manager = \Drupal::service('path_alias.manager');

  // Si ya llega un NID como 2º argumento, úsalo tal cual.
  if (!empty($args[1]) && ctype_digit((string) $args[1])) {
    $nid = (int) $args[1];
    $args = [$nid];
    $view->setArguments($args);
    \Drupal::logger('custom_views_filters')->notice(
      '@view: recibido NID directo @nid; args reinyectados.',
      ['@view' => $view->id(), '@nid' => $nid]
    );
    return;
  }

  // Esperamos 2 args: [institution_alias, campus|ou_alias]
  if (count($args) < 2) {
    \Drupal::logger('custom_views_filters')->warning(
      '@view: args insuficientes: @args',
      ['@view' => $view->id(), '@args' => print_r($args, TRUE)]
    );
    return;
  }

  $institution_alias = trim($args[0], '/');
  $second_alias      = trim($args[1], '/'); // campus_alias u ou_alias

  // Alias completo: /institution_alias/second_alias
  $full_alias = '/' . $institution_alias . '/' . $second_alias;
  $path = $alias_manager->getPathByAlias($full_alias, $langcode);

  // Fallback: intenta solo el segundo segmento por si el alias estuviera plano
  $m = [];
  if (!preg_match('/^\/node\/(\d+)$/', $path ?? '', $m)) {
    $path2 = $alias_manager->getPathByAlias('/' . $second_alias, $langcode);
    if (preg_match('/^\/node\/(\d+)$/', $path2 ?? '', $m2)) {
      $m = $m2;
      $path = $path2;
    }
  }

  \Drupal::logger('custom_views_filters')->notice(
    '@view: alias "@alias" ⇒ path "@path"',
    ['@view' => $view->id(), '@alias' => $full_alias, '@path' => $path]
  );

  if (!empty($m[1])) {
    $nid = (int) $m[1];

    // Ambas vistas deben tener UN único contextual: Content: Nid
    $args = [$nid];
    $view->setArguments($args);

    \Drupal::logger('custom_views_filters')->notice(
      '@view: resuelto NID = @nid; args reinyectados.',
      ['@view' => $view->id(), '@nid' => $nid]
    );
  } else {
    \Drupal::logger('custom_views_filters')->warning(
      '@view: no se pudo resolver alias "@alias" en @lang',
      ['@view' => $view->id(), '@alias' => $full_alias, '@lang' => $langcode]
    );
  }
}





/**
 * Implements hook_entity_insert().
 */
function custom_views_filters_entity_insert(EntityInterface $entity) {
    // Only if a campus is created
    if ($entity->getEntityTypeId() === 'node' && $entity->bundle() === 'campus') {
  
      // Create node Resources and Services
      $rs_node = Node::create([
        'type' => 'resources_and_services',
        'title' => 'Resources and Services for ' . $entity->label(),
        'field_rs_campus' => ['target_id' => $entity->id()],
        'field_rs_institution' => ['target_id' => $entity->get('field_campus_institution')->target_id],
        'langcode' => $entity->language()->getId(),
        'status' => 1,
      ]);
      $rs_node->save();
  
    
      $current_user = \Drupal::currentUser();
      if ($current_user->getAccountName() === 'prueba') {
        return;
      }
  
      $memberships = \Drupal::service('group.membership_loader')->loadByUser($current_user);
  
      foreach ($memberships as $membership) {
        $group = $membership->getGroup();
  
        if ($group->bundle() === 'universitytypegroup') {
          $group->addRelationship($rs_node, 'group_node:resources_and_services');
  
          \Drupal::logger('custom_views_filters')->notice('RS añadido al grupo ' . $group->id());
          break;
        }
      }
    }
  }





  /**
   * Implements hook_entity_predelete().
   */
  function custom_views_filters_entity_predelete(\Drupal\Core\Entity\EntityInterface $entity) {
    // Only if node type is a campus
    if ($entity->getEntityTypeId() === 'node' && $entity->bundle() === 'campus') {
      $campus_id = $entity->id();
  
      // Find node type 'resources_and_services' associated to this campus.
      $rs_nodes = \Drupal::entityTypeManager()->getStorage('node')->loadByProperties([
        'type' => 'resources_and_services',
        'field_rs_campus' => $campus_id,
      ]);
  
      foreach ($rs_nodes as $rs_node) {
        $rs_node->delete();
        \Drupal::logger('custom_views_filters')->notice('Removed RS associated to campus with ID ' . $campus_id);
      }
    }
  }





  




























































/**
 * Academic Authority create/edit form alter.
 */
function custom_views_filters_form_node_academic_authority_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  $node = $form_state->getFormObject()->getEntity();
  if (!$node || $node->bundle() !== 'academic_authority') {
    return;
  }

  // 1) Obtener el grupo desde la ruta /group/{group}/content/create/...
  $route_match = \Drupal::routeMatch();
  $group_param = $route_match->getParameter('group');
  $group = NULL;
  if (is_object($group_param)) {
    $group = $group_param;
  }
  elseif (is_numeric($group_param)) {
    $group = \Drupal::entityTypeManager()->getStorage('group')->load((int) $group_param);
  }
  if (!$group) {
    // Fuera de contexto de grupo, no forzamos nada.
    return;
  }

  // 2) Obtener INSTITUTION del grupo vía group_relationship.
  //    Plugin id para nodos "institution": group_node:institution
  $gr_storage = \Drupal::entityTypeManager()->getStorage('group_relationship');

  $inst_rels = $gr_storage->loadByProperties([
    'gid'       => $group->id(),
    'plugin_id' => 'group_node:institution',
  ]);

  $institution_options = [];
  $institution_nid = NULL;

  foreach ($inst_rels as $rel) {
    // Compatibilidad: Group v3 expone métodos diferentes según versión,
    // intentamos ambos de forma segura.
    $entity = NULL;
    if (method_exists($rel, 'getEntity')) {
      $entity = $rel->getEntity();
    }
    elseif (method_exists($rel, 'getContentEntity')) {
      $entity = $rel->getContentEntity();
    }
    if ($entity && $entity->bundle() === 'institution') {
      $institution_options[$entity->id()] = $entity->label();
      $institution_nid = $entity->id();
    }
  }

  // 3) Obtener CAMPUS del grupo (plugin group_node:campus).
  $campus_rels = $gr_storage->loadByProperties([
    'gid'       => $group->id(),
    'plugin_id' => 'group_node:campus',
  ]);

  $campus_options = [];
  foreach ($campus_rels as $rel) {
    $campus = NULL;
    if (method_exists($rel, 'getEntity')) {
      $campus = $rel->getEntity();
    }
    elseif (method_exists($rel, 'getContentEntity')) {
      $campus = $rel->getContentEntity();
    }
    if ($campus && $campus->bundle() === 'campus') {
      // Si quieres filtrar solo los campus que referencian a ESA institution (opcional):
      if ($institution_nid && $campus->hasField('field_campus_institution') && !$campus->get('field_campus_institution')->isEmpty()) {
        $ref = (int) $campus->get('field_campus_institution')->target_id;
        if ($ref !== (int) $institution_nid) {
          continue;
        }
      }
      $campus_options[$campus->id()] = $campus->label();
    }
  }



  //Obter Org Units do grupo

  $org_unit_rels = $gr_storage->loadByProperties([
    'gid'       => $group->id(),
    'plugin_id' => 'group_node:organizational_unit',
  ]);

  $org_unit_options = [];
  foreach ($org_unit_rels as $rel) {
    $organizational_unit = NULL;
    if (method_exists($rel, 'getEntity')) {
      $organizational_unit = $rel->getEntity();
    }
    elseif (method_exists($rel, 'getContentEntity')) {
      $organizational_unit = $rel->getContentEntity();
    }
    if ($organizational_unit && $organizational_unit->bundle() === 'organizational_unit') {
      // Si quieres filtrar solo los campus que referencian a ESA institution (opcional):
      if ($institution_nid && $organizational_unit->hasField('field_ou_institution') && !$organizational_unit->get('field_ou_institution')->isEmpty()) {
        $ref = (int) $organizational_unit->get('field_ou_institution')->target_id;
        if ($ref !== (int) $institution_nid) {
          continue;
        }
      }
      $org_unit_options[$organizational_unit->id()] = $organizational_unit->label();
    }
  }



$langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();

if (class_exists(\Collator::class)) {
  $coll = new \Collator($langcode);
  uasort($campus_options, function ($a, $b) use ($coll) {
    return $coll->compare((string) $a, (string) $b);
  });
  uasort($org_unit_options, function ($a, $b) use ($coll) {
    return $coll->compare((string) $a, (string) $b);
  });
}





  // 4) Forzar los widgets a <select> con las opciones calculadas

// === Institution: forzar opciones filtradas en el select ===
if (isset($form['field_aa_institution']['widget'][0]['target_id'])) {
  $el =& $form['field_aa_institution']['widget'][0]['target_id'];

  $el['#type'] = 'select';
  $el['#multiple'] = FALSE;
  $el['#size'] = 1;

  // 👇 Solo campus del grupo (y si quieres, filtrados por la institution del grupo)
  $el['#options'] = $institution_options;
  $el['#empty_option'] = t('- None -');
  $el['#empty_value'] = '_none';
  $el['#required'] = FALSE;
  

  unset($el['#selection_handler'], $el['#selection_settings'], $el['#autocomplete_route_name']);

  $el['#element_validate'][]  = 'custom_views_filters_er_select_empty_to_null';
}

// === Campus: forzar opciones filtradas en el select ===
if (isset($form['field_aa_campus']['widget'][0]['target_id'])) {
  $el =& $form['field_aa_campus']['widget'][0]['target_id'];

  $el['#type'] = 'select';
  $el['#multiple'] = FALSE;
  $el['#size'] = 1;

  // 👇 Solo campus del grupo (y si quieres, filtrados por la institution del grupo)
  $el['#options'] = $campus_options;
  $el['#empty_option'] = t('- None -');
  $el['#empty_value'] = '_none';
  $el['#required'] = FALSE;
  

  unset($el['#selection_handler'], $el['#selection_settings'], $el['#autocomplete_route_name']);

  $el['#element_validate'][]  = 'custom_views_filters_er_select_empty_to_null';
}


// === Organizational Unit: forzar opciones filtradas en el select ===
if (isset($form['field_aa_organizational_unit']['widget'][0]['target_id'])) {
  $el =& $form['field_aa_organizational_unit']['widget'][0]['target_id'];

  $el['#type'] = 'select';
  $el['#multiple'] = FALSE;
  $el['#size'] = 1;

  // 👇 Solo campus del grupo (y si quieres, filtrados por la institution del grupo)
  $el['#options'] = $org_unit_options;
  $el['#empty_option'] = t('- None -');
  $el['#empty_value'] = '_none';
  $el['#required'] = FALSE;
  

  unset($el['#selection_handler'], $el['#selection_settings'], $el['#autocomplete_route_name']);

  $el['#element_validate'][]  = 'custom_views_filters_er_select_empty_to_null';
}




}







function custom_views_filters_form_node_organizational_unit_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  $node = $form_state->getFormObject()->getEntity();
  if (!$node || $node->bundle() !== 'organizational_unit') {
    return;
  }

  // 1) Obtener el grupo desde la ruta /group/{group}/content/create/...
  $route_match = \Drupal::routeMatch();
  $group_param = $route_match->getParameter('group');
  $group = NULL;
  if (is_object($group_param)) {
    $group = $group_param;
  }
  elseif (is_numeric($group_param)) {
