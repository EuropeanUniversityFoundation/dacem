<?php

use Drupal\views\ViewExecutable;
use Drupal\views\Plugin\views\query\Sql;
use Drupal\Core\Language\LanguageInterface;
use Drupal\node\Entity\Node;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;



/**
 * Implements hook_views_query_alter().
 * Modifies the query to replace the alias of the university with its node ID.
 */
function custom_views_filters_views_query_alter(ViewExecutable $view, Sql $query)
{
  $current_language = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();
  $alias_manager = \Drupal::service('path_alias.manager');

  if ($view->id() === 'institution_catalogue' || $view->id() === 'general_information' || $view->id() === 'programme_information') {
    $args = $view->args;
    $alias_name = '';

    if (empty($args[0])) {
      return;
    }
    if ($view->id() == 'institution_catalogue' || $view->id() == 'general_information') {
      $alias_name = $args[0];
    } else if ($view->id() == 'programme_information') {
      $alias_name = $args[0] . '/' . $args[1];
    }

    $path = $alias_manager->getPathByAlias('/' . $alias_name, $current_language);
    if (preg_match('/^\/node\/(\d+)$/', $path, $matches)) {
      $node_id = (int) $matches[1];
      $where_conditions = &$query->where;

      foreach ($where_conditions as &$condition_group) {
        foreach ($condition_group['conditions'] as &$condition) {
          if (isset($condition['field']) && strpos($condition['field'], 'node_field_data.nid') !== false) {
            if (!empty($condition['value']) && is_array($condition['value'])) {
              foreach ($condition['value'] as $key => $val) {
                if (preg_match('/^:node_field_data_nid\d*$/', (string) $key)) {
                  $condition['value'][$key] = $node_id;
                }
              }
            }
          }
        }
      }

    }
  } else if ($view->id() === 'resources_and_services') {

    $args = $view->args;
    $entity_name = '';
    if ($view->current_display == 'page_1') {
      $entity_name = $args[0];

    } else if ($view->current_display == 'page_2') {
      $entity_name = $args[0] . '/' . $args[1];

    }

    if (empty($args[0])) {
      return;
    }


    $path = $alias_manager->getPathByAlias('/' . $entity_name, $current_language);

    if (preg_match('/^\/node\/(\d+)$/', $path, $matches)) {


      $entity_id = (int) $matches[1];

      $query_to_execute = null;

      if ($view->current_display == 'page_1') {

        $query_to_execute = \Drupal::entityQuery('node')
          ->condition('type', 'resources_and_services')
          ->condition('field_rs_institution', $entity_id)
          ->notExists('field_rs_campus')
          ->accessCheck(TRUE)
          ->range(0, 1);
      } else if ($view->current_display == 'page_2') {
        $query_to_execute = \Drupal::entityQuery('node')
          ->condition('type', 'resources_and_services')
          ->condition('field_rs_campus', $entity_id)
          ->accessCheck(TRUE)
          ->range(0, 1);
      }

      $resource_ids = $query_to_execute->execute();

      if (!empty($resource_ids)) {
        $resources = \Drupal::entityTypeManager()
          ->getStorage('node')
          ->loadMultiple($resource_ids);

        $resource = reset($resources);
      }

      if ($resource && $resource->hasTranslation($current_language)) {
        $resource = $resource->getTranslation($current_language);
      }
      $where_conditions = &$query->where;

      foreach ($where_conditions as &$condition_group) {
        foreach ($condition_group['conditions'] as &$condition) {
          if (isset($condition['field']) && strpos($condition['field'], 'node_field_data.nid') !== false) {
            $condition['value'][':node_field_data_nid'] = $resource->id();
          }
        }
      }
    }


  } else if ($view->id() === 'search_programme' && $view->current_display === 'page_1') {

    $home_programme_id = \Drupal::request()->query->get('home_programme');
    if (!$home_programme_id || !is_numeric($home_programme_id)) {
      return;
    }

    $origin_programme = Node::load((int) $home_programme_id);
    if (!$origin_programme || $origin_programme->bundle() !== 'programme') {
      return;
    }

    /** @var \Drupal\agreements_programmes\Service\AgreementProgrammeMatcher $matcher */
    $matcher = \Drupal::service('agreements_programmes.matcher');
    $compatible_programmes = $matcher->getCompatibleProgrammesForProgramme($origin_programme);

    $compatible_programme_ids = [];
    foreach ($compatible_programmes as $item) {
      if (!empty($item['programme']) && $item['programme'] instanceof \Drupal\node\NodeInterface) {
        $compatible_programme_ids[] = (int) $item['programme']->id();
      }
    }

    $compatible_programme_ids = array_values(array_unique($compatible_programme_ids));
    if (!$compatible_programme_ids) {
      $query->addWhere(0, 'node_field_data.nid', 0, '=');
      return;
    }

    $query->addWhere(0, 'node_field_data.nid', $compatible_programme_ids, 'IN');

  } else if ($view->id() === 'institution_new_catalogue' && ($view->current_display == 'page_1' || $view->current_display == 'page_3')) {

    $institution_id = custom_views_filters_resolve_catalogue_institution_id($view);
    if (!$institution_id) {
      $query->addWhere(0, 'node_field_data.nid', 0, '=');
      return;
    }

    $catalogue_programmes = custom_views_filters_get_catalogue_programme_ids($institution_id);
    $allowed_programme_ids = $catalogue_programmes['all'];

    if (empty($allowed_programme_ids)) {
      $query->addWhere(0, 'node_field_data.nid', 0, '=');
      return;
    }

    custom_views_filters_remove_catalogue_institution_argument_condition($query);
    $query->addWhere(0, 'node_field_data.nid', $allowed_programme_ids, 'IN');

    /**
     * 1) OU filter (Programme -> field_programme_ou IN selected OUs)
     */
    if ($view->current_display == 'page_1') {
      $selected_ou = \Drupal::request()->query->all('programme_ou');
      $selected_ou = is_array($selected_ou) ? array_values(array_filter($selected_ou, 'is_numeric')) : [];

      // Tabla del field Programme -> OU
      $programme_ou_table = 'node__field_programme_ou';
      $programme_ou_alias = $query->ensureTable($programme_ou_table);

      if (!empty($selected_ou)) {
        $query->addWhere(0, "$programme_ou_alias.field_programme_ou_target_id", $selected_ou, 'IN');
      }

      /**
       * 2) Campus filter (Programme -> OU -> Campus IN selected campuses)
       */
      $selected_campus = \Drupal::request()->query->all('programme_campus');
      $selected_campus = is_array($selected_campus) ? array_values(array_filter($selected_campus, 'is_numeric')) : [];

      if (!empty($selected_campus)) {
        // Join OU -> Campus table: node__field_ou_campus
        $ou_campus_table = 'node__field_ou_campus';

        $join = \Drupal::service('plugin.manager.views.join')->createInstance('standard', [
          'table' => $ou_campus_table,
          'field' => 'entity_id', // OU nid is stored as entity_id in this table
          'left_table' => $programme_ou_alias, // alias of node__field_programme_ou
          'left_field' => 'field_programme_ou_target_id', // OU nid
          'operator' => '=',
        ]);

        // Add relationship and get alias
        $ou_campus_alias = $query->addRelationship('ou_campus_join', $join, $programme_ou_table);

        // Apply IN on campus target id
        $query->addWhere(0, "$ou_campus_alias.field_ou_campus_target_id", $selected_campus, 'IN');
      }
    }
  }


}

/**
 * Resolve institution nid from institution_new_catalogue view argument.
 */
function custom_views_filters_resolve_catalogue_institution_id(ViewExecutable $view): ?int {
  $institution_arg = $view->args[0] ?? NULL;
  if (!$institution_arg) {
    return NULL;
  }

  if (is_numeric($institution_arg)) {
    return (int) $institution_arg;
  }

  $current_language = \Drupal::languageManager()
    ->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)
    ->getId();
  $alias_manager = \Drupal::service('path_alias.manager');

  foreach ([$current_language, 'en'] as $alias_language) {
    $internal_path = $alias_manager->getPathByAlias('/' . trim($institution_arg, '/'), $alias_language);
    if (preg_match('/^\/node\/(\d+)$/', $internal_path, $matches)) {
      return (int) $matches[1];
    }
  }

  return NULL;
}

/**
 * Return programme ids shown in the institution catalogue.
 *
 * - own: programmes whose owner institution is the current institution.
 * - joint: external programmes reached through memberships to joint programmes.
 * - all: merged deduplicated ids.
 */
function custom_views_filters_get_catalogue_programme_ids(int $institution_id): array {
  static $cache = [];

  if (isset($cache[$institution_id])) {
    return $cache[$institution_id];
  }

  $database = \Drupal::database();

  $own_programme_ids = $database->select('node__field_programme_institution', 'pi')
    ->fields('pi', ['entity_id'])
    ->condition('pi.deleted', 0)
    ->condition('pi.field_programme_institution_target_id', $institution_id)
    ->execute()
    ->fetchCol();
  $own_programme_ids = array_values(array_unique(array_map('intval', $own_programme_ids)));

  $joint_programme_query = $database->select('node__field_member_institution', 'mi');
  $joint_programme_query->join('node__field_member_joint_programme', 'mjp', 'mjp.entity_id = mi.entity_id');
  $joint_programme_query->join('node__field_programme', 'jp', 'jp.entity_id = mjp.field_member_joint_programme_target_id');
  $joint_programme_query->join('node__field_programme_institution', 'owner', 'owner.entity_id = jp.field_programme_target_id');
  $joint_programme_ids = $joint_programme_query
    ->fields('jp', ['field_programme_target_id'])
    ->condition('mi.deleted', 0)
    ->condition('mjp.deleted', 0)
    ->condition('jp.deleted', 0)
    ->condition('owner.deleted', 0)
    ->condition('mi.field_member_institution_target_id', $institution_id)
    ->condition('owner.field_programme_institution_target_id', $institution_id, '<>')
    ->distinct()
    ->execute()
    ->fetchCol();
  $joint_programme_ids = array_values(array_unique(array_map('intval', $joint_programme_ids)));

  $cache[$institution_id] = [
    'own' => $own_programme_ids,
    'joint' => $joint_programme_ids,
    'all' => array_values(array_unique(array_merge($own_programme_ids, $joint_programme_ids))),
  ];

  return $cache[$institution_id];
}

/**
 * Remove the strict institution contextual filter from institution catalogue.
 */
function custom_views_filters_remove_catalogue_institution_argument_condition(Sql $query): void {
  foreach ($query->where as &$condition_group) {
    if (empty($condition_group['conditions']) || !is_array($condition_group['conditions'])) {
      continue;
    }

    foreach ($condition_group['conditions'] as $index => $condition) {
      $field = $condition['field'] ?? '';
      if (is_string($field) && str_contains($field, 'field_programme_institution_target_id')) {
        unset($condition_group['conditions'][$index]);
      }
    }

    $condition_group['conditions'] = array_values($condition_group['conditions']);
  }
}













/**
 * Resolves composite aliases to node IDs for selected views.
 */
function custom_views_filters_views_pre_view(ViewExecutable $view, $display_id, array &$args) {
  $is_iec_instance_view = ($view->id() === 'iec_instance');
  $is_instance_switcher_attachment = ($display_id === 'attachment_2');

  if ($is_iec_instance_view && $is_instance_switcher_attachment) {
    if (!empty($args[0]) && ctype_digit((string) $args[0])) {
      $instance_nid = (int) $args[0];
      $instance = Node::load($instance_nid);

      if ($instance && $instance->bundle() === 'iec_instance') {
        $iec_nid = (int) ($instance->get('field_iec')->target_id ?? 0);

        if ($iec_nid) {
          $args = [$iec_nid];
          $view->setArguments($args);
        }
      }
    }

    return;
  }

  $is_campus = ($view->id() === 'campus_information');
  $is_ou = ($view->id() === 'organizational_unit_information');
  $is_iec = ($view->id() === 'iec_information');

  if (!$is_campus && !$is_ou && !$is_iec) {
    return;
  }

  $langcode = \Drupal::languageManager()
    ->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)
    ->getId();

  /** @var \Drupal\path_alias\AliasManagerInterface $alias_manager */
  $alias_manager = \Drupal::service('path_alias.manager');

  if (!empty($args[1]) && ctype_digit((string) $args[1])) {
    $nid = (int) $args[1];
    $args = [$nid];
    $view->setArguments($args);
    return;
  }

  if (($is_campus || $is_ou) && count($args) < 2) {
    return;
  }

  if ($is_iec && count($args) < 3) {
    return;
  }

  $institution_alias = trim($args[0], '/');

  if ($is_iec) {
    $programme_alias = trim($args[1], '/');
    $iec_alias = trim($args[2], '/');
    $full_alias = '/' . $institution_alias . '/' . $programme_alias . '/' . $iec_alias;
  }
  else {
    $second_alias = trim($args[1], '/'); // campus_alias u ou_alias
    $full_alias = '/' . $institution_alias . '/' . $second_alias;
  }

  $path = $alias_manager->getPathByAlias($full_alias, $langcode);

  $m = [];
  if (!preg_match('/^\/node\/(\d+)$/', $path ?? '', $m)) {
    $last_segment = $is_iec ? trim($args[2], '/') : trim($args[1], '/');
    $path2 = $alias_manager->getPathByAlias('/' . $last_segment, $langcode);

    if (preg_match('/^\/node\/(\d+)$/', $path2 ?? '', $m2)) {
      $m = $m2;
      $path = $path2;
    }
  }

  if (!empty($m[1])) {
    $nid = (int) $m[1];
    $args = [$nid];
    $view->setArguments($args);
  }
}



















/**
 * Implements hook_entity_insert().
 */
function custom_views_filters_entity_insert(EntityInterface $entity)
{
  // Only if a campus is created
  if ($entity->getEntityTypeId() === 'node' && $entity->bundle() === 'campus') {

    // Create node Resources and Services
    $rs_node = Node::create([
      'type' => 'resources_and_services',
      'title' => 'Resources and Services for ' . $entity->label(),
      'field_rs_campus' => ['target_id' => $entity->id()],
      'field_rs_institution' => ['target_id' => $entity->get('field_campus_institution')->target_id],
      'langcode' => $entity->language()->getId(),
      'status' => 1,
    ]);
    $rs_node->save();


    $current_user = \Drupal::currentUser();
    if ($current_user->getAccountName() === 'prueba') {
      return;
    }

    $memberships = \Drupal::service('group.membership_loader')->loadByUser($current_user);

    foreach ($memberships as $membership) {
      $group = $membership->getGroup();

      if ($group->bundle() === 'universitytypegroup') {
        $group->addRelationship($rs_node, 'group_node:resources_and_services');

        break;
      }
    }
  }
}





/**
 * Implements hook_entity_predelete().
 */
function custom_views_filters_entity_predelete(\Drupal\Core\Entity\EntityInterface $entity)
{
  // Only if node type is a campus
  if ($entity->getEntityTypeId() === 'node' && $entity->bundle() === 'campus') {
    $campus_id = $entity->id();

    // Find node type 'resources_and_services' associated to this campus.
    $rs_nodes = \Drupal::entityTypeManager()->getStorage('node')->loadByProperties([
      'type' => 'resources_and_services',
      'field_rs_campus' => $campus_id,
    ]);

    foreach ($rs_nodes as $rs_node) {
      $rs_node->delete();
    }
  }
}













































use Drupal\views\Views;

use Drupal\views\Plugin\views\query\QueryPluginBase;

/**
 * Adds custom checkbox filters to the exposed catalogue form.
 */
function custom_views_filters_form_views_exposed_form_alter(array &$form, FormStateInterface $form_state)
{
  if (($form['#id']) == 'views-exposed-form-institution-new-catalogue-page-1') {
    $param = 'programme_ou';
    $title = t('Organizational Unit');
    $institution_nid = _cvf_get_institution_from_path();
    $options = _cvf_get_ou_options_from_view($institution_nid);
    $defaults = \Drupal::request()->query->all($param);
    $defaults = is_array($defaults) ? array_values(array_filter($defaults, 'is_numeric')) : [];
    $form[$param] = [
      '#type' => 'checkboxes',
      '#title' => $title,
      '#options' => $options,
      '#default_value' => array_map('strval', $defaults),
      '#weight' => -10,
    ];







    $campus_param = 'programme_campus';
    $institution_nid = _cvf_get_institution_from_path();
    $campus_options = _cvf_get_campus_options_from_view($institution_nid);

    $campus_defaults = \Drupal::request()->query->all($campus_param);
    $campus_defaults = is_array($campus_defaults) ? array_values(array_filter($campus_defaults, 'is_numeric')) : [];

    $form[$campus_param] = [
      '#type' => 'checkboxes',
      '#title' => t('Campus'),
      '#options' => $campus_options,
      '#default_value' => array_map('strval', $campus_defaults),
      '#weight' => -9,
    ];

    if (isset($form['actions']['reset'])) {
      $form['actions']['reset']['#attributes']['data-clear-custom-filters'] = '1';
      $form['actions']['reset']['#attributes']['data-reset-url'] = \Drupal\Core\Url::fromRoute('view.institution_new_catalogue.page_1', [
        'arg_0' => $institution_nid,
      ], [
        'language' => \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT),
      ])->toString();
    }











  }
}

/**
 * Returns the institution node ID from the current catalogue path.
 */
function _cvf_get_institution_from_path(): int
{
  $path = trim(\Drupal::service('path.current')->getPath(), '/');
  $parts = explode('/', $path);
  $idx = array_search('catalogue', $parts, true);
  return ($idx !== false && isset($parts[$idx + 1])) ? (int) $parts[$idx + 1] : 0;
}

/**
 * Returns organizational unit options from the view reference.
 */
function _cvf_get_ou_options_from_view(int $institution_nid): array
{
  $view_id = 'institution_organizatinal_unit_list';
  $display_id = 'entity_reference_1';

  $view = Views::getView($view_id);

  if (!$view) {
    return [];
  }
  $view->setDisplay($display_id);
  $view->setArguments([$institution_nid]);
  $view->setItemsPerPage(0);
  $view->execute();

  $options = [];
  foreach ($view->result as $row) {
    if (!empty($row->_entity)) {
      $options[(string) $row->_entity->id()] = $row->_entity->label();
    }
  }
  asort($options, SORT_NATURAL | SORT_FLAG_CASE);
  return $options;
}



function _cvf_get_campus_options_from_view(int $institution_nid): array
{
  $view_id = 'institution_organizatinal_unit_list';
  $display_id = 'entity_reference_2';

  $view = Views::getView($view_id);
  if (!$view) {
    return [];
  }

  $view->setDisplay($display_id);

  $view->setArguments([$institution_nid]);

  $view->setItemsPerPage(0);
  $view->execute();

  $options = [];
  foreach ($view->result as $row) {
    if (!empty($row->_entity)) {
      $options[(string) $row->_entity->id()] = $row->_entity->label();
    }
  }

  asort($options, SORT_NATURAL | SORT_FLAG_CASE);

  return $options;
}









































































































