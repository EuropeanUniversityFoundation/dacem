/**
 * Applies admin locks on IEC edit forms.
 */
function admin_area_form_node_individual_educational_component_edit_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  $context_resolver = \Drupal::service('admin_area.context_resolver');

  if (isset($form['uid'])) {
    $form['uid']['#access'] = TRUE;
    $form['uid']['#disabled'] = FALSE;
  }

  if ($context_resolver->isCurrentGroupType('universitytypegroup') && isset($form['field_iec_programme'])) {
    $form['field_iec_programme']['#disabled'] = TRUE;
    if (isset($form['field_iec_programme']['widget'][0]['target_id'])) {
      $form['field_iec_programme']['widget'][0]['target_id']['#disabled'] = TRUE;
    }
  }
}


