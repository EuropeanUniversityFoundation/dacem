<?php


/**
 * Implements hook_theme().
 */
function admin_area_theme($existing, $type, $theme, $path) {
    return [
      'admin-area' => [
        'variables' => ['data' => NULL],
        // Usamos el servicio de extensión para obtener la ruta del tema.
        'path' => \Drupal::service('extension.list.theme')->getPath('b5subtheme') . '/templates',
      ],
    ];
  }
  