function admin_area_form_node_campus_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  $context_resolver = \Drupal::service('admin_area.context_resolver');
  $campus_id = \Drupal::request()->query->get('field_campus_institution');

  if ($campus_id && is_numeric($campus_id)) {
    $campus = Node::load($campus_id);

    if ($campus && $campus->bundle() === 'campus') {
      $form['field_campus_institution']['widget'][0]['target_id']['#default_value'] = $campus;
      $form['field_campus_institution']['widget'][0]['target_id']['#disabled'] = TRUE;
    }
  }

  $operation = $form_state->getFormObject()->getOperation();
  if ($operation === 'default' && $context_resolver->hasCurrentAdminRole(['university_admin'])) {
    $institution_nid = $context_resolver->getCurrentInstitutionNodeId();
    if ($institution_nid && isset($form['field_campus_institution']['widget'][0]['target_id'])) {
      $institution = Node::load($institution_nid);
      if ($institution instanceof Node && $institution->bundle() === 'institution') {
        $form['field_campus_institution']['widget'][0]['target_id']['#default_value'] = $institution;
        $form['field_campus_institution']['widget'][0]['target_id']['#disabled'] = TRUE;
      }
    }
  }
}




