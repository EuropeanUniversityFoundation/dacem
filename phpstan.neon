parameters:
    level: 1
    paths:
        # - web/modules/custom/admin_area
        # - web/modules/custom/agreement_courses
        # - web/modules/custom/agreements_programmes
        # - web/modules/custom/create_user_group
        # - web/modules/custom/custom_views_filters
        # - web/modules/custom/dacem_csv_import_export
        # - web/modules/custom/dacem_footer
        # - web/modules/custom/dacem_menu
